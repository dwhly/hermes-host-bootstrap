<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.chief.node-supervisor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/chief-node-supervisor</string>
    <string>--loop</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>120</integer>
  <key>StandardOutPath</key><string>/var/log/chief-node-supervisor.log</string>
  <key>StandardErrorPath</key><string>/var/log/chief-node-supervisor.err</string>
</dict>
</plist>


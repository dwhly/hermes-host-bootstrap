# Desired state: BTP's company database on h-btp (reviewed; git-tracked; no secrets here).
# Sizing from the memory baseline: 16 GB RAM, ~6 GB headroom at the observed max, swap already
# full on 2026-11-15. Postgres is kept small and hard-capped.
# Held until the owner says "roll it out" (then a reviewed change to ROLLOUT=go).
ROLLOUT=hold
# Owner decision (D4 correction, R2 has no versioning): wal-bucket-lock (WAL-prefix Bucket Lock, proven on R2)
# or owner-waiver-YYYY-MM-DD. Install holds until this is set by a reviewed change.
BUCKET_PROTECTION=owner-decision-pending
COMPANY=btp
S3_ENDPOINT=owner-step-pending.r2.cloudflarestorage.com
S3_BUCKET=btp-fleet-db
S3_REGION=auto
RETENTION_FULL_DAYS=35
SHARED_BUFFERS=128MB
EFFECTIVE_CACHE_SIZE=512MB
WORK_MEM=4MB
MAINTENANCE_WORK_MEM=64MB
MAX_CONNECTIONS=25
MEMORY_HIGH=384M
MEMORY_MAX=512M
ARCHIVE_TIMEOUT=60
SECRETS_SOURCE=1password
# h-btp has no 1Password service-account token today (checked 2026-11-15). Owner step: a read-only
# service account for the BTP vault, token in this file (raw, root 0600).
OP_TOKEN_FILE=/root/.config/btp/op_sa_token
OP_TOKEN_FORMAT=raw
OP_REF_S3_KEY=op://owner-step-pending/fleet-db-r2/access_key_id
OP_REF_S3_KEY_SECRET=op://owner-step-pending/fleet-db-r2/secret_access_key
OP_REF_CIPHER_PASS=op://owner-step-pending/fleet-db-backup-key/passphrase

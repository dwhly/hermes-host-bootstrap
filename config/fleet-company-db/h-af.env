# Desired state: AmForge's company database on h-af (reviewed; git-tracked; no secrets here).
# Sizing from the memory baseline (edd/evidence/fleet-architecture/memory-baseline-2026-11-15.md):
# 32 GB RAM, ~23 GB headroom at the observed max. Postgres is capped well below that.
# Held until the owner says "roll it out" (then a reviewed change to ROLLOUT=go).
ROLLOUT=hold
# Owner decision (D4 correction, R2 has no versioning): wal-bucket-lock (WAL-prefix Bucket Lock, proven on R2)
# or owner-waiver-YYYY-MM-DD. Install holds until this is set by a reviewed change.
BUCKET_PROTECTION=owner-decision-pending
COMPANY=amforge
S3_ENDPOINT=owner-step-pending.r2.cloudflarestorage.com
S3_BUCKET=amforge-fleet-db
S3_REGION=auto
RETENTION_FULL_DAYS=35
SHARED_BUFFERS=256MB
EFFECTIVE_CACHE_SIZE=2GB
WORK_MEM=8MB
MAINTENANCE_WORK_MEM=128MB
MAX_CONNECTIONS=40
MEMORY_HIGH=768M
MEMORY_MAX=1G
ARCHIVE_TIMEOUT=60
SECRETS_SOURCE=1password
# h-af's existing 1Password service account (raw token file, root 0600; present 2026-11-15).
OP_TOKEN_FILE=/root/.config/amforge/op_sa_token
OP_TOKEN_FORMAT=raw
# Owner step: replace owner-step-pending with the AmForge vault that service account can read
# (items fleet-db-r2 and fleet-db-backup-key; DESIGN.md "Owner steps"). Until then install HOLDs.
OP_REF_S3_KEY=op://owner-step-pending/fleet-db-r2/access_key_id
OP_REF_S3_KEY_SECRET=op://owner-step-pending/fleet-db-r2/secret_access_key
OP_REF_CIPHER_PASS=op://owner-step-pending/fleet-db-backup-key/passphrase

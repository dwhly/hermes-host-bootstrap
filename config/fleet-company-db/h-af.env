# Desired state: AmForge's company database on h-af (reviewed; git-tracked; no secrets here).
# Sizing from the memory baseline (edd/evidence/fleet-architecture/memory-baseline-2026-11-15.md):
# 32 GB RAM, ~23 GB headroom at the observed max. Postgres is capped well below that.
# Dan, 2026-11-16: "roll it out" for h-af (incl. creating the postgres OS user).
ROLLOUT=go
# Owner decision (D4 correction, R2 has no versioning): wal-bucket-lock (WAL-prefix Bucket Lock, proven on R2)
# or owner-waiver-YYYY-MM-DD. Install holds until this is set by a reviewed change.
# R2 Bucket Lock rule wal-35d (35 days) on bucket fleet-db-amforge, created by Dan 2026-11-17. The mechanism is
# proven on R2: a probe at pgbackrest/archive/amforge/16-LOCKPROBE.txt refused DELETE (409
# ObjectLockedByBucketPolicy); outside the prefix, DELETE 204. That probe makes archive/amforge/ non-empty for 35
# days, and pgBackRest 2.50 stanza-create refuses a non-empty archive path (review: PathNotEmptyError). So the
# stanza is fleet-amforge, in a fresh, never-probed namespace, and the rule's prefix is
# pgbackrest/archive/fleet-amforge/16- (the prefix text is verified from the rule form; no probe goes inside it).
BUCKET_PROTECTION=wal-bucket-lock
COMPANY=amforge
STANZA=fleet-amforge
S3_ENDPOINT=39361c7d9823384125a87e722837c567.r2.cloudflarestorage.com
# Bucket name per the fleet naming rule (fleet-<thing>); created by Dan in AmForge's Cloudflare account.
S3_BUCKET=fleet-db-amforge
S3_REGION=auto
RETENTION_FULL_DAYS=35
SHARED_BUFFERS=256MB
EFFECTIVE_CACHE_SIZE=2GB
WORK_MEM=8MB
MAINTENANCE_WORK_MEM=128MB
MAX_CONNECTIONS=40
MEMORY_HIGH=768M
MEMORY_MAX=1G
ARCHIVE_TIMEOUT=60
SECRETS_SOURCE=1password
# h-af's 1Password service account: Hermes-af-2 (read/write on vault Hermes) since 2026-11-17 (was the read-only
# hermes-h-af); raw token file, root 0600.
OP_TOKEN_FILE=/root/.config/amforge/op_sa_token
OP_TOKEN_FORMAT=raw
# Vault Hermes. The R2 keys are the item "CF R2 fleet-db-r2", referenced by its stable item ID so a rename can't
# break backups; fleet-db-backup-key was generated on h-af and never displayed.
OP_REF_S3_KEY=op://Hermes/rgoo5panyxmnxbx32e32evwsce/access_key_id
OP_REF_S3_KEY_SECRET=op://Hermes/rgoo5panyxmnxbx32e32evwsce/secret_access_key
OP_REF_CIPHER_PASS=op://Hermes/fleet-db-backup-key/passphrase

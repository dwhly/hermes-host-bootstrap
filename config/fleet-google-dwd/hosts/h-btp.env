# Desired state: fleet-google-dwd on h-btp (reviewed; git-tracked; no secrets).
# h-btp is a PRESERVED host: installed only by an explicit, owner-approved run of lib/63-fleet-google-dwd.sh.
# Held until Dan's go (then a reviewed change to ROLLOUT=go).
ROLLOUT=hold
COMPANY=btp

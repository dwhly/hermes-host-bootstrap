@@ -0,0 +1,18 @@
+import { describe, expect, it } from 'vitest'
+
+import { busyIndicatorWidth, renderIndicator } from '../components/appChrome.js'
+
+describe('clock busy indicator', () => {
+  it('is a static marker without a rotating verb or glyph timer', () => {
+    const first = renderIndicator('clock', 0)
+    const later = renderIndicator('clock', 99)
+
+    expect(first).toEqual({ frame: '•', intervalMs: null, showVerb: false })
+    expect(later).toEqual(first)
+  })
+
+  it('reserves only the marker and elapsed-clock width', () => {
+    expect(busyIndicatorWidth('clock', true)).toBe(busyIndicatorWidth('unicode', true))
+    expect(busyIndicatorWidth('clock', false)).toBe(1)
+  })
+})

[Unit]
Description=Chief stack (Core, Postgres, fleet console): ensure the compose services are up after every boot
Documentation=https://github.com/dwhly/hermes-host-bootstrap/blob/main/lib/97-stack-boot.sh
# WHY: compose services use `restart: unless-stopped`, so a clean `docker compose stop` (the resize/maintenance
# quiesce) leaves them DOWN after boot, and every fleet node then loses Core. This oneshot re-asserts desired state.
Requires=docker.service
After=docker.service network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/root/code/chief/chief-stack
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.hdo1.yml up -d --no-build
# Deliberately no ExecStop: shutdown is left to dockerd, so a maintenance stop never has to fight this unit.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target

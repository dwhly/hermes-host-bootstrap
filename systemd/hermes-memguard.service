[Unit]
Description=h-do1 memory guard: end idle >12h sessions under pressure + OOM priorities
Documentation=https://github.com/dwhly/hermes-host-bootstrap/blob/main/lib/S1-memguard.sh

[Service]
Type=oneshot
Environment=QUIET=1 HOME=/root XDG_RUNTIME_DIR=/run/user/0 PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
ExecStart=/usr/local/bin/hermes-memguard
# It must run WHILE the host thrashes: high CPU/IO priority, its memory protected from reclaim, never an OOM victim.
# (Nice=5 before 2026-11-16 made it lose to the very processes it was guarding against.)
Nice=-10
CPUWeight=1000
IOWeight=1000
MemoryMin=128M
OOMScoreAdjust=-900
TimeoutStartSec=300
# 300 s: archiving exports (calm memory only) can take ~10 s per session. On timeout: SIGKILL at once (no extra stop grace), so a stuck run never outlives its slot.
TimeoutStartFailureMode=kill
TimeoutStopSec=10

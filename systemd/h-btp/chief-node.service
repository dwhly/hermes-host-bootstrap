[Unit]
Description=Chief node daemon (h-btp telemetry only)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=-/etc/chief/node.env
Environment=HOME=/root
Environment=HERMES_BOOTSTRAP_DIR=/root/hermes-host-bootstrap
WorkingDirectory=/root/code/chief/hermes-node
ExecStart=/root/code/chief/hermes-node/.venv/bin/python -m hermes_node.daemon run --node-id h-btp --core ${CHIEF_CORE_URL} --interval 60
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=75
User=root
Group=root

[Install]
WantedBy=multi-user.target

# ~/.hermes-bootstrap.conf — personal overrides for hermes-host-bootstrap.
#
# Copy this file to ~/.hermes-bootstrap.conf (note the leading dot in the home
# directory) and edit any of the variables below. Anything NOT set here falls
# back to the repo's neutral defaults. This file is intentionally outside the
# repo so the same bootstrap.sh can be used by multiple people without
# stepping on each other's preferences.
#
# All variables are optional. Format is shell — this file gets `source`'d.

# Identity for git commits made by bootstrap modules (e.g. when a module
# auto-commits to a tracked config repo). Falls back to whatever `git config
# --global` already has.
# export HERMES_GIT_NAME="Your Name"
# export HERMES_GIT_EMAIL="you@example.com"

# Default tier if --tier is not passed on the command line. Repo default is
# `recommended`.
# export HERMES_DEFAULT_TIER=recommended

# Default role if --role is not passed and auto-detect doesn't have an
# opinion. Repo default is auto.
# export HERMES_DEFAULT_ROLE=both

# Timezone to set during preflight. Repo default is UTC.
# export HERMES_TZ=America/Los_Angeles

# Hostname to set during preflight (if you want bootstrap to rename the box).
# Repo default is "leave hostname alone."
# export HERMES_HOSTNAME=

# macOS hostname rename. Sets HostName + LocalHostName to this value via
# scutil. Leaves ComputerName (the friendly AirDrop/Finder name) alone
# unless HERMES_MAC_COMPUTER_NAME is also set. Only applied on macOS hosts.
# Lockout-safe: only fires when this env var is explicitly set.
# export HERMES_MAC_HOSTNAME=h-mini
# export HERMES_MAC_COMPUTER_NAME="Dan's Mac Mini"

# One-line note describing what this machine is for. Lands in
# ~/.hermes/hosts/<hostname>.yaml under `note:` and shows in `hermes-fleet`.
# If set here, the interactive prompt is skipped for the note.
# export HERMES_HOST_NOTE="main Hermes host, SFO, gateway + agent"

# Set to 1 to skip ALL interactive prompts (hostname + note). Useful for
# unattended re-runs / CI / scripted provisioning.
# export HERMES_NONINTERACTIVE=0

# ── 1Password CLI / secrets management ─────────────────────────────────
# The bootstrap installs the 1Password CLI (`op`) on all hosts. If a
# ~/.hermes/.env.template exists (with op:// references), bootstrap resolves
# it into ~/.hermes/.env on every run.
#
# Headless hosts (VPS, no Touch ID) need a Service Account token to
# authenticate non-interactively. Get one from:
#   1Password Web → Developer Tools → Service Accounts → New
# Grant read access to the "Hermes" vault. The token starts with "ops_".
# Set it here (this file is sourced before any module runs):
# export OP_SERVICE_ACCOUNT_TOKEN="ops_***..."
#
# Macs with Touch ID can skip this — `op signin` once interactively gives a
# long-lived biometric session and bootstrap inherits it automatically.

# Lockout-risk features — both default to OFF in the repo. Set to 1 here if
# you ALWAYS want these enabled on machines you bootstrap. Make sure you have
# working SSH key access before enabling on a remote box.
# export HERMES_SSH_HARDEN=0
# export HERMES_UFW_ENABLE=0

# Skip individual modules / packages. Hermes itself does NOT require Docker
# (the terminal tool's "modal" container mode is opt-in via TERMINAL_MODAL_IMAGE
# in ~/.hermes/.env; absent that, the terminal tool runs on the real shell).
# Docker Desktop on macOS keeps ~1GB RAM resident even idle, which is too
# expensive a default for "I want to manage this Mac with Hermes" use cases.
# Uncomment to skip:
# export HERMES_SKIP=docker
# Multiple modules: comma-separated, e.g. HERMES_SKIP=docker,xrdp

# Optional: a private git repo to clone into ~/.hermes/ during bootstrap as
# the personal config layer. Used by lib/92-hermes-config.sh and by the
# `hermes-config bootstrap` helper (aliased to `hmc bootstrap`). If set,
# bootstrap will clone/pull it, resolve .env.template via op, and run
# `hermes config migrate/check`.
# export HERMES_CONFIG_REPO=git@github.com:USER/hermes-config.git

# Non-interactive Hermes model/provider defaults. These seed config.yaml during
# bootstrap so you do NOT need to enter the `hermes setup` provider picker.
# The private hermes-config repo can still override with richer routing later.
# export HERMES_MODEL_PROVIDER=openrouter
# export HERMES_MODEL_DEFAULT=openai/gpt-5.5
# export HERMES_MODEL_BASE_URL=https://openrouter.ai/api/v1
# export HERMES_MODEL_API_MODE=chat_completions

# If set to 1, bootstrap installs and/or starts the Hermes gateway after the
# config + .env are in place. Leave off for client-only machines.
# export HERMES_GATEWAY_INSTALL=0
# export HERMES_GATEWAY_START=0

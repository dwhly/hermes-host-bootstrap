# ── hermes-host-bootstrap Ghostty config ──
# Lives at ~/.config/ghostty/config — Ghostty reloads on save (Cmd+Shift+,).
# Docs: https://ghostty.org/docs/config
#
# IMPORTANT: Ghostty's config format does NOT allow inline comments. Every `#`
# must be at the start of a line. Anything after `=` on a directive line is
# parsed as part of the value, even if it looks like a comment.

# ── Appearance ──────────────────────────────────────────────────────
# Dark mode with explicit base palette. We don't use a theme directive
# because Ghostty 1.3.x has been reorganizing its built-in theme bundle
# and references to specific theme names (e.g. catppuccin-mocha) break
# across versions. Setting the colors explicitly is stable.
background = #000000
foreground = #f6f7d0
cursor-color = #ffcc00
selection-background = #444444
selection-foreground = #ffffff

font-family = "JetBrainsMono Nerd Font"
font-size = 12
# Disable ligatures. Flip to +calt if you like them.
font-feature = -calt

# Padding & cursor
window-padding-x = 12
window-padding-y = 12
cursor-style = block
cursor-style-blink = false

# Tab bar
window-theme = ghostty
macos-titlebar-style = tabs

# ── Behaviour ───────────────────────────────────────────────────────
copy-on-select = clipboard
mouse-hide-while-typing = true
confirm-close-surface = false
window-save-state = always
scrollback-limit = 100000

# Open new tab/window in same directory as current
window-inherit-working-directory = true

# Quit only when last surface closes (instead of Cmd+Q killing instantly)
quit-after-last-window-closed = true

# ── Compatibility ───────────────────────────────────────────────────
# Advertise TERM=xterm-256color instead of the default xterm-ghostty.
# Every Unix server already has xterm-256color terminfo; xterm-ghostty
# does not, which makes tmux refuse to start on remotes that haven't
# manually installed Ghostty's terminfo entry. We lose Ghostty's most
# advanced terminal capabilities (undercurl colors, extended color
# signaling) but those mostly can't pass through tmux anyway. We keep
# 24-bit truecolor, 256-color palette, mouse, and TUI compatibility.
#
# If you want full xterm-ghostty fidelity, comment this line out and
# install Ghostty's terminfo on each remote:
#   /opt/homebrew/opt/ncurses/bin/infocmp -x xterm-ghostty | ssh HOST -- tic -x -
# (requires Homebrew ncurses since Apple's infocmp is too old).
# See https://ghostty.org/docs/help/terminfo
term = xterm-256color

# ── macOS keybindings ───────────────────────────────────────────────
# Ghostty applies these globally. On Linux you'd swap super → ctrl+shift.
keybind = super+t=new_tab
keybind = super+w=close_surface
keybind = super+shift+w=close_window
keybind = super+n=new_window
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+left_bracket=previous_tab
keybind = super+right_bracket=next_tab
keybind = super+k=clear_screen

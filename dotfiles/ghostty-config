# ── hermes-host-bootstrap Ghostty config ──
# Lives at ~/.config/ghostty/config — Ghostty reloads on save (Cmd+Shift+,).
# Docs: https://ghostty.org/docs/config

# ── Appearance ──────────────────────────────────────────────────────
theme = catppuccin-mocha
font-family = "JetBrainsMono Nerd Font"
font-size = 14
font-feature = -calt          # disable ligatures (subjective; flip to +calt if you like them)

# Padding & cursor
window-padding-x = 12
window-padding-y = 12
cursor-style = bar
cursor-style-blink = false

# Tab bar
window-theme = ghostty
macos-titlebar-style = tabs

# ── Behaviour ───────────────────────────────────────────────────────
copy-on-select = clipboard
mouse-hide-while-typing = true
confirm-close-surface = false
window-save-state = always
scrollback-limit = 100000

# Open new tab/window in same directory as current
window-inherit-working-directory = true

# Quit only when last surface closes (instead of Cmd+Q killing instantly)
quit-after-last-window-closed = true

# ── macOS keybindings ───────────────────────────────────────────────
# (Ghostty applies these globally; on Linux you'd swap super → ctrl+shift)
keybind = super+t=new_tab
keybind = super+w=close_surface
keybind = super+shift+w=close_window
keybind = super+n=new_window
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+left_bracket=previous_tab
keybind = super+right_bracket=next_tab
keybind = super+k=clear_screen

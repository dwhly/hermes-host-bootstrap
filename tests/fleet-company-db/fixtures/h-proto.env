# Prototype desired state (h-do1 harness only): MinIO stand-in for the company's R2 bucket.
ROLLOUT=go
COMPANY=amforge
S3_ENDPOINT=minio
S3_PORT=9000
S3_BUCKET=amforge-fleet-db
S3_REGION=auto
S3_CA_FILE=/etc/fleet-company-db/proto-ca.crt
RETENTION_FULL_DAYS=35
SHARED_BUFFERS=256MB
EFFECTIVE_CACHE_SIZE=2GB
WORK_MEM=8MB
MAINTENANCE_WORK_MEM=128MB
MAX_CONNECTIONS=40
MEMORY_HIGH=768M
MEMORY_MAX=1G
ARCHIVE_TIMEOUT=60
SECRETS_SOURCE=1password
OP_TOKEN_FILE=/root/.config/amforge/op_sa_token
OP_TOKEN_FORMAT=raw
OP_REF_S3_KEY=op://Hermes/fleet-db-r2/access_key_id
OP_REF_S3_KEY_SECRET=op://Hermes/fleet-db-r2/secret_access_key
OP_REF_CIPHER_PASS=op://Hermes/fleet-db-backup-key/passphrase

#!/usr/bin/env bash
# shellcheck disable=SC2046  # pid lists are intentionally word-split into separate args
# hermes-memguard — h-do1 memory guard (installed by lib/S1-memguard.sh; timer every 5 min).
# 1) OOM priorities: protect the access chain + Chief + Herdr; sacrifice idle sessions/helpers/non-default Desktop
#    backends first.
# 2) Sessions idle > 14 days (Dan's rule, 2026-11-16): archive (JSONL + Markdown + importable trace under
#    /root/.hermes/session-archive/<id>/, verified) and only then disconnect; never under memory pressure.
#    Everything used within 14 days stays connected. Restart: hermes --resume <id>.
# 3) Report swap (the +2 GB /swapfile2 buffer is provisioned by the bootstrap module, not at runtime).
#
# Must finish even while the host thrashes (2026-11-15: a run hung > 120 s on blocked docker/herdr/systemctl calls
# and systemd killed it at the exact moment it was needed). So: every external call is time-boxed (T / timeout=),
# OOM priorities run first, and the unit runs at high CPU/IO priority with protected memory.
# Knobs: MEMGUARD_IDLE_DAYS (14), MEMGUARD_MAX_ARCHIVE (2 per run), MEMGUARD_ARCHIVE_DIR.
# Test knobs: MEMGUARD_DRY_RUN=1 (log, never archive/kill), MEMGUARD_FORCE_PRESSURE=1, MG_CMD_TIMEOUT=<s> (default 8).
set -u
LOG=${LOG:-/root/.hermes/logs/memguard-$(date -u +%F).md}
QUIET=${QUIET:-0}
MG_CMD_TIMEOUT=${MG_CMD_TIMEOUT:-8}
export MG_CMD_TIMEOUT
DRY=${MEMGUARD_DRY_RUN:-0}
export MEMGUARD_DRY_RUN=$DRY
T(){ timeout -k 2 "$MG_CMD_TIMEOUT" "$@"; }
# Pressure = MemAvailable < 15% of total, or PSI memory some avg60 > 20
AVAIL_PCT=$(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{printf "%d", a*100/t}' /proc/meminfo)
PSI60=$(awk '/^some/{split($3,x,"="); printf "%d", x[2]}' /proc/pressure/memory)
PRESSURE=0; { [ "$AVAIL_PCT" -lt 15 ] || [ "$PSI60" -gt 20 ]; } && PRESSURE=1
[ "${MEMGUARD_FORCE_PRESSURE:-0}" = 1 ] && PRESSURE=1
mkdir -p "$(dirname "$LOG")"
say(){ [ "$QUIET" = 1 ] && { echo "$(date -u +%T) $*" >> "$LOG"; return; }; echo "$*" | tee -a "$LOG"; }
adj(){ # adj <score> <label> <pid...> — sets oom_score_adj on each pid and its current children
  local s=$1 l=$2; shift 2
  for p in "$@"; do
    [ -d "/proc/$p" ] || continue
    local changed=0
    for q in $p $(pgrep -P "$p" 2>/dev/null); do
      [ "$(cat "/proc/$q/oom_score_adj" 2>/dev/null)" = "$s" ] && continue
      { echo "$s" > "/proc/$q/oom_score_adj"; } 2>/dev/null && changed=1
    done
    [ "$changed" = 1 ] && say "  oom_score_adj $s  pid $p  $l"
  done
}
[ "$QUIET" = 1 ] || say "# h-do1 memory guard $(date -u '+%F %T UTC')"
[ "$QUIET" = 1 ] || say "Before: $(free -m | awk '/Mem:/{print "avail "$7"MB"} /Swap:/{print "swap "$3"/"$2"MB"}' | tr '\n' ' ') load $(cut -d' ' -f1-3 /proc/loadavg)"


# --- 1) OOM priorities -----------------------------------------------------------------------------------------
[ "$QUIET" = 1 ] || say "## OOM priorities"
adj -900 "tailscaled (the only way in)"              $(pidof tailscaled)
adj -800 "herdr servers (Dan's workspace)"           $(pgrep -x herdr) $(pgrep -f 'herdr .*server')
adj -500 "hermes gateway"                            $(T systemctl --user show hermes-gateway -p MainPID --value 2>/dev/null)
adj -500 "chief core (uvicorn)"                      $(pgrep -f 'uvicorn chief_core')
adj -500 "chief postgres"                            $(T docker inspect -f '{{.State.Pid}}' chief-stack-postgres-1 2>/dev/null)
adj -300 "chief fleet console"                       $(T docker inspect -f '{{.State.Pid}}' chief-stack-fleet-1 2>/dev/null) $(pgrep -f next-server)
adj -300 "hermes dashboard (:9000)"                  $(T systemctl show hermes-dashboard-server -p MainPID --value 2>/dev/null)
for p in $(pgrep -f 'ssh-owner-nonce'); do
  prof=$(tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null | grep -o -E -- '--profile [^ ]+' | awk '{print $2}')
  if [ -n "$prof" ] && [ "$prof" != default ]; then adj 500 "Desktop backend, profile $prof (first to go)" "$p"; fi
done
adj 700 "tool helper: chromium"                      $(pgrep -f 'chromium-[0-9]+/chrome-linux64/chrome' | head -40)
adj 700 "tool helper: pyright LSP"                   $(pgrep -f pyright-langserver)
adj 200 "hermes terminal sessions (TUI)"             $(pgrep -f 'tui_gateway.entry') $(pgrep -f 'ui-tui/dist/entry.js')

# --- 2) archive + disconnect sessions idle > MEMGUARD_IDLE_DAYS (default 14, Dan's rule 2026-11-16) -------------
# Anything used within the window stays connected, even under pressure. Archiving runs only when memory is calm
# (exports cost memory); under pressure it waits for the next calm run.
if [ "$PRESSURE" = 1 ]; then
  say "## Memory tight (avail ${AVAIL_PCT}%, PSI60 ${PSI60}): session archiving deferred to a calm run"
else
[ "$QUIET" = 1 ] || say "## Archive + disconnect sessions idle > ${MEMGUARD_IDLE_DAYS:-14} days$([ "$DRY" = 1 ] && echo " (dry-run)")"
timeout -k 5 240 python3 - "$LOG" <<'PY'
import sqlite3, os, json, subprocess, time, signal, sys
log=sys.argv[1]; dry=os.environ.get('MEMGUARD_DRY_RUN')=='1'
tmo=float(os.environ.get('MG_CMD_TIMEOUT','8'))
IDLE=float(os.environ.get('MEMGUARD_IDLE_DAYS','14'))*86400
MAXN=int(os.environ.get('MEMGUARD_MAX_ARCHIVE','2'))
ROOT=os.environ.get('MEMGUARD_ARCHIVE_DIR','/root/.hermes/session-archive')
EXPORT_TMO=90
try:
    out=subprocess.run(["herdr","--session","ws","pane","list"],capture_output=True,text=True,timeout=tmo).stdout
    panes=json.loads(out)['result']['panes']
except Exception as e:
    open(log,'a').write(f"  herdr pane list unavailable ({type(e).__name__}); no sessions archived\n"); sys.exit(0)
c=sqlite3.connect(f"file:{os.path.expanduser('~/.hermes/state.db')}?mode=ro", uri=True, timeout=tmo)
def chain(sid):
    """The pane's session and its newest-descendant chain (compactions, branches). A branch can live in ANOTHER
    pane, so idleness is the newest human message anywhere on the chain, never the leaf's alone."""
    out=[sid]
    while True:
        k=c.execute("select id from sessions where parent_session_id=? order by started_at desc limit 1",(sid,)).fetchone()
        if not k or k[0] in out: return out
        sid=k[0]; out.append(sid)
def last_human(sid):
    r=c.execute("select max(timestamp) from messages where session_id=? and role='user' and content not like '[IMPORTANT: Background%'",(sid,)).fetchone()[0]
    return float(r) if r else None
me=os.environ.get('HERMES_SESSION_ID','')
now=time.time(); idle=[]
for p in panes:
    s=(p.get('agent_session') or {}).get('value')
    if not s or p.get('agent_status')=='working' or 'keep' in (p.get('label') or '').lower(): continue
    ch=chain(s); l=ch[-1]
    ts=[x for x in (last_human(i) for i in ch) if x is not None]
    t=max(ts) if ts else None
    if me in ch or t is None or (now-t) < IDLE: continue
    idle.append((p,l,t))
if not idle: sys.exit(0)
idle.sort(key=lambda x:x[2]); idle=idle[:MAXN]        # oldest first, bounded per run
def export(args):
    r=subprocess.run(["hermes","sessions","export",*args],capture_output=True,text=True,timeout=EXPORT_TMO)
    return r.returncode==0
def archive(p,leaf,t):
    """Full-fidelity JSONL per session in the leaf's lineage, readable Markdown of the lineage, and a Claude-format
    trace that `hermes sessions import --from claude <file>` can load into any Hermes home. Returns the dir, or None
    if anything is missing (then the session is NOT disconnected)."""
    d=os.path.join(ROOT,leaf); os.makedirs(d,exist_ok=True)
    if not export(["--session-id",leaf,"--lineage","logical","--format","md","--force",d+"/"]): return None
    try:
        man=[json.loads(x) for x in open(os.path.join(d,"manifest.jsonl")) if x.strip()]
        man=[m for m in man if m.get("session_id")==leaf][-1]
    except Exception: return None
    ids=man.get("lineage_session_ids") or [leaf]
    if not man.get("message_count"): return None
    for i in ids:
        if not export(["--session-id",i,"--format","jsonl",d+"/"]): return None
        f=os.path.join(d,f"hermes_session_{i}.jsonl")
        if not os.path.exists(f) or os.path.getsize(f)==0: return None
    tr=os.path.join(d,f"{leaf}.trace.jsonl")
    if not export(["--session-id",leaf,"--format","trace",tr]) or not os.path.getsize(tr): return None
    open(os.path.join(d,"README.md"),"w").write(
        f"# {(p.get('terminal_title_stripped') or leaf)}\n\n"
        f"- Archived {time.strftime('%Y-%m-%d %H:%M UTC',time.gmtime())} from herdr pane {p['pane_id']}, idle {(now-t)/86400:.0f} days.\n"
        f"- Restart in full (session store): `hermes --resume {leaf}`\n"
        f"- If the session store is ever lost: `hermes sessions import --from claude {tr}` (turns only, no tool steps)\n"
        f"- Full record: `hermes_session_<id>.jsonl` for {len(ids)} session(s) {ids}; readable: the `.md` file.\n")
    with open(os.path.join(ROOT,"INDEX.md"),"a") as ix:
        ix.write(f"| {time.strftime('%Y-%m-%d',time.gmtime())} | {(p.get('terminal_title_stripped') or '')[:60]} | {(now-t)/86400:.0f}d | `hermes --resume {leaf}` | {d} |\n")
    return d
# one /proc pass for all idle panes (not one per pane). Each match is pinned with a pidfd and re-verified, and
# both signals go through that fd, so a recycled PID can never be signalled.
want={f"HERDR_PANE_ID={p['pane_id']}".encode()+b'\0':p['pane_id'] for p,_,_ in idle}
def is_tui(pid):
    try:
        cmd=open(f'/proc/{pid}/cmdline','rb').read(); env=open(f'/proc/{pid}/environ','rb').read()+b'\0'
    except Exception: return None
    if b'tui_gateway.entry' not in cmd and b'ui-tui/dist/entry.js' not in cmd: return None
    for k,pane in want.items():
        if (b'\0'+k) in (b'\0'+env): return pane
    return None
bypane={}
for d in os.listdir('/proc'):
    if not d.isdigit(): continue
    pane=is_tui(d)
    if pane is None: continue
    try: fd=os.pidfd_open(int(d))
    except OSError: continue
    if is_tui(d)!=pane: os.close(fd); continue      # re-verify after pinning
    bypane.setdefault(pane,[]).append((int(d),fd))
ended=[]
for p,l,t in idle:
    pf=bypane.get(p['pane_id'],[])
    if not pf: continue
    where="(dry-run: not archived)"
    if not dry:
        where=archive(p,l,t)
        if where is None:
            open(log,'a').write(f"  archive FAILED for pane {p['pane_id']} session {l}; left connected\n"); continue
        for _,fd in pf:
            try: signal.pidfd_send_signal(fd, signal.SIGTERM)
            except Exception: pass
    pids=[q for q,_ in pf]
    ended.append((pf, f"  {'WOULD ARCHIVE+DISCONNECT' if dry else 'archived+disconnected'} pane {p['pane_id']} '{(p.get('terminal_title_stripped') or '')[:45]}' idle {(now-t)/86400:.0f}d pids {pids} -> {where} ; resume: hermes --resume {l}"))
if ended and not dry:
    time.sleep(5)
    for pf,_ in ended:
        for _,fd in pf:
            try: signal.pidfd_send_signal(fd, signal.SIGKILL)
            except ProcessLookupError: pass          # exited on SIGTERM
            except Exception: pass
for fds in bypane.values():
    for _,fd in fds: os.close(fd)
if ended:
    txt="\n".join(x for _,x in ended); open(log,'a').write(txt+"\n"); print(txt)
PY
[ $? -eq 124 ] && say "  session archiver timed out after 240s"
fi

# --- 3) swap buffer: provisioned by lib/S1-memguard.sh (fstab), never created here under pressure -----------------
[ "$QUIET" = 1 ] || say "## Swap: $(swapon --show=NAME,SIZE,USED --noheadings | tr '\n' ' ')"

[ "$QUIET" = 1 ] || say "After: $(free -m | awk '/Mem:/{print "avail "$7"MB"} /Swap:/{print "swap "$3"/"$2"MB"}' | tr '\n' ' ') load $(cut -d' ' -f1-3 /proc/loadavg)"
[ "$QUIET" = 1 ] || say "Log: $LOG"
# one heartbeat line per run (capacity history for the alerting work)
echo "{\"at\":\"$(date -u +%FT%TZ)\",\"avail_pct\":$AVAIL_PCT,\"psi_some60\":$PSI60,\"swap_used_mb\":$(free -m | awk '/Swap:/{print $3}'),\"load1\":$(cut -d' ' -f1 /proc/loadavg),\"pressure\":$PRESSURE,\"secs\":$SECONDS}" >> "${CAPACITY_LOG:-/root/.hermes/logs/memguard-capacity.jsonl}"
exit 0

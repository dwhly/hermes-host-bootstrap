#!/usr/bin/env bash
set -euo pipefail
export PYTHONPATH="/usr/local/lib/hermes-host-bootstrap:${PYTHONPATH:-}"

# Node identity + boss address live in /etc/chief/node.env (written by lib/94). launchd/systemd
# boot jobs start with an empty environment, so load it here or the converger falls back to
# 127.0.0.1 (only correct on the hub). Plain KEY=VALUE lines only; never overrides values the
# caller already set; never evaluated as shell.
if [[ -r /etc/chief/node.env ]]; then
  while IFS='=' read -r key val; do
    [[ "$key" =~ ^CHIEF_[A-Z0-9_]+$ ]] || continue
    [[ -n "${!key:-}" ]] || export "$key=$val"
  done < /etc/chief/node.env
fi

# Prefer a modern Python that also has chief_spec available (the node venv) so the
# converger can locally validate the CloudEvents envelopes it emits. Fall back to
# system python3 (the code is 3.9-compatible — uses dt.timezone.utc, future
# annotations — and degrades to a hand-built envelope if chief_spec is absent).
PY=""
for cand in \
  /root/code/chief/hermes-node/.venv/bin/python \
  "${HOME:-/var/empty}/code/chief/hermes-node/.venv/bin/python" \
  /Users/*/code/chief/hermes-node/.venv/bin/python; do
  if [[ -x "$cand" ]]; then PY="$cand"; break; fi
done
[[ -z "$PY" ]] && PY="$(command -v python3)"

exec "$PY" -m hermes_converger "$@"

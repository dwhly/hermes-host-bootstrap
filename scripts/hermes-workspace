#!/usr/bin/env bash
# hermes-workspace (alias: hmw) — unified, pure bash+tmux workspace launcher.
#
# ONE implementation for the whole fleet. Identical on macOS and Linux; no
# AppleScript, no Ghostty API, no GUI-pane choreography. The GUI terminal
# (Ghostty, Terminal.app, iTerm, a Linux console, …) is just a dumb transport —
# tmux draws the layout.
#
# Symlinked to ~/.local/bin/hermes-workspace by lib/99-register-host.sh.
#
# LAYOUT: N side-by-side panes in ONE tmux window named "ws". Panes are named
# STABLY H1, H2, H3, … so `hmw N` always builds the first N — i.e. `hmw 3`'s
# first two panes (H1, H2) are exactly the same sessions as `hmw 2`:
#     hmw 2 →  ┌──────┬──────┐        hmw 3 → ┌─────┬─────┬─────┐
#              │  H1  │  H2  │                │ H1  │ H2  │ H3  │
#              └──────┴──────┘                └─────┴─────┴─────┘
# Each pane runs `hermes-pane H<n>`, the restart-proof launcher that tags the
# session (--source pane:H<n>) and resumes that pane's own most-recent session
# across `hermes update` (see the tmux-workspace-pattern skill).
#
# USAGE
#   hermes-workspace                # 2 panes on the DEFAULT host (h-do1) — or
#                                   #   locally if you're already on h-do1
#   hermes-workspace N              # N panes on the default host (N >= 1)
#   hermes-workspace <host>         # 2 panes on <host> (ssh -t)
#   hermes-workspace <host> N       # N panes on <host>
#   hermes-workspace user@host N    # explicit ssh target + count
#   hmw [host] [N]                  # alias (host/N order is flexible)
#
# DEFAULT TARGET: with no host arg, hmw aims at h-do1 (override via
# HMW_DEFAULT_HOST), so `hmw` / `hmw 3` from a Mac drives h-do1 — the old
# reflex. The exception: when you're already ON the default host, bare hmw
# builds locally (no pointless self-SSH). So `hmw 3` on h-do1 makes 3 panes
# right there; `hmw 3` on a Mac makes 3 panes on h-do1.
#
# Remote mode opens ONE ssh connection and attaches a single tmux window that
# tmux splits server-side, so the workspace survives disconnect/sleep —
# strictly better than GUI panes, which die with the window.

set -uo pipefail

DEFAULT_PANES=2
# Default remote target when no host arg is given AND we're not already on it.
# Restores the old reflex: bare `hmw` (or `hmw N`) from a Mac drives h-do1.
# Override per-host via HMW_DEFAULT_HOST (e.g. in ~/.hermes-bootstrap.conf).
DEFAULT_HOST="${HMW_DEFAULT_HOST:-h-do1}"

# ── Parse args: a bare integer is the pane COUNT; anything else is the HOST.
# Order-independent, so `hmw h-do1 3` and `hmw 3 h-do1` both work.
host=""
panes=""
for arg in "$@"; do
  if [[ "$arg" =~ ^[0-9]+$ ]]; then
    panes="$arg"
  else
    host="$arg"
  fi
done
panes="${panes:-$DEFAULT_PANES}"
if [ "$panes" -lt 1 ]; then
  echo "hermes-workspace: pane count must be >= 1 (got $panes)" >&2
  exit 2
fi

# ── Default-target resolution ─────────────────────────────────────────────
# No explicit host arg → aim at DEFAULT_HOST, EXCEPT when we're already running
# on that host (avoid a pointless h-do1→h-do1 SSH loopback). Compare on the
# short hostname against the default's bare name (strip any user@ and domain).
if [ -z "$host" ]; then
  default_bare="${DEFAULT_HOST##*@}"; default_bare="${default_bare%%.*}"
  here="$(hostname -s 2>/dev/null || hostname)"
  if [ "$here" != "$default_bare" ]; then
    host="$DEFAULT_HOST"
  fi
  # else: we ARE the default host → fall through to local mode.
fi

# ── Remote dispatch ──────────────────────────────────────────────────────
# If a host is set (explicit arg or resolved default), re-invoke THIS SAME
# script on the remote over ssh -t, forwarding the pane count. The remote
# already has hermes-workspace on PATH (same bootstrap install).
if [ -n "$host" ]; then
  # Resolve the host through the fleet registry (~/.hermes/hosts/<host>.yaml) so
  # a bare name like "h-do1" becomes a reachable "root@100.122.202.37" — the
  # SAME resolution hssh / hermes-fleet use. Without this, bare `ssh h-do1` on a
  # Mac depends on ~/.ssh/config or MagicDNS and times out when neither resolves
  # the name to the tailnet IP. Preserve explicit user@host untouched.
  case "$host" in
    *@*) ssh_target="$host" ;;               # explicit target — honor verbatim
    *)
      if command -v hermes-host-resolve >/dev/null 2>&1; then
        ssh_target="$(hermes-host-resolve "$host" 2>/dev/null || true)"
      fi
      # Fall back to the raw name if the resolver is missing or returns nothing
      # (e.g. host not in the registry → rely on ~/.ssh/config as before).
      [ -n "${ssh_target:-}" ] || ssh_target="$host"
      ;;
  esac
  # -t forces a TTY so tmux attaches interactively. Login shell on the remote
  # ensures ~/.local/bin (where hermes-workspace lives) is on PATH.
  exec ssh -t "$ssh_target" "exec \"\$SHELL\" -lc \"hermes-workspace $panes\""
fi

# ── Local mode: build N stably-named panes side by side, then attach ───────
PANE_CMD="hermes-pane"
if ! command -v "$PANE_CMD" >/dev/null 2>&1; then
  echo "hermes-workspace: '$PANE_CMD' not on PATH — run hermes-reload (hmr) to install it." >&2
  exit 1
fi

SESSION=ws

attach() {
  if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t "$SESSION"
  else
    exec tmux attach-session -t "$SESSION"
  fi
}

# Stable pane label for index n (1-based): H1, H2, H3, …
label_for() { echo "H$1"; }

if tmux has-session -t "=$SESSION" 2>/dev/null; then
  # Session exists. Add any panes still missing up to the requested count so
  # `hmw 3` after a prior `hmw 2` just adds H3 (H1/H2 keep their live state).
  # We never destroy or shrink an existing workspace.
  have="$(tmux list-panes -t "$SESSION":ws 2>/dev/null | wc -l | tr -d ' ')"
  n="$have"
  while [ "$n" -lt "$panes" ]; do
    n=$((n + 1))
    tmux split-window -h -t "$SESSION":ws "$PANE_CMD $(label_for "$n")"
    tmux select-layout -t "$SESSION":ws even-horizontal
  done
  tmux select-pane -t "$SESSION":ws.0
  attach
fi

# Fresh build: window with H1, then split right for H2..HN.
tmux new-session -d -s "$SESSION" -n ws "$PANE_CMD $(label_for 1)"
n=1
while [ "$n" -lt "$panes" ]; do
  n=$((n + 1))
  tmux split-window -h -t "$SESSION":ws "$PANE_CMD $(label_for "$n")"
done
tmux select-layout -t "$SESSION":ws even-horizontal   # equal-width columns
tmux select-pane   -t "$SESSION":ws.0                 # focus the first (H1) pane
attach

#!/usr/bin/env bash
# hermes-workspace (alias: hmw) — persistent H1..HN workspaces via Herdr or tmux.

set -uo pipefail

DEFAULT_COUNT=2
DEFAULT_HOST="${HMW_DEFAULT_HOST:-h-do1}"
BACKEND="${HMW_BACKEND:-herdr}"
if [ -n "${HMW_VERIFY+x}" ]; then
  VERIFY=$HMW_VERIFY
elif [ "$BACKEND" = "herdr" ] && [ "${HMW_HERDR_VERIFY:-0}" = "1" ]; then
  VERIFY=1
else
  VERIFY=0
fi

# ── Failure explanation ────────────────────────────────────────────────
# hmw must never fail silently. Every launcher error goes to stderr AND, when
# running as the remote re-entry, to HMW_ERR_FILE on that host so the origin
# can re-print it AFTER the post-SSH terminal reset (which otherwise leaves the
# remote's message as a one-frame flicker).
HMW_LOG_DIR="${HMW_LOG_DIR:-$HOME/.hermes/logs}"
HMW_ERR_FILE="$HMW_LOG_DIR/hmw-last-error.log"
HMW_FAILURE_LOG="$HMW_LOG_DIR/hmw-last-failure.log"

hmw_errf() {
  local fmt=$1
  shift
  # shellcheck disable=SC2059
  printf "$fmt" "$@" >&2
  if [ "${HMW_REMOTE:-0}" = "1" ]; then
    # shellcheck disable=SC2059
    { mkdir -p "$HMW_LOG_DIR" && printf "$fmt" "$@" >>"$HMW_ERR_FILE"; } 2>/dev/null || :
  fi
}

hmw_note() {
  printf 'hmw: %s\n' "$*" >&2
}

usage_error() {
  hmw_errf 'hermes-workspace: %s\n' "$1"
  exit 2
}

parse_request() {
  local arg

  REQUEST_HOST=""
  REQUEST_COUNT=""
  HOST_EXPLICIT=0

  if [ "${HMW_REMOTE:-0}" = "1" ]; then
    [ "$#" -eq 1 ] || usage_error 'remote re-entry requires exactly one pane count'
    case "$1" in
      ''|*[!0-9]*) usage_error "pane count must be a positive decimal (got $1)" ;;
    esac
    [ "$1" -ge 1 ] || usage_error "pane count must be >= 1 (got $1)"
    REQUEST_COUNT="$1"
    return
  fi

  [ "$#" -le 2 ] || usage_error 'expected at most one host and one pane count'
  for arg in "$@"; do
    case "$arg" in
      '')
        usage_error 'arguments must not be empty'
        ;;
      -[0-9]* )
        usage_error "pane count must be a positive decimal (got $arg)"
        ;;
      -* )
        usage_error "unsupported option: $arg"
        ;;
      *[!0-9]*)
        [ -z "$REQUEST_HOST" ] || usage_error 'multiple hosts supplied'
        REQUEST_HOST="$arg"
        HOST_EXPLICIT=1
        ;;
      *)
        [ -z "$REQUEST_COUNT" ] || usage_error 'multiple pane counts supplied'
        REQUEST_COUNT="$arg"
        ;;
    esac
  done

  REQUEST_COUNT="${REQUEST_COUNT:-$DEFAULT_COUNT}"
  [ "$REQUEST_COUNT" -ge 1 ] || usage_error "pane count must be >= 1 (got $REQUEST_COUNT)"
}

resolve_default_target() {
  local default_bare here

  [ "$HOST_EXPLICIT" -eq 0 ] || return
  default_bare="${DEFAULT_HOST##*@}"
  default_bare="${default_bare%%.*}"
  here="$(hostname -s 2>/dev/null || hostname)"
  if [ "$here" != "$default_bare" ]; then
    REQUEST_HOST="$DEFAULT_HOST"
  fi
}

resolve_ssh_target() {
  local resolved

  RESOLVE_NOTE=""
  case "$REQUEST_HOST" in
    *@*) SSH_TARGET="$REQUEST_HOST" ;;
    *)
      resolved=""
      if command -v hermes-host-resolve >/dev/null 2>&1; then
        resolved="$(hermes-host-resolve "$REQUEST_HOST" 2>/dev/null)"
      else
        RESOLVE_NOTE="the fleet resolver (hermes-host-resolve) is not on PATH — run hmr to install it"
      fi
      SSH_TARGET="${resolved:-$REQUEST_HOST}"
      case "$SSH_TARGET" in
        *@*) ;;
        *)
          [ -n "$RESOLVE_NOTE" ] || RESOLVE_NOTE="'$REQUEST_HOST' is not in the fleet registry (${HERMES_HOME:-$HOME/.hermes}/hosts/$REQUEST_HOST.yaml is missing), so ssh picks the login user from ~/.ssh/config or your local username ($(id -un 2>/dev/null))"
          hmw_note "warning: $RESOLVE_NOTE."
          hmw_note "         if that's the wrong user, copy the registry entry from h-do1 or run: hmw <user>@$REQUEST_HOST"
          ;;
      esac
      ;;
  esac
}

# Classify a failed SSH attempt into a human reason + fix. Runs ONLY after a
# failure (never on the happy path), using a bounded non-interactive probe.
explain_ssh_failure() {
  local probe reason fix offered user
  user="${SSH_TARGET%@*}"
  [ "$user" != "$SSH_TARGET" ] || user="(ssh default: $(id -un 2>/dev/null))"
  probe="$(ssh -v -o BatchMode=yes -o ConnectTimeout="${HMW_DIAG_TIMEOUT:-8}" \
    -o ServerAliveInterval=5 -o ServerAliveCountMax=2 "$SSH_TARGET" true 2>&1 </dev/null)"
  case "$probe" in
    *"Could not resolve hostname"*)
      reason="the name '${SSH_TARGET#*@}' does not resolve"
      fix="check Tailscale on THIS machine (tailscale status; tailscale up), or add the host to ~/.hermes/hosts/" ;;
    *"login.tailscale.com"*)
      reason="Tailscale SSH on the target wants a browser re-approval"
      fix="open the login.tailscale.com URL shown in: ssh $SSH_TARGET true" ;;
    *"REMOTE HOST IDENTIFICATION HAS CHANGED"*|*"Host key verification failed"*)
      reason="the target's SSH host key does not match ~/.ssh/known_hosts (host rebuilt/re-keyed?)"
      fix="verify the host, then: ssh-keygen -R ${SSH_TARGET#*@}" ;;
    *"Permission denied"*)
      offered="$(printf '%s\n' "$probe" | tr -d '\r' | sed -n 's/^debug1: Offering public key: //p' | awk '{print $1" "$3}' | tr '\n' ';' | sed 's/;$//; s/;/; /g')"
      reason="the target rejected every key this machine offered for user '$user'${offered:+ (offered: $offered)}"
      fix="either the user is wrong (fix ~/.hermes/hosts/<host>.yaml ssh_user, or run hmw <user>@host), or this machine's key is not authorized there — append your ~/.ssh/id_*.pub to the target user's ~/.ssh/authorized_keys (e.g. via h-do1, which reaches every node)" ;;
    *"Connection refused"*)
      reason="nothing is listening on the target's SSH port"
      fix="start sshd on the target (on a Mac: System Settings → General → Sharing → Remote Login)" ;;
    *"timed out"*|*"Operation timed out"*|*"No route to host"*|*"Network is unreachable"*)
      reason="the target did not answer within ${HMW_DIAG_TIMEOUT:-8}s (offline, asleep, or network path down)"
      fix="check: tailscale status; tailscale ping ${SSH_TARGET#*@}" ;;
    *)
      if ssh -o BatchMode=yes -o ConnectTimeout="${HMW_DIAG_TIMEOUT:-8}" "$SSH_TARGET" true </dev/null >/dev/null 2>&1; then
        reason="SSH works now, so the session was dropped (network change, sleep, or a transient error)"
        fix="rerun hmw — the workspace keeps running on the host and will reattach"
      else
        reason="ssh failed for an unrecognised reason"
        fix="see the ssh -v transcript in $HMW_FAILURE_LOG"
      fi ;;
  esac
  EXPLAIN_REASON="$reason"
  EXPLAIN_FIX="$fix"
  EXPLAIN_PROBE="$probe"
}

report_failure() {
  local status=$1 elapsed=$2 remote_err=""

  EXPLAIN_REASON=""; EXPLAIN_FIX=""; EXPLAIN_PROBE=""
  if [ "$status" -eq 255 ]; then
    if [ "$VERIFY" != "1" ] && [ "$elapsed" -ge "${HMW_DROP_SECONDS:-30}" ]; then
      hmw_note "connection to ${REQUEST_HOST} dropped after ${elapsed}s (network change or sleep). The workspace is still running there — rerun hmw to reattach (HMW_RECONNECT=0 disables automatic reattach)."
      return 0
    fi
    explain_ssh_failure
  else
    remote_err="$(ssh -o BatchMode=yes -o ConnectTimeout="${HMW_DIAG_TIMEOUT:-8}" "$SSH_TARGET" \
      "cat \"\$HOME/.hermes/logs/hmw-last-error.log\" 2>/dev/null" </dev/null 2>/dev/null)"
    if [ "$status" -eq 127 ]; then
      EXPLAIN_REASON="'hermes-workspace' was not found on ${REQUEST_HOST}'s PATH"
      EXPLAIN_FIX="on ${REQUEST_HOST}: run hmr (bootstrap links ~/.local/bin/hermes-workspace), or check the repo checkout"
    elif [ -n "$remote_err" ]; then
      EXPLAIN_REASON="the workspace launcher on ${REQUEST_HOST} failed: $(printf '%s' "$remote_err" | sed 's/^hermes-workspace: //' | tr '\n' ' ')"
      EXPLAIN_FIX="act on the message above; re-run with HMW_VERIFY=1 hmw ${REQUEST_HOST} for a non-attaching check"
    else
      EXPLAIN_REASON="the remote workspace exited with status $status and recorded no launcher error"
      EXPLAIN_FIX="re-run with HMW_VERIFY=1 hmw ${REQUEST_HOST}; inspect the Herdr/tmux session there"
    fi
  fi

  {
    printf '\nhmw: ✗ could not open the workspace on %s (%s), exit %s\n' "$REQUEST_HOST" "$SSH_TARGET" "$status"
    [ -z "${RESOLVE_NOTE:-}" ] || printf '  note: %s\n' "$RESOLVE_NOTE"
    printf '  why:  %s\n' "$EXPLAIN_REASON"
    printf '  fix:  %s\n' "$EXPLAIN_FIX"
    printf '  log:  %s\n' "$HMW_FAILURE_LOG"
  } >&2
  {
    mkdir -p "$HMW_LOG_DIR"
    {
      printf '%s hmw %s -> %s exit=%s elapsed=%ss\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$REQUEST_HOST" "$SSH_TARGET" "$status" "$elapsed"
      printf 'note: %s\nwhy: %s\nfix: %s\n' "${RESOLVE_NOTE:-}" "$EXPLAIN_REASON" "$EXPLAIN_FIX"
      [ -z "$remote_err" ] || printf -- '--- remote launcher error ---\n%s\n' "$remote_err"
      [ -z "$EXPLAIN_PROBE" ] || printf -- '--- ssh -v probe ---\n%s\n' "$EXPLAIN_PROBE"
    } >"$HMW_FAILURE_LOG"
  } 2>/dev/null || :
}

shell_quote() {
  local value=$1
  value=${value//\'/\'\\\'\'}
  printf "'%s'" "$value"
}

# Run a command with a wall-clock cap. ssh's ConnectTimeout bounds only the
# TCP connect; a Tailscale SSH browser check can block indefinitely after that.
# The cap is hard only for direct ssh with perl present (every fleet Mac and
# Linux host): a ProxyCommand child can outlive the alarm and hold the capture
# pipe open, and without perl the command runs uncapped.
hmw_bounded() {
  local seconds=$1
  shift
  if command -v perl >/dev/null 2>&1; then
    perl -e 'alarm shift; exec @ARGV or exit 127' "$seconds" "$@"
  else
    "$@"
  fi
}

# Discard bytes the local terminal sent after the remote end stopped reading:
# replies to terminal queries that were in flight when the link died. Without
# this they reach the user's shell as typed input (e.g. "62;22;52c").
hmw_drain_tty_input() {
  local saved
  [ -t 0 ] || return 0
  saved="$(stty -g 2>/dev/null)" || return 0
  # Never leave the user's terminal without echo if Ctrl-C lands mid-drain: the
  # trap is armed BEFORE the modes change and stays armed until they are restored.
  # shellcheck disable=SC2064
  trap "stty '$saved' 2>/dev/null || stty sane 2>/dev/null; exit 130" INT TERM
  # min 0 time 2: a read returns after 0.2s with no input, which dd treats as EOF.
  if stty -echo -icanon min 0 time 2 2>/dev/null; then
    dd bs=4096 count=16 of=/dev/null 2>/dev/null
  fi
  stty "$saved" 2>/dev/null || stty sane 2>/dev/null || :
  trap - INT TERM
}

# After a dropped session, poll until a non-interactive SSH round trip works.
# Returns 1 only when HMW_RECONNECT_MAX_WAIT (seconds of back-off, 0 = no limit)
# is used up. Ctrl-C stops hmw.
hmw_wait_for_target() {
  local delay=2 waited=0 limit="${HMW_RECONNECT_MAX_WAIT:-0}" probe hinted=0
  case "$limit" in ''|*[!0-9]*) limit=0 ;; esac
  while :; do
    probe="$(hmw_bounded "${HMW_PROBE_TIMEOUT:-15}" ssh -o BatchMode=yes -o ConnectTimeout=8 -o ConnectionAttempts=1 \
        "$SSH_TARGET" true </dev/null 2>&1)" && return 0
    # A Tailscale SSH policy check waits for a browser approval that no probe
    # can give; say so once instead of retrying silently.
    case "$probe" in
      *login.tailscale.com*)
        if [ "$hinted" -eq 0 ]; then
          hmw_note "Tailscale SSH on ${REQUEST_HOST} wants a browser re-approval; open the link from: ssh $SSH_TARGET true"
          hinted=1
        fi ;;
    esac
    if [ "$limit" -gt 0 ] && [ "$waited" -ge "$limit" ]; then
      return 1
    fi
    sleep "$delay"
    waited=$((waited + delay))
    delay=$((delay * 2))
    [ "$delay" -le 10 ] || delay=10
  done
}

# Undo terminal modes the remote TUI left on the OUTER local terminal.
hmw_heal_local_terminal() {
  # Drain only after ssh itself failed (255: the link dropped mid-session, so
  # terminal replies were in flight). After a clean exit, keystrokes the user
  # typed ahead are real input and must reach their shell.
  [ "${1:-0}" -ne 255 ] || hmw_drain_tty_input
  # Herdr/Hermes enable Kitty keyboard + modifyOtherKeys on the OUTER local
  # terminal. A Broken pipe/SIGHUP skips their normal teardown, leaving the
  # local shell to receive raw CSI-u key reports. Heal locally after every
  # interactive Herdr SSH return while preserving ssh's real exit status.
  if [ "$BACKEND" = "herdr" ]; then
    if command -v hermes-terminal-reset >/dev/null 2>&1; then
      hermes-terminal-reset --no-clear
    else
      printf '\033[?1016l\033[?1015l\033[?1006l\033[?1003l\033[?1002l\033[?1000l\033[?9l\033[?1004l\033[<u\033[>4m\033[0m\033[?25h'
      stty sane 2>/dev/null || true
    fi
  fi
}

dispatch_remote() {
  local payload remote_command ssh_status ssh_started elapsed
  local ssh_keepalive_interval ssh_keepalive_count
  local reconnect reconnecting=0 quick_drops=0 drop_seconds

  # shellcheck disable=SC2016
  payload='PATH="$HOME/.local/bin:$PATH"'
  payload+=" HMW_REMOTE=$(shell_quote 1)"
  payload+=" HMW_BACKEND=$(shell_quote "$BACKEND")"
  payload+=" HMW_VERIFY=$(shell_quote "$VERIFY")"
  if [ "$BACKEND" = "herdr" ]; then
    payload+=" HERDR_SESSION=$(shell_quote "$SESSION")"
  fi
  payload+=" hermes-workspace $(shell_quote "$REQUEST_COUNT")"
  remote_command="sh -c $(shell_quote "$payload")"
  # Keepalive: probe every 15s, give up after 16 misses (~4 min). Over Tailscale
  # the peer address survives Wi-Fi changes, so a short outage resumes the same
  # session instead of dropping it; a dead link is still noticed in minutes.
  ssh_keepalive_interval="${HMW_SERVER_ALIVE_INTERVAL:-15}"
  ssh_keepalive_count="${HMW_SERVER_ALIVE_COUNT_MAX:-16}"
  case "$ssh_keepalive_interval" in ''|*[!0-9]*) usage_error 'HMW_SERVER_ALIVE_INTERVAL must be a non-negative decimal' ;; esac
  case "$ssh_keepalive_count" in ''|*[!0-9]*) usage_error 'HMW_SERVER_ALIVE_COUNT_MAX must be a non-negative decimal' ;; esac
  reconnect="${HMW_RECONNECT:-1}"
  drop_seconds="${HMW_DROP_SECONDS:-30}"
  case "$drop_seconds" in ''|*[!0-9]*) drop_seconds=30 ;; esac

  if [ "$VERIFY" = "1" ]; then
    ssh -o "ServerAliveInterval=$ssh_keepalive_interval" -o "ServerAliveCountMax=$ssh_keepalive_count" "$SSH_TARGET" "$remote_command"
    ssh_status=$?
    [ "$ssh_status" -eq 0 ] || report_failure "$ssh_status" 0
    return "$ssh_status"
  else
    while :; do
      ssh_started=$SECONDS
      ssh -o "ServerAliveInterval=$ssh_keepalive_interval" -o "ServerAliveCountMax=$ssh_keepalive_count" -t "$SSH_TARGET" "$remote_command"
      ssh_status=$?
      elapsed=$((SECONDS - ssh_started))
      hmw_heal_local_terminal "$ssh_status"
      # 255 = ssh's own failure (the link), not the remote launcher's status.
      # The workspace keeps running on the host, so a dropped link (network
      # change, sleep) is reattached automatically. A quick 255 on the FIRST
      # attempt is a connect/auth failure and is explained instead; quick drops
      # after a reattach are retried at most twice in a row.
      [ "$ssh_status" -eq 255 ] && [ "$reconnect" = "1" ] || break
      if [ "$elapsed" -lt "$drop_seconds" ]; then
        [ "$reconnecting" -eq 1 ] || break
        quick_drops=$((quick_drops + 1))
        [ "$quick_drops" -lt 3 ] || break
      else
        quick_drops=0
      fi
      reconnecting=1
      hmw_note "connection to ${REQUEST_HOST} dropped after ${elapsed}s (network change or sleep); reconnecting — Ctrl-C to stop."
      if ! hmw_wait_for_target; then
        # Return directly: the connect diagnostics in report_failure run ssh
        # without a wall-clock cap and could stall again right after this.
        hmw_note "gave up waiting for ${REQUEST_HOST} (HMW_RECONNECT_MAX_WAIT=${HMW_RECONNECT_MAX_WAIT}s of back-off). The workspace is still running there — rerun hmw to reattach."
        return 255
      fi
      hmw_note "reattaching to ${REQUEST_HOST}."
    done
    # Explain AFTER the terminal reset so the message survives on screen.
    [ "$ssh_status" -eq 0 ] || report_failure "$ssh_status" "$elapsed"
    return "$ssh_status"
  fi
}

label_for() {
  printf 'H%s\n' "$1"
}

command_for() {
  printf 'hermes-pane H%s\n' "$1"
}

local_short_hostname() {
  hostname -s 2>/dev/null || hostname
}

TMUX_SEPARATOR='__HMW_SEP__'
TMUX_SLOT_RECORDS=""
TMUX_INVENTORY=""

tmux_slots_clear() {
  TMUX_SLOT_RECORDS=""
}

tmux_slot_get() {
  local wanted=$1 record

  while IFS= read -r record; do
    [ -n "$record" ] || continue
    if [ "${record%%|*}" = "$wanted" ]; then
      printf '%s\n' "${record#*|}"
      return 0
    fi
  done <<EOF
$TMUX_SLOT_RECORDS
EOF
  return 1
}

tmux_slot_has() {
  tmux_slot_get "$1" >/dev/null 2>&1
}

tmux_slot_set() {
  local label=$1 pane_id=$2

  tmux_slot_has "$label" && return 0
  if [ -n "$TMUX_SLOT_RECORDS" ]; then
    TMUX_SLOT_RECORDS="$TMUX_SLOT_RECORDS
$label|$pane_id"
  else
    TMUX_SLOT_RECORDS="$label|$pane_id"
  fi
}

parse_tmux_inventory_line() {
  local line=$1 rest

  case "$line" in
    *"$TMUX_SEPARATOR"*"$TMUX_SEPARATOR"*) ;;
    *) return 1 ;;
  esac
  TMUX_PARSED_PANE_ID=${line%%"$TMUX_SEPARATOR"*}
  rest=${line#*"$TMUX_SEPARATOR"}
  TMUX_PARSED_LABEL=${rest%%"$TMUX_SEPARATOR"*}
  TMUX_PARSED_COMMAND=${rest#*"$TMUX_SEPARATOR"}
}

tmux_slot_inventory() {
  local line

  tmux_slots_clear
  if ! TMUX_INVENTORY="$(tmux list-panes -t ws:ws -F "#{pane_id}${TMUX_SEPARATOR}#{@hmw_label}${TMUX_SEPARATOR}#{pane_start_command}")"; then
    hmw_errf 'hermes-workspace: unable to inventory tmux workspace ws:ws\n'
    return 1
  fi

  while IFS= read -r line; do
    parse_tmux_inventory_line "$line" || continue
    if [ -n "$TMUX_PARSED_LABEL" ]; then
      tmux_slot_set "$TMUX_PARSED_LABEL" "$TMUX_PARSED_PANE_ID"
    fi
  done <<EOF
$TMUX_INVENTORY
EOF
}

canonicalize_legacy_command() {
  local command=$1 canonical=$2 executable label
  local whole_single whole_double tokens_single tokens_double

  executable=${canonical%% *}
  label=${canonical#* }
  whole_single="'$canonical'"
  whole_double="\"$canonical\""
  tokens_single="'$executable' '$label'"
  tokens_double="\"$executable\" \"$label\""
  if [ "$command" != "$canonical" ] &&
     [ "$command" != "$whole_single" ] &&
     [ "$command" != "$whole_double" ] &&
     [ "$command" != "$tokens_single" ] &&
     [ "$command" != "$tokens_double" ]; then
    return 1
  fi
  printf '%s\n' "$canonical"
}

adopt_legacy_tmux_slots() {
  local number label canonical line normalized

  number=1
  while [ "$number" -le "$REQUEST_COUNT" ]; do
    label="$(label_for "$number")"
    canonical="$(command_for "$number")"
    if ! tmux_slot_has "$label"; then
      while IFS= read -r line; do
        parse_tmux_inventory_line "$line" || continue
        [ -z "$TMUX_PARSED_LABEL" ] || continue
        if normalized="$(canonicalize_legacy_command "$TMUX_PARSED_COMMAND" "$canonical")" &&
           [ "$normalized" = "$canonical" ]; then
          tmux set-option -p -t "$TMUX_PARSED_PANE_ID" @hmw_label "$label"
          tmux_slot_set "$label" "$TMUX_PARSED_PANE_ID"
          break
        fi
      done <<EOF
$TMUX_INVENTORY
EOF
    fi
    number=$((number + 1))
  done
}

ensure_tmux_workspace() {
  local number label command pane_id added

  if ! command -v hermes-pane >/dev/null 2>&1; then
    hmw_errf "hermes-workspace: 'hermes-pane' not on PATH — run hermes-reload (hmr) to install it.\n"
    return 1
  fi

  if tmux has-session -t '=ws' 2>/dev/null; then
    tmux_slot_inventory || return
    adopt_legacy_tmux_slots || return
    added=0
    number=1
    while [ "$number" -le "$REQUEST_COUNT" ]; do
      label="$(label_for "$number")"
      command="$(command_for "$number")"
      if ! tmux_slot_has "$label"; then
        pane_id="$(tmux split-window -h -P -F '#{pane_id}' -t ws:ws "$command")" || return
        tmux set-option -p -t "$pane_id" @hmw_label "$label" || return
        tmux_slot_set "$label" "$pane_id"
        added=1
      fi
      number=$((number + 1))
    done
    if [ "$added" -eq 1 ]; then
      tmux select-layout -t ws:ws even-horizontal || return
    fi
  else
    label=H1
    command='hermes-pane H1'
    pane_id="$(tmux new-session -d -P -F '#{pane_id}' -s ws -n ws "$command")" || return
    tmux set-option -p -t "$pane_id" @hmw_label "$label" || return
    tmux_slots_clear
    tmux_slot_set H1 "$pane_id"
    number=2
    while [ "$number" -le "$REQUEST_COUNT" ]; do
      label="$(label_for "$number")"
      command="$(command_for "$number")"
      pane_id="$(tmux split-window -h -P -F '#{pane_id}' -t ws:ws "$command")" || return
      tmux set-option -p -t "$pane_id" @hmw_label "$label" || return
      tmux_slot_set "$label" "$pane_id"
      number=$((number + 1))
    done
    tmux select-layout -t ws:ws even-horizontal || return
  fi

  pane_id="$(tmux_slot_get H1)" || return
  tmux select-pane -t "$pane_id" || return
}

verify_header() {
  local backend=$1 session=$2 number

  printf 'HMW_VERIFY backend=%s\n' "$backend"
  printf 'HMW_VERIFY session=%s\n' "$session"
  printf 'HMW_VERIFY target=%s\n' "$(local_short_hostname)"
  printf 'HMW_VERIFY requested=%s\n' "$REQUEST_COUNT"
  number=1
  while [ "$number" -le "$REQUEST_COUNT" ]; do
    printf 'HMW_VERIFY slot=H%s command=hermes-pane H%s\n' "$number" "$number"
    number=$((number + 1))
  done
  printf 'HMW_VERIFY inventory-begin\n'
}

verify_tmux_workspace() {
  tmux_slot_inventory || return
  verify_header tmux ws:ws
  [ -z "$TMUX_INVENTORY" ] || printf '%s\n' "$TMUX_INVENTORY"
  printf 'HMW_VERIFY inventory-end\n'
}

attach_tmux_workspace() {
  if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t ws
  else
    exec tmux attach-session -t ws
  fi
}

HERDR_INVENTORY=""
HERDR_PANE_INVENTORY=""
HERDR_NAMES=""
HERDR_LABEL_TARGETS=""

herdr_status_running() {
  local status_json

  status_json="$("${HERDR[@]}" status server --json 2>/dev/null)" || return 1
  printf '%s' "$status_json" | python3 -c 'import json, sys
try:
    value = json.load(sys.stdin)
except (json.JSONDecodeError, UnicodeDecodeError):
    raise SystemExit(1)
raise SystemExit(0 if isinstance(value, dict) and value.get("status") == "running" and value.get("running") is True else 1)'
}

ensure_herdr_server() {
  local attempt socket launched=0

  # Serialize every hmw for this session through the restore lock BEFORE
  # looking at server state: no check-then-lock gap exists, so no hmw can
  # attach or adopt a server while another is restoring or verifying.
  herdr_restore_lock_acquire || return
  attempt=1
  while [ "$attempt" -le 20 ]; do
    if herdr_status_running; then
      if [ "$launched" -eq 1 ]; then
        # Residual (documented): a non-hmw client starting this same session
        # inside this ~100ms locked window would be taken for ours.
        HMW_STARTED_SERVER=1
      fi
      return 0
    fi
    if [ "$attempt" -eq 1 ]; then
      # NO_TMUX=1: the server's restored pane shells inherit this env; without
      # it an SSH-aware rc can auto-attach tmux before hmw relaunches Hermes.
      # Detached: the server must outlive the SSH login that started it.
      hmw_detached env NO_TMUX=1 "${HERDR[@]}" server
      launched=1
    fi
    if [ "$attempt" -lt 20 ]; then
      sleep 0.1
    fi
    attempt=$((attempt + 1))
  done

  socket="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/sessions/$SESSION/herdr.sock"
  hmw_errf "hermes-workspace: Herdr session '%s' did not become ready at %s\n" "$SESSION" "$socket"
  return 1
}

parse_herdr_inventory() {
  local parsed record name target

  if ! parsed="$(HERDR_AGENT_INVENTORY="$HERDR_INVENTORY" HERDR_PANE_INVENTORY="$HERDR_PANE_INVENTORY" python3 -c 'import json, os, sys
try:
    agent_value = json.loads(os.environ["HERDR_AGENT_INVENTORY"])
    pane_value = json.loads(os.environ["HERDR_PANE_INVENTORY"])
    agents = agent_value["result"]["agents"]
    panes = pane_value["result"]["panes"]
    if not isinstance(agents, list) or not isinstance(panes, list):
        raise TypeError
    records = {}
    kinds = {}
    def text(value):
        if not isinstance(value, str) or not value or any(ord(c) < 32 for c in value):
            raise TypeError
        return value
    def slot(name):
        return name.startswith("H") and name[1:].isdigit()
    def record(name, pane_id, kind):
        # Unmanaged display names may repeat; only H-slots reserve targets.
        if not slot(name):
            return
        if kind not in (None, "hermes"):
            raise TypeError
        old = records.get(name)
        if old and pane_id and old != pane_id:
            raise TypeError
        records[name] = pane_id or old or ""
    for agent in agents:
        if not isinstance(agent, dict):
            raise TypeError
        name = agent.get("name")
        pane_id = agent.get("pane_id")
        kind = agent.get("agent")
        if kind is not None:
            text(kind)
        if pane_id is not None:
            text(pane_id)
            kinds.setdefault(pane_id, []).append(kind)
        # Detected agents need not have a managed name (0.8.2).
        if name not in (None, ""):
            record(text(name), pane_id, kind)
        else:
            # An unnamed detection still needs both identity and location.
            text(pane_id)
            text(kind)
    seen_panes = set()
    for pane in panes:
        if not isinstance(pane, dict):
            raise TypeError
        pane_id = text(pane.get("pane_id"))
        if pane_id in seen_panes:
            raise TypeError
        seen_panes.add(pane_id)
        kind = pane.get("agent")
        if kind is not None:
            text(kind)
        kinds.setdefault(pane_id, []).append(kind)
        label = pane.get("label")
        if label in (None, ""):
            continue
        label = text(label)
        # A label reserves a slot, but is never proof of readiness.
        record(label, pane_id, kind)
    targets = set()
    for name, pane_id in records.items():
        if not slot(name) or not pane_id:
            continue
        if pane_id in targets or any(k not in (None, "hermes") for k in kinds.get(pane_id, [])):
            raise TypeError
        targets.add(pane_id)
except (json.JSONDecodeError, UnicodeDecodeError, KeyError, TypeError):
    raise SystemExit(1)
sys.stdout.write("\n".join(name + "\t" + target for name, target in records.items()))')"; then
    hmw_errf "hermes-workspace: malformed agent inventory for Herdr session '%s'; refusing to create agents\n" "$SESSION"
    return 1
  fi

  HERDR_NAMES=""
  HERDR_LABEL_TARGETS=""
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    name=${record%%$'\t'*}
    target=${record#*$'\t'}
    if [ -n "$HERDR_NAMES" ]; then
      HERDR_NAMES+=$'\n'
    fi
    HERDR_NAMES+="$name"
    if [ -n "$target" ]; then
      if [ -n "$HERDR_LABEL_TARGETS" ]; then
        HERDR_LABEL_TARGETS+=$'\n'
      fi
      HERDR_LABEL_TARGETS+="$name"$'\t'"$target"
    fi
  done <<< "$parsed"
}

herdr_slot_inventory() {
  local attempt

  attempt=1
  while [ "$attempt" -le 3 ]; do
    if HERDR_INVENTORY="$("${HERDR[@]}" agent list)" && \
       HERDR_PANE_INVENTORY="$("${HERDR[@]}" pane list)"; then
      parse_herdr_inventory
      return
    fi
    if [ "$attempt" -lt 3 ]; then
      sleep 0.1
    fi
    attempt=$((attempt + 1))
  done
  hmw_errf "hermes-workspace: unable to inventory Herdr session '%s' after 3 attempts\n" "$SESSION"
  return 1
}

herdr_has_label() {
  local wanted=$1 name

  while IFS= read -r name; do
    [ "$name" = "$wanted" ] && return 0
  done <<< "$HERDR_NAMES"
  return 1
}

herdr_target_for_label() {
  local wanted=$1 record name target

  while IFS= read -r record; do
    [ -n "$record" ] || continue
    name=${record%%$'\t'*}
    target=${record#*$'\t'}
    if [ "$name" = "$wanted" ] && [ -n "$target" ]; then
      printf '%s\n' "$target"
      return 0
    fi
  done <<< "$HERDR_LABEL_TARGETS"
  return 1
}

herdr_resolve_label() {
  local label=$1 target agent_json

  target="$(herdr_target_for_label "$label" 2>/dev/null || true)"
  if [ -n "$target" ]; then
    printf '%s\n' "$target"
    return 0
  fi
  # Older managed-agent inventories may expose only the name.
  agent_json="$("${HERDR[@]}" agent get "$label")" || return
  printf '%s' "$agent_json" | python3 -c 'import json, sys
try:
    agent = json.load(sys.stdin)["result"]["agent"]
    target = agent["pane_id"]
    if agent.get("name") != sys.argv[1] or agent.get("agent") not in (None, "hermes"):
        raise ValueError
    if not isinstance(target, str) or not target or any(ord(c) < 32 for c in target):
        raise ValueError
except (ValueError, KeyError, TypeError, AttributeError):
    raise SystemExit(1)
print(target)' "$label"
}

herdr_resolve_requested_slots() {
  local number label target resolved record old_target

  resolved=""
  number=1
  while [ "$number" -le "$REQUEST_COUNT" ]; do
    label="$(label_for "$number")"
    if ! herdr_has_label "$label"; then
      hmw_errf "hermes-workspace: Herdr session '%s' is missing expected agent %s after creation\n" "$SESSION" "$label"
      return 1
    fi
    target="$(herdr_resolve_label "$label")" || return
    while IFS= read -r record; do
      old_target=${record#*$'\t'}
      if [ "$old_target" = "$target" ]; then
        hmw_errf "hermes-workspace: duplicate resolved target %s for %s in session '%s'\n" "$target" "$label" "$SESSION"
        return 1
      fi
    done <<< "$resolved"
    resolved+="$label"$'\t'"$target"$'\n'
    number=$((number + 1))
  done
  # Name-only legacy records had no target during inventory parsing. Reconcile
  # every resolved target with ALL detections, including unmanaged/unnamed ones.
  if ! HMW_RESOLVED="$resolved" HERDR_AGENT_INVENTORY="$HERDR_INVENTORY" HERDR_PANE_INVENTORY="$HERDR_PANE_INVENTORY" python3 -c 'import json, os
try:
    targets = {record.split("\t")[1] for record in os.environ["HMW_RESOLVED"].splitlines()}
    agents = json.loads(os.environ["HERDR_AGENT_INVENTORY"])["result"]["agents"]
    panes = json.loads(os.environ["HERDR_PANE_INVENTORY"])["result"]["panes"]
    if any(item.get("pane_id") in targets and item.get("agent") not in (None, "hermes")
           for item in agents + panes):
        raise ValueError
except (ValueError, KeyError, TypeError, AttributeError, IndexError):
    raise SystemExit(1)'; then
    hmw_errf "hermes-workspace: conflicting inventory identity for resolved slots in Herdr session '%s'; refusing to reuse panes\n" "$SESSION"
    return 1
  fi
  # Cache the complete checked mapping, including legacy agent-get results.
  # Readiness and focus must use these targets, not resolve them again.
  HERDR_LABEL_TARGETS="$resolved"
}

herdr_pane_matches_slot() {
  local pane_id=$1 label=$2 focused=${3:-0}

  HMW_PANE_INVENTORY="$HERDR_PANE_INVENTORY" python3 -c 'import json, os, sys
try:
    pane = json.load(sys.stdin)["result"]["pane"]
    pane_id, label, focused = sys.argv[1:]
    if pane["pane_id"] != pane_id or pane.get("agent") not in (None, "hermes"):
        raise ValueError
    current_label = pane.get("label")
    if current_label not in (None, "", label):
        raise ValueError
    # Legacy managed names can lack pane labels. A pane that reserved a slot
    # by label must still carry it, even if it was cleared since inventory.
    panes = json.loads(os.environ["HMW_PANE_INVENTORY"])["result"]["panes"]
    if any(p["pane_id"] == pane_id and p.get("label") == label for p in panes):
        if current_label != label:
            raise ValueError
    if focused == "1" and pane.get("focused") is not True:
        raise ValueError
except (ValueError, KeyError, TypeError, AttributeError):
    raise SystemExit(1)' "$pane_id" "$label" "$focused"
}

herdr_focus_label() {
  local label=$1 target status_json pane_json

  target="$(herdr_target_for_label "$label")" || return
  if ! "${HERDR[@]}" agent focus "$target" >/dev/null 2>&1; then
    # 0.8.2 agent focus rejects label-only panes; pane focus CLI is directional.
    # Use the exact-pane RPC, never workspace focus (which can leave H2 active).
    status_json="$("${HERDR[@]}" status server --json)" || return
    if ! printf '%s' "$status_json" | python3 -c 'import json, socket, sys
try:
    status = json.load(sys.stdin)
    if status.get("running") is not True or status.get("status") != "running":
        raise ValueError
    request = {"id": "hmw:focus", "method": "pane.focus", "params": {"pane_id": sys.argv[1]}}
    with socket.socket(socket.AF_UNIX) as sock:
        sock.settimeout(2)
        sock.connect(status["socket"])
        sock.sendall((json.dumps(request) + "\n").encode())
        with sock.makefile("rb") as stream:
            response = json.loads(stream.readline(1048576))
    if response.get("id") != request["id"] or "error" in response or "result" not in response:
        raise ValueError
    result = response["result"]
    pane = result["pane"]
    if result.get("type") != "pane_info" or pane["pane_id"] != sys.argv[1] or pane.get("focused") is not True:
        raise ValueError
except (OSError, ValueError, KeyError, TypeError, AttributeError):
    raise SystemExit(1)' "$target"; then
      hmw_errf "hermes-workspace: unable to focus exact pane %s for %s in session '%s'\n" "$target" "$label" "$SESSION"
      return 1
    fi
  fi
  pane_json="$("${HERDR[@]}" pane get "$target")" || return
  if ! printf '%s' "$pane_json" | herdr_pane_matches_slot "$target" "$label" 1; then
    hmw_errf "hermes-workspace: exact focus of %s (%s) was not confirmed in session '%s'\n" "$label" "$target" "$SESSION"
    return 1
  fi
}

herdr_uses_existing_pane_start() {
  "${HERDR[@]}" agent start --help >/dev/null 2>&1
}

herdr_json_pane_id() {
  python3 -c 'import json, sys
try:
    value = json.load(sys.stdin)
    result = value["result"]
    pane = result.get("pane") or result.get("root_pane")
    pane_id = pane["pane_id"]
    if not isinstance(pane_id, str) or not pane_id:
        raise TypeError
except (json.JSONDecodeError, UnicodeDecodeError, KeyError, TypeError, AttributeError):
    raise SystemExit(1)
sys.stdout.write(pane_id)'
}

# Shared Python: is this argv an interactive Hermes chat? Prepended to the
# readiness check and the pane-memory snapshot, so both agree on "Hermes".
HMW_PY_HERMES_ARGV='import os, re
def hermes_launcher_code(code):
    # Hermes 0.21+ managed launchers exec the store Python as
    # `python3 -I -c <bootstrap>`. Accept only the published Hermes CLI
    # entry shapes (hermes_cli/_launchers.py); arbitrary -c code, and
    # sibling entry points such as hermes-acp, stay rejected.
    lines = code.strip().splitlines()
    if not lines:
        return False
    if (lines[-1] == "sys.exit(main())" and "import hermes_bootstrap" in lines
            and "from hermes_cli.main import main" in lines):
        return True
    statements = [part.strip() for part in code.strip().split(";")]
    # (chr(39) is a single quote; this code lives in a single-quoted shell string.)
    entry = "runpy.run_module({0}hermes_cli.main{0}, run_name={0}__main__{0}, alter_sys=True)"
    return "import hermes_bootstrap" in statements and statements[-1] == entry.format(chr(39))

def hermes_args(argv):
    executable = os.path.basename(argv[0])
    if executable == "hermes":
        return argv[1:]
    if not re.fullmatch(r"python(?:[0-9]+(?:\.[0-9]+)*)?", executable):
        return None
    # Parse interpreter options, not arbitrary later tokens that happen
    # to say hermes. In particular, -c code and other scripts are not it.
    i = 1
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            i += 1
            break
        if not arg.startswith("-"):
            break
        if arg == "--check-hash-based-pycs":
            if argv[i + 1:i + 2] not in (["default"], ["always"], ["never"]):
                return None
            i += 2
            continue
        if arg == "-" or arg.startswith("--"):
            return None
        # Python groups short flags and allows attached m/W/X operands.
        # An operand consumes the rest of this token, never more flags.
        j = 1
        while j < len(arg):
            option = arg[j]
            if option in "mWX":
                value = arg[j + 1:]
                if not value:
                    i += 1
                    if i >= len(argv) or not argv[i]:
                        return None
                    value = argv[i]
                if option == "m":
                    return argv[i + 1:] if value == "hermes_cli.main" else None
                break
            if option == "c":
                value = arg[j + 1:]
                if not value:
                    i += 1
                    if i >= len(argv):
                        return None
                    value = argv[i]
                return argv[i + 1:] if hermes_launcher_code(value) else None
            # -i keeps Python alive at its REPL after Hermes exits. It
            # cannot prove live Hermes even when PID/identity are retained.
            if option not in "bBdEIOPqsSuvx":
                return None
            j += 1
        i += 1
    if i < len(argv) and os.path.basename(argv[i]) == "hermes":
        return argv[i + 1:]
    return None

def interactive_chat(args):
    if args is None:
        return False
    # Bare hermes defaults to chat, as do its profile/resume shortcuts.
    # Use known option arities, so values like --resume setup are not
    # confused with subcommands. Unknown modes fail closed. Query/oneshot
    # invocations are deliberately excluded (behavior varies by version).
    values = {"--profile", "-p", "--model", "-m", "--provider", "--reasoning",
              "--toolsets", "-t", "--skills", "-s", "--resume", "-r", "--in"}
    switches = {"--tui", "--cli", "--dev", "--worktree", "-w", "--yolo",
                "--pass-session-id", "--ignore-user-config", "--ignore-rules",
                "--safe-mode", "--accept-hooks", "--no-restore-cwd"}
    chat_values = {"--source", "--max-turns", "--run-budget"}
    chat_switches = {"--checkpoints", "--create-if-missing", "--verbose", "-v"}
    chat = False
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "chat" and not chat:
            chat = True
            i += 1
            continue
        # -w can lead a group; -v is safe only after explicit chat.
        # Peel switches; the first value option owns the remaining suffix.
        # Profile -p is a launcher shortcut, not a parser group member.
        group_switches = "wv" if chat else "w"
        while len(arg) > 2 and arg[0] == "-" and arg[1] in group_switches:
            if arg[2] not in group_switches + "cmrst":
                return False
            arg = "-" + arg[2:]
        option, equal, value = arg.partition("=")
        # Only known single-letter value options may consume a suffix.
        # Do not interpret arbitrary substrings or one-shot -q/-z as chat.
        if len(arg) > 2 and (arg[:2] in values or arg[:2] == "-c"):
            option, equal, value = arg[:2], "=", arg[2:]
            if value.startswith("="):
                value = value[1:]
        if option in values or (chat and option in chat_values):
            if equal:
                if not value:
                    return False
            else:
                i += 1
                if i >= len(args) or not args[i] or args[i].startswith("-"):
                    return False
        elif option in ("--continue", "-c"):
            if equal and not value:
                return False
            if not equal and i + 1 < len(args) and not args[i + 1].startswith("-"):
                i += 1
        elif not equal and (option in switches or (chat and option in chat_switches)):
            pass
        else:
            return False
        i += 1
    return True
'

herdr_agent_pane_ready() {
  local pane_id=$1 label=$2 pane_json visible process_json

  # Read only the current viewport, then check the live foreground job. A
  # retained composer in scrollback (or on screen after exit) is not liveness.
  visible="$("${HERDR[@]}" pane read "$pane_id" --source visible --format text 2>/dev/null)" || return
  process_json="$("${HERDR[@]}" pane process-info --pane "$pane_id" 2>/dev/null)" || return
  pane_json="$("${HERDR[@]}" pane get "$pane_id" 2>/dev/null)" || return
  printf '%s' "$pane_json" | herdr_pane_matches_slot "$pane_id" "$label" || return
  HMW_PANE_JSON="$pane_json" HMW_PROCESS_JSON="$process_json" HMW_VISIBLE="$visible" python3 -c "$HMW_PY_HERMES_ARGV"'import json, os, re, sys
try:
    pane = json.loads(os.environ["HMW_PANE_JSON"])["result"]["pane"]
    process = json.loads(os.environ["HMW_PROCESS_JSON"])["result"]["process_info"]
    if pane["pane_id"] != sys.argv[1] or process["pane_id"] != sys.argv[1]:
        raise ValueError
    kind = pane.get("agent")
    if kind not in (None, "hermes"):
        raise ValueError
    def pid(value):
        return type(value) is int and value > 0
    shell = process["shell_pid"]
    group = process["foreground_process_group_id"]
    jobs = process["foreground_processes"]
    if not pid(shell) or not pid(group) or not isinstance(jobs, list) or not jobs:
        raise ValueError
    live = False
    for job in jobs:
        if not isinstance(job, dict) or not pid(job.get("pid")):
            raise ValueError
        argv = job.get("argv")
        if not isinstance(argv, list) or not argv or not all(isinstance(a, str) for a in argv):
            continue
        if interactive_chat(hermes_args(argv)):
            live = True
    if not live:
        raise ValueError
    # Semantic detection remains authoritative when present. For panes with
    # no identity (0.8.2, or a 0.21 managed launcher whose process is named
    # python3), require BOTH a live Hermes executable and a ready front end:
    # the classic composer, or the TUI ready status line. A resumed TUI
    # shows the conversation and a bare prompt, never the classic composer.
    visible = os.environ["HMW_VISIBLE"]
    low = visible.lower()
    composer = "hermes" in low and ("ask me anything" in low or "type your message" in low)
    def tui_gateway(argv):
        return (isinstance(argv, list) and len(argv) >= 3 and all(isinstance(a, str) for a in argv)
                and re.fullmatch(r"python(?:[0-9]+(?:\.[0-9]+)*)?", os.path.basename(argv[0])) is not None
                and argv[-2:] == ["-m", "tui_gateway.entry"])
    bottom = [line for line in visible.splitlines() if line.strip()][-6:]
    tui_ready = (any(tui_gateway(job.get("argv")) for job in jobs)
                 and any(re.match(r"\s*─+\s*ready\s*│", line) for line in bottom)
                 and any(re.match(r"\s*❯", line) for line in bottom))
    if kind != "hermes" and not composer and not tui_ready:
        raise ValueError
except (ValueError, KeyError, TypeError, AttributeError):
    raise SystemExit(1)' "$pane_id"
}

herdr_wait_for_agent_pane() {
  local pane_id=$1 label=$2 seconds=${3:-3} attempt limit

  limit=$((seconds * 10))
  attempt=1
  while [ "$attempt" -le "$limit" ]; do
    if herdr_agent_pane_ready "$pane_id" "$label"; then
      return 0
    fi
    if [ "$attempt" -eq 1 ] && [ "$seconds" -gt 3 ]; then
      hmw_note "waiting up to ${seconds}s for Hermes in pane $pane_id ($label)"
    fi
    [ "$attempt" -eq "$limit" ] || sleep 0.1
    attempt=$((attempt + 1))
  done
  return 1
}

# Set only when THIS run found the session stopped and started its server.
HMW_STARTED_SERVER=0
HMW_RESTORE_LOCK=""


HMW_VERIFY_STOPPED=0

# Verify probes must never leave behind a session they started (labelled panes
# would be saved without Hermes in them). Runs from the EXIT trap too, so an
# interrupted verify still stops its server BEFORE the lock is released.
herdr_verify_stop_owned_server() {
  if [ "$VERIFY" = "1" ] && [ "$HMW_STARTED_SERVER" -eq 1 ] && [ "$HMW_VERIFY_STOPPED" -eq 0 ]; then
    HMW_VERIFY_STOPPED=1
    if ! "${HERDR[@]}" server stop >/dev/null 2>&1; then
      hmw_errf "hermes-workspace: could not stop Herdr session '%s' started by this verify run\n" "$SESSION"
      return 1
    fi
  fi
  return 0
}

herdr_restore_exit() {
  herdr_verify_stop_owned_server || :
  herdr_restore_lock_release
}

herdr_restore_lock_release() {
  if [ -n "$HMW_RESTORE_LOCK" ]; then
    rmdir "$HMW_RESTORE_LOCK" 2>/dev/null || :
    HMW_RESTORE_LOCK=""
  fi
}

herdr_restore_lock_acquire() {
  local lock="$HMW_LOG_DIR/hmw-$SESSION.restore.lock" attempt

  mkdir -p "$HMW_LOG_DIR" 2>/dev/null || :
  attempt=1
  while ! mkdir "$lock" 2>/dev/null; do
    if [ "$attempt" -ge "${HMW_RESTORE_LOCK_WAIT:-60}" ]; then
      hmw_errf "hermes-workspace: another hmw is restoring Herdr session '%s' (lock %s held for %ss); retry, or remove that directory if no hmw is running\n" "$SESSION" "$lock" "${HMW_RESTORE_LOCK_WAIT:-60}"
      return 1
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  HMW_RESTORE_LOCK=$lock
  trap herdr_restore_exit EXIT
}

herdr_pane_has_hermes() {
  HMW_TARGET="$1" HERDR_AGENT_INVENTORY="$HERDR_INVENTORY" HERDR_PANE_INVENTORY="$HERDR_PANE_INVENTORY" python3 -c 'import json, os
items = json.loads(os.environ["HERDR_AGENT_INVENTORY"])["result"]["agents"]
items += json.loads(os.environ["HERDR_PANE_INVENTORY"])["result"]["panes"]
raise SystemExit(0 if any(i.get("pane_id") == os.environ["HMW_TARGET"] and i.get("agent") == "hermes" for i in items) else 1)'
}

# ── Pane memory: which Hermes conversation each pane holds ─────────────
# Signal: Hermes' own cross-process lease registry,
# $HERMES_HOME/runtime/active_sessions.json (hermes_cli/active_sessions.py:
# _lease_entry writes {session_id, surface, pid, process_start_time}). The CLI
# claims it at start and the TUI gateway moves it on /new, resume and
# compression, so it names the LIVE session. Herdr's own pane agent_session
# value is not used: it stays on the launch id.
# A lease belongs to a pane only when its pid is still the process that took
# it (start time matches, computed as active_sessions._process_start_time
# does) and its ancestry reaches a FOREGROUND Hermes of that pane (the TUI
# lease is held by `python -m tui_gateway.entry`, a child of node, a child of
# the pane's `hermes`). Background Hermes and recycled pids never count.
HMW_STATE_DIR="${HMW_STATE_DIR:-$HOME/.hermes/hmw}"
HMW_SNAPSHOT_INTERVAL="${HMW_SNAPSHOT_INTERVAL:-300}"
HMW_RESTORE_PENDING_SECONDS="${HMW_RESTORE_PENDING_SECONDS:-180}"
HMW_SNAPSHOT_MAX_AGE="${HMW_SNAPSHOT_MAX_AGE:-1209600}"
HMW_LOOP_MARKER="--hmw-snapshot-loop"
# Distinct earlier snapshots (and pre-restore pins) kept under $HMW_STATE_DIR/history.
HMW_SNAPSHOT_KEEP="${HMW_SNAPSHOT_KEEP:-5}"
# Shared archive writer (prepended to both writers' Python, like HMW_PY_HERMES_ARGV).
# Names are <prefix><UTC stamp with usec>Z-NNN.json: fixed width, so name order is
# age order. NNN is always above the highest number already used for that stamp,
# so a same-stamp burst never reuses a name that pruning just removed. The file is
# created exclusively, and deleted again if writing fails (e.g. disk full).
HMW_PY_ARCHIVE='import os, time
def hmw_stamp(t):
    return time.strftime("%Y%m%dT%H%M%S", time.gmtime(t)) + ".%06dZ" % int((t % 1) * 1e6)
def hmw_keep():
    try:
        return max(3, int(os.environ.get("HMW_SNAPSHOT_KEEP") or 5))
    except ValueError:
        return 5
def hmw_archive(hist, prefix, stamp, text, keep):
    os.makedirs(hist, exist_ok=True)
    mine = lambda n: (n.startswith(prefix) and n.endswith(".json")
                      and n[len(prefix):len(prefix) + 1].isdigit())
    head = prefix + stamp + "-"
    seq = 0
    for n in os.listdir(hist):
        if mine(n) and n.startswith(head) and n[len(head):-len(".json")].isdigit():
            seq = max(seq, int(n[len(head):-len(".json")]) + 1)
    for n in range(seq, 1000):
        path = os.path.join(hist, "%s%03d.json" % (head, n))
        try:
            fh = open(path, "x")
        except FileExistsError:
            continue
        try:
            with fh:
                fh.write(text)
        except BaseException:
            try:
                os.remove(path)
            except OSError:
                pass
            raise
        break
    for n in sorted(n for n in os.listdir(hist) if mine(n))[:-keep]:
        os.remove(os.path.join(hist, n))
'

# Start a long-lived helper (Herdr server, snapshot loop) in its own session.
# A plain `nohup cmd &` stays in the SSH login's session: when that client goes
# away (quit, Mac terminal restart, given-up reconnect), the hangup reaches the
# Herdr server, which shuts down and kills every pane (h-btp 2026-10-28). Linux
# has setsid(1); macOS does not, so use perl POSIX::setsid. Neither forks when
# called from this non-interactive script (not a process-group leader), so $!
# stays the helper's own pid for the loop pidfile. Last resort: plain nohup.
hmw_detached() {
  local monitor=0
  # Job control (interactive parent, or inherited SHELLOPTS=monitor) would make
  # the child a group leader: setsid(1) would fork (stale $!) and perl setsid()
  # would fail. Spawn with monitor mode off, then restore it.
  case $- in *m*) monitor=1; set +m ;; esac
  if command -v setsid >/dev/null 2>&1; then
    nohup setsid "$@" </dev/null >/dev/null 2>&1 &
  elif command -v perl >/dev/null 2>&1; then
    nohup perl -MPOSIX -e 'POSIX::setsid(); exec { $ARGV[0] } @ARGV or exit 127' "$@" </dev/null >/dev/null 2>&1 &
  else
    nohup "$@" </dev/null >/dev/null 2>&1 &
  fi
  [ "$monitor" = 0 ] || set -m
}

# Keep the snapshot a restore is about to use, so a bad restore (and the
# snapshot loop that follows it) can never erase the record it started from.
hmw_snapshot_pin_pre_restore() {
  local file
  file="$(hmw_snapshot_file)"
  [ -s "$file" ] || return 0
  HMW_SNAPSHOT_FILE="$file" HMW_SNAPSHOT_KEEP="$HMW_SNAPSHOT_KEEP" python3 -c "$HMW_PY_ARCHIVE"'
file = os.environ["HMW_SNAPSHOT_FILE"]
with open(file) as src:
    text = src.read()
hmw_archive(os.path.join(os.path.dirname(file), "history"),
            os.path.basename(file)[:-len(".json")] + ".pre-restore-", hmw_stamp(time.time()), text, hmw_keep())' 2>/dev/null || :
}

# psutil.Process(pid).create_time(), as Hermes stamps process_start_time. On
# Linux that is /proc/<pid>/stat starttime / CLK_TCK + /proc/stat btime (psutil
# _pslinux); elsewhere psutil itself, or None (fail closed: nothing recorded).
HMW_PY_START_TIME='import os, sys
def start_time(pid):
    try:
        if sys.platform.startswith("linux"):
            proc = os.environ.get("HMW_PROC_ROOT") or "/proc"
            with open("%s/%d/stat" % (proc, pid), "rb") as fh:
                data = fh.read()
            ticks = float(data[data.rfind(b")") + 2:].split()[19])
            with open(proc + "/stat", "rb") as fh:
                for line in fh:
                    if line.startswith(b"btime"):
                        return ticks / os.sysconf("SC_CLK_TCK") + float(line.split()[1])
            return None
        import psutil
        return float(psutil.Process(pid).create_time())
    except Exception:
        return None
'

hmw_proc_start_time() {
  python3 -c "$HMW_PY_START_TIME"'
value = start_time(int(sys.argv[1]))
if value is None:
    raise SystemExit(1)
print(repr(value))' "$1"
}

hmw_snapshot_file() {
  printf '%s/%s.panes.json\n' "$HMW_STATE_DIR" "$SESSION"
}

# With "print": write nothing and print pane<TAB>session for every pane whose
# foreground Hermes holds a live lease (restore uses it to reserve sessions
# that are already running).
hmw_snapshot_panes() {
  local panes_json pane_ids pane_id info infos="" ps_out file print_only=0 info_fail=0

  [ "${1:-}" = print ] && print_only=1
  file="$(hmw_snapshot_file)"
  panes_json="$("${HERDR[@]}" pane list 2>/dev/null)" || return 1
  pane_ids="$(printf '%s' "$panes_json" | python3 -c 'import json, sys
for p in json.load(sys.stdin)["result"]["panes"]:
    print(p["pane_id"])')" || return 1
  while IFS= read -r pane_id; do
    [ -n "$pane_id" ] || continue
    info="$("${HERDR[@]}" pane process-info --pane "$pane_id" 2>/dev/null | tr -d '\n')" || { info_fail=1; continue; }
    infos+="$info"$'\n'
  done <<< "$pane_ids"
  ps_out="$(ps -A -o pid= -o ppid= 2>/dev/null)" || return 1
  [ "$print_only" -eq 1 ] || mkdir -p "$HMW_STATE_DIR" 2>/dev/null || return 1
  HMW_PANES="$panes_json" HMW_INFOS="$infos" HMW_PS="$ps_out" HMW_SNAPSHOT_FILE="$file" \
  HMW_PRINT_ONLY="$print_only" HMW_INFO_FAIL="$info_fail" HMW_SNAPSHOT_KEEP="$HMW_SNAPSHOT_KEEP" HMW_LEASES="${HERMES_HOME:-$HOME/.hermes}/runtime/active_sessions.json" \
  python3 -c "$HMW_PY_HERMES_ARGV$HMW_PY_START_TIME$HMW_PY_ARCHIVE"'import json, time
file = os.environ["HMW_SNAPSHOT_FILE"]
print_only = os.environ["HMW_PRINT_ONLY"] == "1"
# print mode feeds the restore "already live" reservation: any doubt about a
# pane that might hold Hermes must fail (exit 3) so restore starts fresh.
uncertain = os.environ.get("HMW_INFO_FAIL") == "1"
try:
    if print_only:
        raise OSError
    old = json.load(open(file))
    # A restore just typed resume commands; Hermes may not hold its lease yet.
    if float(old.get("restore_pending_until") or 0) > time.time():
        raise SystemExit(0)
except (OSError, ValueError, AttributeError, TypeError):
    pass
safe = re.compile(r"[A-Za-z0-9_.:-]+")
panes = json.loads(os.environ["HMW_PANES"])["result"]["panes"]
fg = {}  # pane -> pids of its FOREGROUND interactive Hermes processes
for line in os.environ["HMW_INFOS"].splitlines():
    try:
        info = json.loads(line)["result"]["process_info"]
        hermes = set()
        for j in info["foreground_processes"]:
            argv = j.get("argv")
            if (type(j.get("pid")) is int and isinstance(argv, list) and argv
                    and all(isinstance(a, str) for a in argv) and interactive_chat(hermes_args(argv))):
                hermes.add(j["pid"])
        fg[info["pane_id"]] = hermes
    except (ValueError, KeyError, TypeError, AttributeError):
        uncertain = True
        continue
parent = {}
for line in os.environ["HMW_PS"].splitlines():
    f = line.split()
    if len(f) == 2 and f[0].isdigit() and f[1].isdigit():
        parent[int(f[0])] = int(f[1])
def ancestry(pid):
    seen = set()
    while pid in parent and pid not in seen and pid > 1:
        seen.add(pid)
        pid = parent[pid]
    return seen
def live_lease(l):
    if not isinstance(l, dict) or l.get("surface") not in ("cli", "tui"):
        return False
    sid, pid, start = l.get("session_id"), l.get("pid"), l.get("process_start_time")
    if not isinstance(sid, str) or not safe.fullmatch(sid) or type(pid) is not int or pid <= 1:
        return False
    if type(start) not in (int, float):
        return False
    now = start_time(pid)
    return now is not None and abs(now - start) < 0.001
try:
    leases = json.load(open(os.environ["HMW_LEASES"])).get("entries") or []
except FileNotFoundError:
    leases = []
    if any(fg.values()):
        uncertain = True
except (OSError, ValueError, AttributeError):
    leases, uncertain = [], True
if not isinstance(leases, list):
    leases, uncertain = [], True
leases = [l for l in leases if live_lease(l)]
out, used = [], set()
for p in panes:
    pids = fg.get(p.get("pane_id"), set())
    ids = {l["session_id"] for l in leases if ancestry(l["pid"]) & pids}
    if len(ids) != 1:
        if pids:
            uncertain = True  # foreground Hermes we cannot map uniquely
        continue  # no foreground Hermes here, or ambiguous: never guess
    sid = ids.pop()
    if sid in used:
        uncertain = True
        continue
    used.add(sid)
    out.append({"pane_id": p["pane_id"], "workspace_id": p.get("workspace_id"), "tab_id": p.get("tab_id"),
                "tab_label": p.get("tab_label"), "pane_label": p.get("label") or None, "session_id": sid})
if print_only:
    if uncertain:
        raise SystemExit(3)
    for o in out:
        print(o["pane_id"] + "\t" + o["session_id"])
    raise SystemExit(0)
# Read the previous snapshot into memory, replace the main snapshot FIRST, and
# only then archive the previous one (when the pane set changed). History is
# best effort: it can never block or starve the main write.
try:
    with open(file) as fh:
        prev = json.load(fh)
except (OSError, ValueError):
    prev = None
tmp = "%s.tmp.%d" % (file, os.getpid())
with open(tmp, "w") as fh:
    json.dump({"saved_at": time.time(), "panes": out}, fh, indent=1)
os.replace(tmp, file)
if isinstance(prev, dict) and prev.get("panes") and prev.get("panes") != out:
    try:
        try:
            saved = float(prev.get("saved_at") or 0)
        except (TypeError, ValueError):
            saved = 0.0
        if not (946684800.0 <= saved <= 4102444800.0):   # 2000..2100, finite; else now
            saved = time.time()
        hmw_archive(os.path.join(os.path.dirname(file), "history"),
                    os.path.basename(file)[:-len(".json")] + ".", hmw_stamp(saved),
                    json.dumps(prev, indent=1), hmw_keep())
    except (OSError, ValueError, TypeError, OverflowError):
        pass'
}

# Snapshots are written ONLY under the restore lock, taken without waiting: a
# held lock means an hmw is restoring/attaching, so this snapshot is skipped.
hmw_snapshot_once() {
  local lock="$HMW_LOG_DIR/hmw-$SESSION.restore.lock" rc

  mkdir -p "$HMW_LOG_DIR" 2>/dev/null || :
  mkdir "$lock" 2>/dev/null || return 0
  HMW_RESTORE_LOCK=$lock
  trap herdr_restore_lock_release EXIT
  rc=0
  if herdr_status_running; then
    hmw_snapshot_panes || rc=$?
  fi
  herdr_restore_lock_release
  trap - EXIT
  return "$rc"
}

# Mapped pane_id<TAB>session_id lines for the CURRENT inventory, or nothing at
# all (fail closed) when the snapshot is malformed, conflicting or older than
# HMW_SNAPSHOT_MAX_AGE. Herdr keeps public pane/tab numbers across restarts
# (session.json public_pane_numbers), so an exact pane_id wins; else a unique
# (tab, pane) number suffix match.
hmw_snapshot_resume_map() {
  local file
  file="$(hmw_snapshot_file)"
  [ -f "$file" ] || return 0
  HMW_SNAPSHOT_FILE="$file" HMW_MAX_AGE="$HMW_SNAPSHOT_MAX_AGE" HERDR_PANE_INVENTORY="$HERDR_PANE_INVENTORY" python3 -c 'import json, os, re, time
def bad():
    raise SystemExit(1)
try:
    doc = json.load(open(os.environ["HMW_SNAPSHOT_FILE"]))
    panes = json.loads(os.environ["HERDR_PANE_INVENTORY"])["result"]["panes"]
    max_age = float(os.environ["HMW_MAX_AGE"])
except (OSError, ValueError, KeyError, TypeError):
    bad()
safe = re.compile(r"[A-Za-z0-9_.:-]+")
now = time.time()
if not isinstance(doc, dict) or not isinstance(doc.get("panes"), list) or not isinstance(panes, list):
    bad()
saved = doc.get("saved_at")
if type(saved) not in (int, float) or not now - max_age <= saved <= now + 300:
    bad()
snap = doc["panes"]
for s in snap:
    if not isinstance(s, dict) or not isinstance(s.get("pane_id"), str) or not s["pane_id"]:
        bad()
    if not isinstance(s.get("session_id"), str) or not safe.fullmatch(s["session_id"]):
        bad()
    if any(s.get(k) is not None and not isinstance(s.get(k), str) for k in ("tab_id", "pane_label")):
        bad()
for p in panes:
    if not isinstance(p, dict) or not isinstance(p.get("pane_id"), str):
        bad()
ids = [s["pane_id"] for s in snap]
sids = [s["session_id"] for s in snap]
if len(set(ids)) != len(ids) or len(set(sids)) != len(sids):
    bad()  # conflicting records: trust none of them
def tail(value):
    return str(value or "").rsplit(":", 1)[-1]
def key(p):
    return (tail(p.get("tab_id")), tail(p.get("pane_id")))
by_id = {s["pane_id"]: s for s in snap}
skeys = [key(s) for s in snap]
ckeys = [key(p) for p in panes]
out, used = [], set()
for p in panes:
    s = by_id.get(p["pane_id"])
    if s is None and ckeys.count(key(p)) == 1 and skeys.count(key(p)) == 1:
        s = snap[skeys.index(key(p))]
    if s is None or s["session_id"] in used:
        continue
    used.add(s["session_id"])
    out.append(p["pane_id"] + "\t" + s["session_id"])
if out:
    print("\n".join(out))'
}

hmw_mark_restore_pending() {
  local file
  file="$(hmw_snapshot_file)"
  [ -f "$file" ] || return 0
  HMW_SNAPSHOT_FILE="$file" HMW_PENDING="$HMW_RESTORE_PENDING_SECONDS" python3 -c 'import json, os, time
file = os.environ["HMW_SNAPSHOT_FILE"]
data = json.load(open(file))
data["restore_pending_until"] = time.time() + float(os.environ["HMW_PENDING"])
tmp = "%s.tmp.%d" % (file, os.getpid())
with open(tmp, "w") as fh:
    json.dump(data, fh, indent=1)
os.replace(tmp, file)' 2>/dev/null || :
}

# A recorded loop is alive only if its pid still has the recorded start time
# AND still runs the loop (marker on its command line): a recycled pid never
# suppresses the refresher.
hmw_snapshot_loop_alive() {
  local pid start token now
  read -r pid start token 2>/dev/null < "$1" || return 1
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  [ -n "$start" ] && [ -n "$token" ] || return 1
  now="$(hmw_proc_start_time "$pid")" || return 1
  [ "$now" = "$start" ] || return 1
  ps -o args= -p "$pid" 2>/dev/null | grep -Fq -- "$HMW_LOOP_MARKER"
}

# Caller holds the restore lock, so check-and-start cannot race another hmw.
# One refresher per session keeps the snapshot fresh before an unplanned
# reboot; it exits when the Herdr server stops or a newer loop replaces its
# token. No service unit needed.
hmw_snapshot_loop_ensure() {
  local pidfile pid start token
  [ "$HMW_SNAPSHOT_INTERVAL" != "0" ] || return 0
  # Verify runs are probes that stop the server they started: never snapshot.
  [ "$VERIFY" != "1" ] || return 0
  [ -n "$HMW_RESTORE_LOCK" ] || return 0
  mkdir -p "$HMW_STATE_DIR" 2>/dev/null || return 0
  pidfile="$HMW_STATE_DIR/$SESSION.snapshot-loop.pid"
  if hmw_snapshot_loop_alive "$pidfile"; then
    return 0
  fi
  token="$(od -An -N8 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')"
  [ -n "$token" ] || token="$$.$RANDOM.$RANDOM"
  hmw_detached env HMW_LOOP_TOKEN="$token" HERDR_SESSION="$SESSION" bash "${BASH_SOURCE[0]}" "$HMW_LOOP_MARKER"
  pid=$!
  start="$(hmw_proc_start_time "$pid")" || start=unknown
  printf '%s %s %s\n' "$pid" "$start" "$token" >"$pidfile.tmp.$$" 2>/dev/null &&
    mv -f "$pidfile.tmp.$$" "$pidfile" 2>/dev/null || :
}

hmw_snapshot_spawn_once() {
  [ "$HMW_SNAPSHOT_INTERVAL" != "0" ] || return 0
  [ "$VERIFY" != "1" ] || return 0
  hmw_detached env HMW_SNAPSHOT=1 HERDR_SESSION="$SESSION" bash "${BASH_SOURCE[0]}"
}

hmw_snapshot_loop() {
  local pidfile="$HMW_STATE_DIR/$SESSION.snapshot-loop.pid" pid start token
  while :; do
    sleep "$HMW_SNAPSHOT_INTERVAL" || return 0
    herdr_status_running || return 0
    read -r pid start token 2>/dev/null < "$pidfile" || return 0
    [ "$token" = "${HMW_LOOP_TOKEN:-}" ] || return 0
    hmw_snapshot_once || :
  done
}

# Herdr-native restore launch: `agent start` refuses a pane that is not at its
# interactive shell prompt and succeeds only once Hermes is detected ready in
# that same terminal, so nothing is ever typed into a pane. It runs in the
# pane's existing shell (which already carries NO_TMUX from the saved layout),
# so no `env NO_TMUX=1` wrapper is needed. NAME is Herdr's agent display name
# ([a-z][a-z0-9_-]{0,31}, unique among live agents); it does not touch the
# pane label, so labelled slots keep "Hn" and use "hn" as the agent name.
herdr_restore_agent_start() {
  local target=$1 label=$2 name timeout_ms
  shift 2
  if [ "$label" != - ]; then
    name="$(printf '%s' "$label" | tr 'A-Z' 'a-z')"
  else
    name="hmw-$(printf '%s' "$target" | tr 'A-Z:' 'a-z-')"
  fi
  case "$name" in [a-z]*) ;; *) name="hmw-$name" ;; esac
  case "$name" in *[!a-z0-9_-]*) name="hmw-$(printf '%s' "$target" | tr -c 'a-zA-Z0-9' '-' | tr 'A-Z' 'a-z')" ;; esac
  name="${name:0:32}"
  timeout_ms=$(( ${HMW_HERDR_READY_TIMEOUT:-30} * 1000 ))
  [ "$timeout_ms" -le 300000 ] || timeout_ms=300000
  [ "$timeout_ms" -ge 1000 ] || timeout_ms=1000
  "${HERDR[@]}" agent start "$name" --kind hermes --pane "$target" --timeout "$timeout_ms" -- "$@" >/dev/null 2>&1
}

hmw_id_listed() {
  [ -n "$2" ] && printf '%s\n' "$2" | grep -Fqx -- "$1"
}

# True only when the pane's ONLY foreground job is its own login shell (pid ==
# shell_pid == foreground group, argv[0] a known shell): Hermes exited and
# hermes-pane fell through to `exec $SHELL`. Anything else running there
# (an editor, a build, a half-typed command's child) fails closed.
herdr_pane_idle_shell() {
  local pane_id=$1 process_json
  process_json="$("${HERDR[@]}" pane process-info --pane "$pane_id" 2>/dev/null)" || return
  HMW_PROCESS_JSON="$process_json" python3 -c 'import json, os, sys
try:
    p = json.loads(os.environ["HMW_PROCESS_JSON"])["result"]["process_info"]
    if p["pane_id"] != sys.argv[1]:
        raise ValueError
    jobs = p["foreground_processes"]
    shell = p["shell_pid"]
    if type(shell) is not int or shell <= 0 or p["foreground_process_group_id"] != shell:
        raise ValueError
    if not isinstance(jobs, list) or len(jobs) != 1 or not isinstance(jobs[0], dict):
        raise ValueError
    job = jobs[0]
    argv = job.get("argv")
    if job.get("pid") != shell or not isinstance(argv, list) or not argv or not isinstance(argv[0], str):
        raise ValueError
    if os.path.basename(argv[0]).lstrip("-") not in ("bash", "zsh", "sh", "dash", "fish", "ksh"):
        raise ValueError
except (ValueError, KeyError, TypeError, AttributeError):
    raise SystemExit(1)' "$pane_id"
}

# Server already running, but a requested HN slot holds only its idle shell
# (Hermes exited: /exit, update restart, crash). Relaunch Hermes in that SAME
# pane — never a duplicate — resuming its pane:<label> session unless that
# session is already open in another live pane. Runs under the restore lock.
# Herdr's `agent start --pane` itself refuses a pane not at its prompt.
herdr_relaunch_idle_slots() {
  local number label target sid live_map reserved="" unknown=0 mapped=0
  number=1
  while [ "$number" -le "$REQUEST_COUNT" ]; do
    label="$(label_for "$number")"
    number=$((number + 1))
    target="$(herdr_target_for_label "$label")" || continue
    # The live process check is authoritative: Herdr can retain a hermes
    # identity on a pane after Hermes exits.
    herdr_pane_idle_shell "$target" || continue
    # Verify never launches into a server it did not start (the agent would
    # outlive the probe): report the plan; readiness below stays honest.
    if [ "$VERIFY" = "1" ]; then
      printf 'HMW_VERIFY relaunch=%s pane=%s\n' "$label" "$target"
      continue
    fi
    if [ "$mapped" -eq 0 ]; then
      mapped=1
      if live_map="$(hmw_snapshot_panes print)"; then
        reserved="$(printf '%s\n' "$live_map" | awk -F '\t' 'NF == 2 { print $2 }')"
      else
        unknown=1
      fi
    fi
    if [ "$unknown" -eq 1 ] || ! sid="$(hermes-pane --print-resume-id "$label" 2>/dev/null)"; then
      sid="~"
    fi
    case "$sid" in ''|*[!A-Za-z0-9_.:-]*) sid="~" ;; esac
    if [ "$sid" != "~" ] && hmw_id_listed "$sid" "$reserved"; then
      hmw_note "starting a fresh session in $target ($label): its last session is open elsewhere"
      sid="~"
    fi
    if [ "$sid" = "~" ]; then
      set -- chat --source "pane:$label"
      hmw_note "Hermes had exited in $target ($label); starting it again"
    else
      reserved+=$'\n'"$sid"
      set -- chat --source "pane:$label" --resume "$sid"
      hmw_note "Hermes had exited in $target ($label); resuming session $sid"
    fi
    if ! herdr_restore_agent_start "$target" "$label" "$@"; then
      hmw_note "could not restart Hermes in $target ($label): Herdr refused (not at its shell prompt, or not ready in time)"
    fi
  done
  return 0
}

herdr_relaunch_restored_panes() {
  local record label target resume_map live_map pane_id sid plan="" fallbacks="" labelled_ids="" reserved="" unknown=0

  # Only called when this run started the stopped server, under the restore
  # lock (held through launch and the pause marker, so no snapshot can
  # interleave). Resume each pane's snapshotted conversation; labelled slots
  # without one fall back to their pane:<label> session, pinned here. Never
  # close panes: layout persistence is a feature Dan wants.
  hmw_snapshot_pin_pre_restore
  resume_map="$(hmw_snapshot_resume_map)" || resume_map=""
  # Reserved = sessions already running in live panes (fresh lease mapping,
  # the snapshot's own validated logic) + snapshot ids of live panes + every
  # id planned so far. Unknowable live state: resume nothing, start fresh.
  if ! live_map="$(hmw_snapshot_panes print)"; then
    hmw_note "could not map live panes to sessions; restored panes start fresh"
    unknown=1
  fi
  reserved="$(printf '%s\n' "$live_map" | awk -F '\t' 'NF == 2 { print $2 }')"
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    pane_id=${record%%$'\t'*}
    if herdr_pane_has_hermes "$pane_id"; then
      reserved+=$'\n'"${record#*$'\t'}"
    fi
  done <<< "$resume_map"
  # 1. Plan mapped launches first: pane<TAB>label (- if none)<TAB>session
  # (~ = fresh). No empty fields: read collapses adjacent tabs.
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    label=${record%%$'\t'*}
    target=${record#*$'\t'}
    labelled_ids+="$target"$'\n'
    herdr_pane_has_hermes "$target" && continue
    sid="$(printf '%s\n' "$resume_map" | awk -F '\t' -v p="$target" '$1 == p { print $2; exit }')"
    if [ -z "$sid" ]; then
      fallbacks+="$target"$'\t'"$label"$'\n'
    elif [ "$unknown" -eq 1 ] || hmw_id_listed "$sid" "$reserved"; then
      hmw_note "starting a fresh session in restored pane $target ($label): session $sid is already running elsewhere"
      plan+="$target"$'\t'"$label"$'\t~\n'
    else
      reserved+=$'\n'"$sid"
      plan+="$target"$'\t'"$label"$'\t'"$sid"$'\n'
    fi
  done <<< "$HERDR_LABEL_TARGETS"
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    pane_id=${record%%$'\t'*}
    sid=${record#*$'\t'}
    printf '%s' "$labelled_ids" | grep -Fqx -- "$pane_id" && continue
    herdr_pane_has_hermes "$pane_id" && continue
    if [ "$unknown" -eq 1 ] || hmw_id_listed "$sid" "$reserved"; then
      hmw_note "skipping restored pane $pane_id: session $sid is already running elsewhere"
      continue
    fi
    reserved+=$'\n'"$sid"
    plan+="$pane_id"$'\t-\t'"$sid"$'\n'
  done <<< "$resume_map"
  # 2. Labelled fallbacks: pin the pane:<label> lookup now (no second lookup
  # at launch). A failed lookup or an id already reserved starts fresh.
  while IFS=$'\t' read -r target label; do
    [ -n "$target" ] || continue
    if [ "$unknown" -eq 1 ] || ! sid="$(hermes-pane --print-resume-id "$label" 2>/dev/null)"; then
      sid="~"
    fi
    case "$sid" in ''|*[!A-Za-z0-9_.:-]*) sid="~" ;; esac
    if [ "$sid" != "~" ] && hmw_id_listed "$sid" "$reserved"; then
      hmw_note "starting a fresh session in restored pane $target ($label): its last session is resumed elsewhere"
      sid="~"
    fi
    [ "$sid" = "~" ] || reserved+=$'\n'"$sid"
    plan+="$target"$'\t'"$label"$'\t'"$sid"$'\n'
  done <<< "$fallbacks"
  # 3. Launch through Herdr; a pane not at its prompt is skipped, never typed into.
  while IFS=$'\t' read -r target label sid; do
    [ -n "$target" ] || continue
    if [ "$label" = - ]; then
      set -- chat --resume "$sid"
      hmw_note "resuming session $sid in restored pane $target"
    elif [ "$sid" = "~" ]; then
      set -- chat --source "pane:$label"
      hmw_note "starting Hermes in restored pane $target ($label)"
    else
      set -- chat --source "pane:$label" --resume "$sid"
      hmw_note "resuming session $sid in restored pane $target ($label)"
    fi
    if ! herdr_restore_agent_start "$target" "$label" "$@"; then
      hmw_note "skipping restored pane $target: Herdr could not start Hermes there (not at its shell prompt, or not ready in time)"
    fi
  done <<< "$plan"
  [ -z "$resume_map" ] || hmw_mark_restore_pending
}

start_herdr_agent_in_new_pane() {
  local label=$1 anchor pane_json pane_id

  anchor="$(herdr_target_for_label H1 2>/dev/null || true)"
  if [ -n "$anchor" ]; then
    # Herdr inherits SSH_CONNECTION from the remote hmw process. Without this
    # pane-local opt-out, the new interactive shell's rc immediately attaches
    # tmux main; pane run would then type `hermes-pane HN` into that shared TUI.
    pane_json="$("${HERDR[@]}" pane split "$anchor" --direction right --no-focus --env NO_TMUX=1)" || return
  else
    pane_json="$("${HERDR[@]}" workspace create --cwd "$HOME" --label ws --no-focus --env NO_TMUX=1)" || return
  fi
  pane_id="$(printf '%s' "$pane_json" | herdr_json_pane_id)" || return
  "${HERDR[@]}" pane rename "$pane_id" "$label" >/dev/null || return
  "${HERDR[@]}" pane run "$pane_id" "hermes-pane $label" >/dev/null || return
  if ! herdr_wait_for_agent_pane "$pane_id" "$label"; then
    hmw_errf "hermes-workspace: Hermes did not become ready in pane %s for %s in session '%s'\n" "$pane_id" "$label" "$SESSION"
    return 1
  fi
  if [ -n "$HERDR_NAMES" ]; then
    HERDR_NAMES+=$'\n'
  fi
  HERDR_NAMES+="$label"
  if [ -n "$HERDR_LABEL_TARGETS" ]; then
    HERDR_LABEL_TARGETS+=$'\n'
  fi
  HERDR_LABEL_TARGETS+="$label"$'\t'"$pane_id"
}

ensure_herdr_workspace() {
  local number label added legacy_start target

  if ! command -v python3 >/dev/null 2>&1; then
    hmw_errf 'hermes-workspace: Python 3 is required for the Herdr backend; install python3 and retry.\n'
    return 1
  fi
  if ! command -v herdr >/dev/null 2>&1; then
    hmw_errf "hermes-workspace: 'herdr' not on PATH — install Herdr before using the Herdr backend.\n"
    return 1
  fi
  if ! command -v hermes-pane >/dev/null 2>&1; then
    hmw_errf "hermes-workspace: 'hermes-pane' not on PATH — run hermes-reload (hmr) to install it.\n"
    return 1
  fi

  HERDR=(herdr --session "$SESSION")
  ensure_herdr_server || return
  herdr_slot_inventory || return
  if [ "$HMW_STARTED_SERVER" -eq 1 ]; then
    herdr_relaunch_restored_panes || return
  fi
  legacy_start=1
  if herdr_uses_existing_pane_start; then
    legacy_start=0
  fi

  added=0
  number=1
  while [ "$number" -le "$REQUEST_COUNT" ]; do
    label="$(label_for "$number")"
    if ! herdr_has_label "$label"; then
      if [ "$legacy_start" -eq 0 ]; then
        start_herdr_agent_in_new_pane "$label" || return
      elif ! "${HERDR[@]}" agent start "$label" --split right --no-focus -- hermes-pane "$label" >/dev/null; then
        if ! herdr_slot_inventory; then
          hmw_errf "hermes-workspace: Herdr agent start failed for %s in session '%s', and inventory refresh could not confirm a competing launch; inspect Herdr server output and retry\n" "$label" "$SESSION"
          return 1
        fi
        if ! herdr_has_label "$label"; then
          hmw_errf "hermes-workspace: Herdr agent start failed for %s in session '%s', and %s is still absent after inventory refresh; inspect Herdr server output and retry\n" "$label" "$SESSION" "$label"
          return 1
        fi
      fi
      added=1
    fi
    number=$((number + 1))
  done

  if [ "$added" -eq 1 ]; then
    herdr_slot_inventory || return
  fi
  herdr_resolve_requested_slots || return
  if [ "$HMW_STARTED_SERVER" -eq 0 ]; then
    HMW_VERIFY_RELAUNCH=""
    herdr_relaunch_idle_slots
  fi
  number=1
  while [ "$number" -le "$REQUEST_COUNT" ]; do
    label="$(label_for "$number")"
    target="$(herdr_target_for_label "$label")" || return
    if ! herdr_wait_for_agent_pane "$target" "$label" "${HMW_HERDR_READY_TIMEOUT:-30}"; then
      hmw_errf "hermes-workspace: Hermes is not ready in existing pane %s for %s in session '%s'; inspect the pane and relaunch Hermes there (no duplicate was created)\n" "$target" "$label" "$SESSION"
      return 1
    fi
    number=$((number + 1))
  done
  herdr_focus_label H1 || return
  # Hold the restore lock until restored panes are ready; a verify run keeps it
  # through its server-stop cleanup (released by the EXIT trap).
  if [ "$VERIFY" != "1" ]; then
    hmw_snapshot_loop_ensure
    herdr_restore_lock_release
    hmw_snapshot_spawn_once
  fi
}

verify_herdr_workspace() {
  verify_header herdr "$SESSION"
  [ -z "$HERDR_INVENTORY" ] || printf '%s\n' "$HERDR_INVENTORY"
  printf 'HMW_VERIFY inventory-end\n'
}

attach_herdr_workspace() {
  exec "${HERDR[@]}"
}

case "$BACKEND" in
  tmux) ;;
  herdr) ;;
  *) usage_error "unsupported backend: $BACKEND" ;;
esac

SESSION=ws
if [ "$BACKEND" = "herdr" ]; then
  SESSION="${HERDR_SESSION-ws}"
  [ -n "$SESSION" ] || usage_error 'HERDR_SESSION must not be empty'
fi

if [ "$BACKEND" = "herdr" ] && { [ "${HMW_SNAPSHOT:-0}" = "1" ] || [ "${1:-}" = "$HMW_LOOP_MARKER" ]; }; then
  HERDR=(herdr --session "$SESSION")
  if [ "${1:-}" = "$HMW_LOOP_MARKER" ]; then
    hmw_snapshot_loop
    exit 0
  fi
  hmw_snapshot_once
  exit $?
fi

if [ "${HMW_REMOTE:-0}" = "1" ]; then
  # Fresh error record per remote run, so the origin never re-prints a stale one.
  rm -f "$HMW_ERR_FILE" 2>/dev/null || :
fi
parse_request "$@"
if [ "${HMW_REMOTE:-0}" != "1" ]; then
  resolve_default_target
  if [ -n "$REQUEST_HOST" ]; then
    resolve_ssh_target
    dispatch_remote
    exit $?
  fi
fi

case "$BACKEND" in
  tmux)
    ensure_tmux_workspace || exit $?
    if [ "$VERIFY" = "1" ]; then
      verify_tmux_workspace || exit $?
    else
      attach_tmux_workspace
    fi
    ;;
  herdr)
    if [ "$VERIFY" = "1" ]; then
      ensure_herdr_workspace && verify_herdr_workspace
      rc=$?
      herdr_verify_stop_owned_server || rc=1
      exit "$rc"
    else
      ensure_herdr_workspace || exit $?
      attach_herdr_workspace
    fi
    ;;
esac

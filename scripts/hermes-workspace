#!/usr/bin/env bash
# hermes-workspace (alias: hmw) — persistent H1..HN workspaces via Herdr or tmux.

set -uo pipefail

DEFAULT_COUNT=2
DEFAULT_HOST="${HMW_DEFAULT_HOST:-h-do1}"
BACKEND="${HMW_BACKEND:-herdr}"
if [ -n "${HMW_VERIFY+x}" ]; then
  VERIFY=$HMW_VERIFY
elif [ "$BACKEND" = "herdr" ] && [ "${HMW_HERDR_VERIFY:-0}" = "1" ]; then
  VERIFY=1
else
  VERIFY=0
fi

usage_error() {
  printf 'hermes-workspace: %s\n' "$1" >&2
  exit 2
}

parse_request() {
  local arg

  REQUEST_HOST=""
  REQUEST_COUNT=""
  HOST_EXPLICIT=0

  if [ "${HMW_REMOTE:-0}" = "1" ]; then
    [ "$#" -eq 1 ] || usage_error 'remote re-entry requires exactly one pane count'
    case "$1" in
      ''|*[!0-9]*) usage_error "pane count must be a positive decimal (got $1)" ;;
    esac
    [ "$1" -ge 1 ] || usage_error "pane count must be >= 1 (got $1)"
    REQUEST_COUNT="$1"
    return
  fi

  [ "$#" -le 2 ] || usage_error 'expected at most one host and one pane count'
  for arg in "$@"; do
    case "$arg" in
      '')
        usage_error 'arguments must not be empty'
        ;;
      -[0-9]* )
        usage_error "pane count must be a positive decimal (got $arg)"
        ;;
      -* )
        usage_error "unsupported option: $arg"
        ;;
      *[!0-9]*)
        [ -z "$REQUEST_HOST" ] || usage_error 'multiple hosts supplied'
        REQUEST_HOST="$arg"
        HOST_EXPLICIT=1
        ;;
      *)
        [ -z "$REQUEST_COUNT" ] || usage_error 'multiple pane counts supplied'
        REQUEST_COUNT="$arg"
        ;;
    esac
  done

  REQUEST_COUNT="${REQUEST_COUNT:-$DEFAULT_COUNT}"
  [ "$REQUEST_COUNT" -ge 1 ] || usage_error "pane count must be >= 1 (got $REQUEST_COUNT)"
}

resolve_default_target() {
  local default_bare here

  [ "$HOST_EXPLICIT" -eq 0 ] || return
  default_bare="${DEFAULT_HOST##*@}"
  default_bare="${default_bare%%.*}"
  here="$(hostname -s 2>/dev/null || hostname)"
  if [ "$here" != "$default_bare" ]; then
    REQUEST_HOST="$DEFAULT_HOST"
  fi
}

resolve_ssh_target() {
  local resolved

  case "$REQUEST_HOST" in
    *@*) SSH_TARGET="$REQUEST_HOST" ;;
    *)
      resolved=""
      if command -v hermes-host-resolve >/dev/null 2>&1; then
        resolved="$(hermes-host-resolve "$REQUEST_HOST" 2>/dev/null)"
      fi
      SSH_TARGET="${resolved:-$REQUEST_HOST}"
      ;;
  esac
}

shell_quote() {
  local value=$1
  value=${value//\'/\'\\\'\'}
  printf "'%s'" "$value"
}

dispatch_remote() {
  local payload remote_command ssh_status
  local ssh_keepalive_interval ssh_keepalive_count

  # shellcheck disable=SC2016
  payload='PATH="$HOME/.local/bin:$PATH"'
  payload+=" HMW_REMOTE=$(shell_quote 1)"
  payload+=" HMW_BACKEND=$(shell_quote "$BACKEND")"
  payload+=" HMW_VERIFY=$(shell_quote "$VERIFY")"
  if [ "$BACKEND" = "herdr" ]; then
    payload+=" HERDR_SESSION=$(shell_quote "$SESSION")"
  fi
  payload+=" hermes-workspace $(shell_quote "$REQUEST_COUNT")"
  remote_command="sh -c $(shell_quote "$payload")"
  ssh_keepalive_interval="${HMW_SERVER_ALIVE_INTERVAL:-60}"
  ssh_keepalive_count="${HMW_SERVER_ALIVE_COUNT_MAX:-3}"
  case "$ssh_keepalive_interval" in ''|*[!0-9]*) usage_error 'HMW_SERVER_ALIVE_INTERVAL must be a non-negative decimal' ;; esac
  case "$ssh_keepalive_count" in ''|*[!0-9]*) usage_error 'HMW_SERVER_ALIVE_COUNT_MAX must be a non-negative decimal' ;; esac

  if [ "$VERIFY" = "1" ]; then
    exec ssh -o "ServerAliveInterval=$ssh_keepalive_interval" -o "ServerAliveCountMax=$ssh_keepalive_count" "$SSH_TARGET" "$remote_command"
  else
    ssh -o "ServerAliveInterval=$ssh_keepalive_interval" -o "ServerAliveCountMax=$ssh_keepalive_count" -t "$SSH_TARGET" "$remote_command"
    ssh_status=$?
    # Herdr/Hermes enable Kitty keyboard + modifyOtherKeys on the OUTER local
    # terminal. A Broken pipe/SIGHUP skips their normal teardown, leaving the
    # local shell to receive raw CSI-u key reports. Heal locally after every
    # interactive Herdr SSH return while preserving ssh's real exit status.
    if [ "$BACKEND" = "herdr" ]; then
      if command -v hermes-terminal-reset >/dev/null 2>&1; then
        hermes-terminal-reset --no-clear
      else
        printf '\033[?1016l\033[?1015l\033[?1006l\033[?1003l\033[?1002l\033[?1000l\033[?9l\033[?1004l\033[<u\033[>4m\033[0m\033[?25h'
        stty sane 2>/dev/null || true
      fi
    fi
    return "$ssh_status"
  fi
}

label_for() {
  printf 'H%s\n' "$1"
}

command_for() {
  printf 'hermes-pane H%s\n' "$1"
}

local_short_hostname() {
  hostname -s 2>/dev/null || hostname
}

TMUX_SEPARATOR='__HMW_SEP__'
TMUX_SLOT_RECORDS=""
TMUX_INVENTORY=""

tmux_slots_clear() {
  TMUX_SLOT_RECORDS=""
}

tmux_slot_get() {
  local wanted=$1 record

  while IFS= read -r record; do
    [ -n "$record" ] || continue
    if [ "${record%%|*}" = "$wanted" ]; then
      printf '%s\n' "${record#*|}"
      return 0
    fi
  done <<EOF
$TMUX_SLOT_RECORDS
EOF
  return 1
}

tmux_slot_has() {
  tmux_slot_get "$1" >/dev/null 2>&1
}

tmux_slot_set() {
  local label=$1 pane_id=$2

  tmux_slot_has "$label" && return 0
  if [ -n "$TMUX_SLOT_RECORDS" ]; then
    TMUX_SLOT_RECORDS="$TMUX_SLOT_RECORDS
$label|$pane_id"
  else
    TMUX_SLOT_RECORDS="$label|$pane_id"
  fi
}

parse_tmux_inventory_line() {
  local line=$1 rest

  case "$line" in
    *"$TMUX_SEPARATOR"*"$TMUX_SEPARATOR"*) ;;
    *) return 1 ;;
  esac
  TMUX_PARSED_PANE_ID=${line%%"$TMUX_SEPARATOR"*}
  rest=${line#*"$TMUX_SEPARATOR"}
  TMUX_PARSED_LABEL=${rest%%"$TMUX_SEPARATOR"*}
  TMUX_PARSED_COMMAND=${rest#*"$TMUX_SEPARATOR"}
}

tmux_slot_inventory() {
  local line

  tmux_slots_clear
  if ! TMUX_INVENTORY="$(tmux list-panes -t ws:ws -F "#{pane_id}${TMUX_SEPARATOR}#{@hmw_label}${TMUX_SEPARATOR}#{pane_start_command}")"; then
    printf 'hermes-workspace: unable to inventory tmux workspace ws:ws\n' >&2
    return 1
  fi

  while IFS= read -r line; do
    parse_tmux_inventory_line "$line" || continue
    if [ -n "$TMUX_PARSED_LABEL" ]; then
      tmux_slot_set "$TMUX_PARSED_LABEL" "$TMUX_PARSED_PANE_ID"
    fi
  done <<EOF
$TMUX_INVENTORY
EOF
}

canonicalize_legacy_command() {
  local command=$1 canonical=$2 executable label
  local whole_single whole_double tokens_single tokens_double

  executable=${canonical%% *}
  label=${canonical#* }
  whole_single="'$canonical'"
  whole_double="\"$canonical\""
  tokens_single="'$executable' '$label'"
  tokens_double="\"$executable\" \"$label\""
  if [ "$command" != "$canonical" ] &&
     [ "$command" != "$whole_single" ] &&
     [ "$command" != "$whole_double" ] &&
     [ "$command" != "$tokens_single" ] &&
     [ "$command" != "$tokens_double" ]; then
    return 1
  fi
  printf '%s\n' "$canonical"
}

adopt_legacy_tmux_slots() {
  local number label canonical line normalized

  number=1
  while [ "$number" -le "$REQUEST_COUNT" ]; do
    label="$(label_for "$number")"
    canonical="$(command_for "$number")"
    if ! tmux_slot_has "$label"; then
      while IFS= read -r line; do
        parse_tmux_inventory_line "$line" || continue
        [ -z "$TMUX_PARSED_LABEL" ] || continue
        if normalized="$(canonicalize_legacy_command "$TMUX_PARSED_COMMAND" "$canonical")" &&
           [ "$normalized" = "$canonical" ]; then
          tmux set-option -p -t "$TMUX_PARSED_PANE_ID" @hmw_label "$label"
          tmux_slot_set "$label" "$TMUX_PARSED_PANE_ID"
          break
        fi
      done <<EOF
$TMUX_INVENTORY
EOF
    fi
    number=$((number + 1))
  done
}

ensure_tmux_workspace() {
  local number label command pane_id added

  if ! command -v hermes-pane >/dev/null 2>&1; then
    printf "hermes-workspace: 'hermes-pane' not on PATH — run hermes-reload (hmr) to install it.\n" >&2
    return 1
  fi

  if tmux has-session -t '=ws' 2>/dev/null; then
    tmux_slot_inventory || return
    adopt_legacy_tmux_slots || return
    added=0
    number=1
    while [ "$number" -le "$REQUEST_COUNT" ]; do
      label="$(label_for "$number")"
      command="$(command_for "$number")"
      if ! tmux_slot_has "$label"; then
        pane_id="$(tmux split-window -h -P -F '#{pane_id}' -t ws:ws "$command")" || return
        tmux set-option -p -t "$pane_id" @hmw_label "$label" || return
        tmux_slot_set "$label" "$pane_id"
        added=1
      fi
      number=$((number + 1))
    done
    if [ "$added" -eq 1 ]; then
      tmux select-layout -t ws:ws even-horizontal || return
    fi
  else
    label=H1
    command='hermes-pane H1'
    pane_id="$(tmux new-session -d -P -F '#{pane_id}' -s ws -n ws "$command")" || return
    tmux set-option -p -t "$pane_id" @hmw_label "$label" || return
    tmux_slots_clear
    tmux_slot_set H1 "$pane_id"
    number=2
    while [ "$number" -le "$REQUEST_COUNT" ]; do
      label="$(label_for "$number")"
      command="$(command_for "$number")"
      pane_id="$(tmux split-window -h -P -F '#{pane_id}' -t ws:ws "$command")" || return
      tmux set-option -p -t "$pane_id" @hmw_label "$label" || return
      tmux_slot_set "$label" "$pane_id"
      number=$((number + 1))
    done
    tmux select-layout -t ws:ws even-horizontal || return
  fi

  pane_id="$(tmux_slot_get H1)" || return
  tmux select-pane -t "$pane_id" || return
}

verify_header() {
  local backend=$1 session=$2 number

  printf 'HMW_VERIFY backend=%s\n' "$backend"
  printf 'HMW_VERIFY session=%s\n' "$session"
  printf 'HMW_VERIFY target=%s\n' "$(local_short_hostname)"
  printf 'HMW_VERIFY requested=%s\n' "$REQUEST_COUNT"
  number=1
  while [ "$number" -le "$REQUEST_COUNT" ]; do
    printf 'HMW_VERIFY slot=H%s command=hermes-pane H%s\n' "$number" "$number"
    number=$((number + 1))
  done
  printf 'HMW_VERIFY inventory-begin\n'
}

verify_tmux_workspace() {
  tmux_slot_inventory || return
  verify_header tmux ws:ws
  [ -z "$TMUX_INVENTORY" ] || printf '%s\n' "$TMUX_INVENTORY"
  printf 'HMW_VERIFY inventory-end\n'
}

attach_tmux_workspace() {
  if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t ws
  else
    exec tmux attach-session -t ws
  fi
}

HERDR_INVENTORY=""
HERDR_PANE_INVENTORY=""
HERDR_NAMES=""
HERDR_LABEL_TARGETS=""

herdr_status_running() {
  local status_json

  status_json="$("${HERDR[@]}" status server --json 2>/dev/null)" || return 1
  printf '%s' "$status_json" | python3 -c 'import json, sys
try:
    value = json.load(sys.stdin)
except (json.JSONDecodeError, UnicodeDecodeError):
    raise SystemExit(1)
raise SystemExit(0 if isinstance(value, dict) and value.get("status") == "running" and value.get("running") is True else 1)'
}

ensure_herdr_server() {
  local attempt socket

  attempt=1
  while [ "$attempt" -le 20 ]; do
    if herdr_status_running; then
      return 0
    fi
    if [ "$attempt" -eq 1 ]; then
      nohup "${HERDR[@]}" server >/dev/null 2>&1 &
    fi
    if [ "$attempt" -lt 20 ]; then
      sleep 0.1
    fi
    attempt=$((attempt + 1))
  done

  socket="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/sessions/$SESSION/herdr.sock"
  printf "hermes-workspace: Herdr session '%s' did not become ready at %s\n" "$SESSION" "$socket" >&2
  return 1
}

parse_herdr_inventory() {
  local parsed record name target

  if ! parsed="$(HERDR_AGENT_INVENTORY="$HERDR_INVENTORY" HERDR_PANE_INVENTORY="$HERDR_PANE_INVENTORY" python3 -c 'import json, os, sys
try:
    agent_value = json.loads(os.environ["HERDR_AGENT_INVENTORY"])
    pane_value = json.loads(os.environ["HERDR_PANE_INVENTORY"])
    agents = agent_value["result"]["agents"]
    panes = pane_value["result"]["panes"]
    if not isinstance(agents, list) or not isinstance(panes, list):
        raise TypeError
    records = {}
    kinds = {}
    def text(value):
        if not isinstance(value, str) or not value or any(ord(c) < 32 for c in value):
            raise TypeError
        return value
    def slot(name):
        return name.startswith("H") and name[1:].isdigit()
    def record(name, pane_id, kind):
        # Unmanaged display names may repeat; only H-slots reserve targets.
        if not slot(name):
            return
        if kind not in (None, "hermes"):
            raise TypeError
        old = records.get(name)
        if old and pane_id and old != pane_id:
            raise TypeError
        records[name] = pane_id or old or ""
    for agent in agents:
        if not isinstance(agent, dict):
            raise TypeError
        name = agent.get("name")
        pane_id = agent.get("pane_id")
        kind = agent.get("agent")
        if kind is not None:
            text(kind)
        if pane_id is not None:
            text(pane_id)
            kinds.setdefault(pane_id, []).append(kind)
        # Detected agents need not have a managed name (0.8.2).
        if name not in (None, ""):
            record(text(name), pane_id, kind)
        else:
            # An unnamed detection still needs both identity and location.
            text(pane_id)
            text(kind)
    seen_panes = set()
    for pane in panes:
        if not isinstance(pane, dict):
            raise TypeError
        pane_id = text(pane.get("pane_id"))
        if pane_id in seen_panes:
            raise TypeError
        seen_panes.add(pane_id)
        kind = pane.get("agent")
        if kind is not None:
            text(kind)
        kinds.setdefault(pane_id, []).append(kind)
        label = pane.get("label")
        if label in (None, ""):
            continue
        label = text(label)
        # A label reserves a slot, but is never proof of readiness.
        record(label, pane_id, kind)
    targets = set()
    for name, pane_id in records.items():
        if not slot(name) or not pane_id:
            continue
        if pane_id in targets or any(k not in (None, "hermes") for k in kinds.get(pane_id, [])):
            raise TypeError
        targets.add(pane_id)
except (json.JSONDecodeError, UnicodeDecodeError, KeyError, TypeError):
    raise SystemExit(1)
sys.stdout.write("\n".join(name + "\t" + target for name, target in records.items()))')"; then
    printf "hermes-workspace: malformed agent inventory for Herdr session '%s'; refusing to create agents\n" "$SESSION" >&2
    return 1
  fi

  HERDR_NAMES=""
  HERDR_LABEL_TARGETS=""
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    name=${record%%$'\t'*}
    target=${record#*$'\t'}
    if [ -n "$HERDR_NAMES" ]; then
      HERDR_NAMES+=$'\n'
    fi
    HERDR_NAMES+="$name"
    if [ -n "$target" ]; then
      if [ -n "$HERDR_LABEL_TARGETS" ]; then
        HERDR_LABEL_TARGETS+=$'\n'
      fi
      HERDR_LABEL_TARGETS+="$name"$'\t'"$target"
    fi
  done <<< "$parsed"
}

herdr_slot_inventory() {
  local attempt

  attempt=1
  while [ "$attempt" -le 3 ]; do
    if HERDR_INVENTORY="$("${HERDR[@]}" agent list)" && \
       HERDR_PANE_INVENTORY="$("${HERDR[@]}" pane list)"; then
      parse_herdr_inventory
      return
    fi
    if [ "$attempt" -lt 3 ]; then
      sleep 0.1
    fi
    attempt=$((attempt + 1))
  done
  printf "hermes-workspace: unable to inventory Herdr session '%s' after 3 attempts\n" "$SESSION" >&2
  return 1
}

herdr_has_label() {
  local wanted=$1 name

  while IFS= read -r name; do
    [ "$name" = "$wanted" ] && return 0
  done <<< "$HERDR_NAMES"
  return 1
}

herdr_target_for_label() {
  local wanted=$1 record name target

  while IFS= read -r record; do
    [ -n "$record" ] || continue
    name=${record%%$'\t'*}
    target=${record#*$'\t'}
    if [ "$name" = "$wanted" ] && [ -n "$target" ]; then
      printf '%s\n' "$target"
      return 0
    fi
  done <<< "$HERDR_LABEL_TARGETS"
  return 1
}

herdr_resolve_label() {
  local label=$1 target agent_json

  target="$(herdr_target_for_label "$label" 2>/dev/null || true)"
  if [ -n "$target" ]; then
    printf '%s\n' "$target"
    return 0
  fi
  # Older managed-agent inventories may expose only the name.
  agent_json="$("${HERDR[@]}" agent get "$label")" || return
  printf '%s' "$agent_json" | python3 -c 'import json, sys
try:
    agent = json.load(sys.stdin)["result"]["agent"]
    target = agent["pane_id"]
    if agent.get("name") != sys.argv[1] or agent.get("agent") not in (None, "hermes"):
        raise ValueError
    if not isinstance(target, str) or not target or any(ord(c) < 32 for c in target):
        raise ValueError
except (ValueError, KeyError, TypeError, AttributeError):
    raise SystemExit(1)
print(target)' "$label"
}

herdr_resolve_requested_slots() {
  local number label target resolved record old_target

  resolved=""
  number=1
  while [ "$number" -le "$REQUEST_COUNT" ]; do
    label="$(label_for "$number")"
    if ! herdr_has_label "$label"; then
      printf "hermes-workspace: Herdr session '%s' is missing expected agent %s after creation\n" "$SESSION" "$label" >&2
      return 1
    fi
    target="$(herdr_resolve_label "$label")" || return
    while IFS= read -r record; do
      old_target=${record#*$'\t'}
      if [ "$old_target" = "$target" ]; then
        printf "hermes-workspace: duplicate resolved target %s for %s in session '%s'\n" "$target" "$label" "$SESSION" >&2
        return 1
      fi
    done <<< "$resolved"
    resolved+="$label"$'\t'"$target"$'\n'
    number=$((number + 1))
  done
  # Name-only legacy records had no target during inventory parsing. Reconcile
  # every resolved target with ALL detections, including unmanaged/unnamed ones.
  if ! HMW_RESOLVED="$resolved" HERDR_AGENT_INVENTORY="$HERDR_INVENTORY" HERDR_PANE_INVENTORY="$HERDR_PANE_INVENTORY" python3 -c 'import json, os
try:
    targets = {record.split("\t")[1] for record in os.environ["HMW_RESOLVED"].splitlines()}
    agents = json.loads(os.environ["HERDR_AGENT_INVENTORY"])["result"]["agents"]
    panes = json.loads(os.environ["HERDR_PANE_INVENTORY"])["result"]["panes"]
    if any(item.get("pane_id") in targets and item.get("agent") not in (None, "hermes")
           for item in agents + panes):
        raise ValueError
except (ValueError, KeyError, TypeError, AttributeError, IndexError):
    raise SystemExit(1)'; then
    printf "hermes-workspace: conflicting inventory identity for resolved slots in Herdr session '%s'; refusing to reuse panes\n" "$SESSION" >&2
    return 1
  fi
  # Cache the complete checked mapping, including legacy agent-get results.
  # Readiness and focus must use these targets, not resolve them again.
  HERDR_LABEL_TARGETS="$resolved"
}

herdr_pane_matches_slot() {
  local pane_id=$1 label=$2 focused=${3:-0}

  HMW_PANE_INVENTORY="$HERDR_PANE_INVENTORY" python3 -c 'import json, os, sys
try:
    pane = json.load(sys.stdin)["result"]["pane"]
    pane_id, label, focused = sys.argv[1:]
    if pane["pane_id"] != pane_id or pane.get("agent") not in (None, "hermes"):
        raise ValueError
    current_label = pane.get("label")
    if current_label not in (None, "", label):
        raise ValueError
    # Legacy managed names can lack pane labels. A pane that reserved a slot
    # by label must still carry it, even if it was cleared since inventory.
    panes = json.loads(os.environ["HMW_PANE_INVENTORY"])["result"]["panes"]
    if any(p["pane_id"] == pane_id and p.get("label") == label for p in panes):
        if current_label != label:
            raise ValueError
    if focused == "1" and pane.get("focused") is not True:
        raise ValueError
except (ValueError, KeyError, TypeError, AttributeError):
    raise SystemExit(1)' "$pane_id" "$label" "$focused"
}

herdr_focus_label() {
  local label=$1 target status_json pane_json

  target="$(herdr_target_for_label "$label")" || return
  if ! "${HERDR[@]}" agent focus "$target" >/dev/null 2>&1; then
    # 0.8.2 agent focus rejects label-only panes; pane focus CLI is directional.
    # Use the exact-pane RPC, never workspace focus (which can leave H2 active).
    status_json="$("${HERDR[@]}" status server --json)" || return
    if ! printf '%s' "$status_json" | python3 -c 'import json, socket, sys
try:
    status = json.load(sys.stdin)
    if status.get("running") is not True or status.get("status") != "running":
        raise ValueError
    request = {"id": "hmw:focus", "method": "pane.focus", "params": {"pane_id": sys.argv[1]}}
    with socket.socket(socket.AF_UNIX) as sock:
        sock.settimeout(2)
        sock.connect(status["socket"])
        sock.sendall((json.dumps(request) + "\n").encode())
        with sock.makefile("rb") as stream:
            response = json.loads(stream.readline(1048576))
    if response.get("id") != request["id"] or "error" in response or "result" not in response:
        raise ValueError
    result = response["result"]
    pane = result["pane"]
    if result.get("type") != "pane_info" or pane["pane_id"] != sys.argv[1] or pane.get("focused") is not True:
        raise ValueError
except (OSError, ValueError, KeyError, TypeError, AttributeError):
    raise SystemExit(1)' "$target"; then
      printf "hermes-workspace: unable to focus exact pane %s for %s in session '%s'\n" "$target" "$label" "$SESSION" >&2
      return 1
    fi
  fi
  pane_json="$("${HERDR[@]}" pane get "$target")" || return
  if ! printf '%s' "$pane_json" | herdr_pane_matches_slot "$target" "$label" 1; then
    printf "hermes-workspace: exact focus of %s (%s) was not confirmed in session '%s'\n" "$label" "$target" "$SESSION" >&2
    return 1
  fi
}

herdr_uses_existing_pane_start() {
  "${HERDR[@]}" agent start --help >/dev/null 2>&1
}

herdr_json_pane_id() {
  python3 -c 'import json, sys
try:
    value = json.load(sys.stdin)
    result = value["result"]
    pane = result.get("pane") or result.get("root_pane")
    pane_id = pane["pane_id"]
    if not isinstance(pane_id, str) or not pane_id:
        raise TypeError
except (json.JSONDecodeError, UnicodeDecodeError, KeyError, TypeError, AttributeError):
    raise SystemExit(1)
sys.stdout.write(pane_id)'
}

herdr_agent_pane_ready() {
  local pane_id=$1 label=$2 pane_json visible process_json

  # Read only the current viewport, then check the live foreground job. A
  # retained composer in scrollback (or on screen after exit) is not liveness.
  visible="$("${HERDR[@]}" pane read "$pane_id" --source visible --format text 2>/dev/null)" || return
  process_json="$("${HERDR[@]}" pane process-info --pane "$pane_id" 2>/dev/null)" || return
  pane_json="$("${HERDR[@]}" pane get "$pane_id" 2>/dev/null)" || return
  printf '%s' "$pane_json" | herdr_pane_matches_slot "$pane_id" "$label" || return
  HMW_PANE_JSON="$pane_json" HMW_PROCESS_JSON="$process_json" HMW_VISIBLE="$visible" python3 -c 'import json, os, re, sys
try:
    pane = json.loads(os.environ["HMW_PANE_JSON"])["result"]["pane"]
    process = json.loads(os.environ["HMW_PROCESS_JSON"])["result"]["process_info"]
    if pane["pane_id"] != sys.argv[1] or process["pane_id"] != sys.argv[1]:
        raise ValueError
    kind = pane.get("agent")
    if kind not in (None, "hermes"):
        raise ValueError
    def pid(value):
        return type(value) is int and value > 0
    shell = process["shell_pid"]
    group = process["foreground_process_group_id"]
    jobs = process["foreground_processes"]
    if not pid(shell) or not pid(group) or not isinstance(jobs, list) or not jobs:
        raise ValueError
    def hermes_args(argv):
        executable = os.path.basename(argv[0])
        if executable == "hermes":
            return argv[1:]
        if not re.fullmatch(r"python(?:[0-9]+(?:\.[0-9]+)*)?", executable):
            return None
        # Parse interpreter options, not arbitrary later tokens that happen
        # to say hermes. In particular, -c code and other scripts are not it.
        i = 1
        while i < len(argv):
            arg = argv[i]
            if arg == "--":
                i += 1
                break
            if not arg.startswith("-"):
                break
            if arg == "--check-hash-based-pycs":
                if argv[i + 1:i + 2] not in (["default"], ["always"], ["never"]):
                    return None
                i += 2
                continue
            if arg == "-" or arg.startswith("--"):
                return None
            # Python groups short flags and allows attached m/W/X operands.
            # An operand consumes the rest of this token, never more flags.
            j = 1
            while j < len(arg):
                option = arg[j]
                if option in "mWX":
                    value = arg[j + 1:]
                    if not value:
                        i += 1
                        if i >= len(argv) or not argv[i]:
                            return None
                        value = argv[i]
                    if option == "m":
                        return argv[i + 1:] if value == "hermes_cli.main" else None
                    break
                # -i keeps Python alive at its REPL after Hermes exits. It
                # cannot prove live Hermes even when PID/identity are retained.
                if option not in "bBdEIOPqsSuvx":
                    return None
                j += 1
            i += 1
        if i < len(argv) and os.path.basename(argv[i]) == "hermes":
            return argv[i + 1:]
        return None

    def interactive_chat(args):
        if args is None:
            return False
        # Bare hermes defaults to chat, as do its profile/resume shortcuts.
        # Use known option arities, so values like --resume setup are not
        # confused with subcommands. Unknown modes fail closed. Query/oneshot
        # invocations are deliberately excluded (behavior varies by version).
        values = {"--profile", "-p", "--model", "-m", "--provider", "--reasoning",
                  "--toolsets", "-t", "--skills", "-s", "--resume", "-r", "--in"}
        switches = {"--tui", "--cli", "--dev", "--worktree", "-w", "--yolo",
                    "--pass-session-id", "--ignore-user-config", "--ignore-rules",
                    "--safe-mode", "--accept-hooks", "--no-restore-cwd"}
        chat_values = {"--source", "--max-turns", "--run-budget"}
        chat_switches = {"--checkpoints", "--create-if-missing", "--verbose", "-v"}
        chat = False
        i = 0
        while i < len(args):
            arg = args[i]
            if arg == "chat" and not chat:
                chat = True
                i += 1
                continue
            # -w can lead a group; -v is safe only after explicit chat.
            # Peel switches; the first value option owns the remaining suffix.
            # Profile -p is a launcher shortcut, not a parser group member.
            group_switches = "wv" if chat else "w"
            while len(arg) > 2 and arg[0] == "-" and arg[1] in group_switches:
                if arg[2] not in group_switches + "cmrst":
                    return False
                arg = "-" + arg[2:]
            option, equal, value = arg.partition("=")
            # Only known single-letter value options may consume a suffix.
            # Do not interpret arbitrary substrings or one-shot -q/-z as chat.
            if len(arg) > 2 and (arg[:2] in values or arg[:2] == "-c"):
                option, equal, value = arg[:2], "=", arg[2:]
                if value.startswith("="):
                    value = value[1:]
            if option in values or (chat and option in chat_values):
                if equal:
                    if not value:
                        return False
                else:
                    i += 1
                    if i >= len(args) or not args[i] or args[i].startswith("-"):
                        return False
            elif option in ("--continue", "-c"):
                if equal and not value:
                    return False
                if not equal and i + 1 < len(args) and not args[i + 1].startswith("-"):
                    i += 1
            elif not equal and (option in switches or (chat and option in chat_switches)):
                pass
            else:
                return False
            i += 1
        return True

    live = False
    for job in jobs:
        if not isinstance(job, dict) or not pid(job.get("pid")):
            raise ValueError
        argv = job.get("argv")
        if not isinstance(argv, list) or not argv or not all(isinstance(a, str) for a in argv):
            continue
        if interactive_chat(hermes_args(argv)):
            live = True
    if not live:
        raise ValueError
    # Semantic detection remains authoritative when present. For 0.8.2 panes
    # with no identity, require BOTH a live Hermes executable and its composer.
    visible = os.environ["HMW_VISIBLE"].lower()
    composer = "hermes" in visible and ("ask me anything" in visible or "type your message" in visible)
    if kind != "hermes" and not composer:
        raise ValueError
except (ValueError, KeyError, TypeError, AttributeError):
    raise SystemExit(1)' "$pane_id"
}

herdr_wait_for_agent_pane() {
  local pane_id=$1 label=$2 attempt

  attempt=1
  while [ "$attempt" -le 30 ]; do
    if herdr_agent_pane_ready "$pane_id" "$label"; then
      return 0
    fi
    [ "$attempt" -eq 30 ] || sleep 0.1
    attempt=$((attempt + 1))
  done
  return 1
}

start_herdr_agent_in_new_pane() {
  local label=$1 anchor pane_json pane_id

  anchor="$(herdr_target_for_label H1 2>/dev/null || true)"
  if [ -n "$anchor" ]; then
    # Herdr inherits SSH_CONNECTION from the remote hmw process. Without this
    # pane-local opt-out, the new interactive shell's rc immediately attaches
    # tmux main; pane run would then type `hermes-pane HN` into that shared TUI.
    pane_json="$("${HERDR[@]}" pane split "$anchor" --direction right --no-focus --env NO_TMUX=1)" || return
  else
    pane_json="$("${HERDR[@]}" workspace create --cwd "$HOME" --label ws --no-focus --env NO_TMUX=1)" || return
  fi
  pane_id="$(printf '%s' "$pane_json" | herdr_json_pane_id)" || return
  "${HERDR[@]}" pane rename "$pane_id" "$label" >/dev/null || return
  "${HERDR[@]}" pane run "$pane_id" "hermes-pane $label" >/dev/null || return
  if ! herdr_wait_for_agent_pane "$pane_id" "$label"; then
    printf "hermes-workspace: Hermes did not become ready in pane %s for %s in session '%s'\n" "$pane_id" "$label" "$SESSION" >&2
    return 1
  fi
  if [ -n "$HERDR_NAMES" ]; then
    HERDR_NAMES+=$'\n'
  fi
  HERDR_NAMES+="$label"
  if [ -n "$HERDR_LABEL_TARGETS" ]; then
    HERDR_LABEL_TARGETS+=$'\n'
  fi
  HERDR_LABEL_TARGETS+="$label"$'\t'"$pane_id"
}

ensure_herdr_workspace() {
  local number label added legacy_start target

  if ! command -v python3 >/dev/null 2>&1; then
    printf 'hermes-workspace: Python 3 is required for the Herdr backend; install python3 and retry.\n' >&2
    return 1
  fi
  if ! command -v herdr >/dev/null 2>&1; then
    printf "hermes-workspace: 'herdr' not on PATH — install Herdr before using the Herdr backend.\n" >&2
    return 1
  fi
  if ! command -v hermes-pane >/dev/null 2>&1; then
    printf "hermes-workspace: 'hermes-pane' not on PATH — run hermes-reload (hmr) to install it.\n" >&2
    return 1
  fi

  HERDR=(herdr --session "$SESSION")
  ensure_herdr_server || return
  herdr_slot_inventory || return
  legacy_start=1
  if herdr_uses_existing_pane_start; then
    legacy_start=0
  fi

  added=0
  number=1
  while [ "$number" -le "$REQUEST_COUNT" ]; do
    label="$(label_for "$number")"
    if ! herdr_has_label "$label"; then
      if [ "$legacy_start" -eq 0 ]; then
        start_herdr_agent_in_new_pane "$label" || return
      elif ! "${HERDR[@]}" agent start "$label" --split right --no-focus -- hermes-pane "$label" >/dev/null; then
        if ! herdr_slot_inventory; then
          printf "hermes-workspace: Herdr agent start failed for %s in session '%s', and inventory refresh could not confirm a competing launch; inspect Herdr server output and retry\n" "$label" "$SESSION" >&2
          return 1
        fi
        if ! herdr_has_label "$label"; then
          printf "hermes-workspace: Herdr agent start failed for %s in session '%s', and %s is still absent after inventory refresh; inspect Herdr server output and retry\n" "$label" "$SESSION" "$label" >&2
          return 1
        fi
      fi
      added=1
    fi
    number=$((number + 1))
  done

  if [ "$added" -eq 1 ]; then
    herdr_slot_inventory || return
  fi
  herdr_resolve_requested_slots || return
  number=1
  while [ "$number" -le "$REQUEST_COUNT" ]; do
    label="$(label_for "$number")"
    target="$(herdr_target_for_label "$label")" || return
    if ! herdr_wait_for_agent_pane "$target" "$label"; then
      printf "hermes-workspace: Hermes is not ready in existing pane %s for %s in session '%s'; inspect the pane and relaunch Hermes there (no duplicate was created)\n" "$target" "$label" "$SESSION" >&2
      return 1
    fi
    number=$((number + 1))
  done
  herdr_focus_label H1 || return
}

verify_herdr_workspace() {
  verify_header herdr "$SESSION"
  [ -z "$HERDR_INVENTORY" ] || printf '%s\n' "$HERDR_INVENTORY"
  printf 'HMW_VERIFY inventory-end\n'
}

attach_herdr_workspace() {
  exec "${HERDR[@]}"
}

case "$BACKEND" in
  tmux) ;;
  herdr) ;;
  *) usage_error "unsupported backend: $BACKEND" ;;
esac

SESSION=ws
if [ "$BACKEND" = "herdr" ]; then
  SESSION="${HERDR_SESSION-ws}"
  [ -n "$SESSION" ] || usage_error 'HERDR_SESSION must not be empty'
fi

parse_request "$@"
if [ "${HMW_REMOTE:-0}" != "1" ]; then
  resolve_default_target
  if [ -n "$REQUEST_HOST" ]; then
    resolve_ssh_target
    dispatch_remote
    exit $?
  fi
fi

case "$BACKEND" in
  tmux)
    ensure_tmux_workspace || exit $?
    if [ "$VERIFY" = "1" ]; then
      verify_tmux_workspace || exit $?
    else
      attach_tmux_workspace
    fi
    ;;
  herdr)
    ensure_herdr_workspace || exit $?
    if [ "$VERIFY" = "1" ]; then
      verify_herdr_workspace || exit $?
    else
      attach_herdr_workspace
    fi
    ;;
esac

#!/bin/bash
# hermes-desktop-carry-sync — keep this Mac's Hermes checkout on the fleet's carried
# Desktop patch (the gateway switcher, upstream PR #125267) until upstream merges it.
#
# GIT ONLY. It never rebuilds Desktop, never installs dependencies and never restarts
# anything. Desktop's bundle-skew check sees newer desktop code in the checkout, and the
# next normal update (`hermes update`, or Desktop's Update) rebuilds the app from it.
#
# How the carry works:
#   * The checkout is parked on local branch carry/desktop-switcher with
#     updates.parked_branch_strategy=update_in_place, so `hermes update` merges
#     origin/main into it and rebuilds Desktop (native Hermes carry mode).
#   * Fork branch fleet/desktop-switcher holds the carry commits plus centrally resolved
#     merges of upstream main. This job merges it into the local branch only when needed:
#       - adoption (on main), or new carry commits: only once every upstream commit the
#         fleet branch contains is already in HEAD, so the merge brings in carry changes
#         only (otherwise held `update_first`: the next normal update moves HEAD forward);
#       - upstream main conflicts with the local branch (the update would stall): the
#         fleet branch carries the resolution. This brings upstream code in, so it holds
#         (`needs_full_update`) if the merge would change a Python dependency manifest
#         (running processes import Python; JS deps are only used by the normal update's
#         rebuild, which installs them first).
#   * Retirement: when merging the fleet branch into upstream main would change nothing
#     under apps/desktop (true after a merge or a squash merge upstream, regardless of
#     whether the fleet branch has caught up), the job sets the strategy back to
#     `switch`; the next update returns the checkout to main.
#
# Contract for the fleet-branch maintainer: merge upstream (never rebase/force-push),
# never delete the branch; after upstream merges the PR, keep merging main into it.
#
# Concurrency: while it changes the checkout it holds Hermes's own update marker
# ($HERMES_HOME/.hermes-update-in-progress, "pid\nepoch\n", shared by hermes update,
# Desktop and the installer), so no updater starts mid-merge; it holds when one runs.
#
# Never touches: a merge/rebase/cherry-pick/revert/bisect in progress, a branch other
# than main/carry, a detached HEAD, a non-official origin or any `upstream` remote
# (Hermes fork mode). Local edits in files the merge doesn't touch are left alone; git
# refuses a merge that would overwrite one, and that is reported as merge_refused.
# Every run writes one line to $STATE/sync.log and key=value lines to $STATE/last.
# Exit 0 = ok/nothing to do, 3 = held (checkout content unchanged), 1 = error.
# bash 3.2-safe (macOS /bin/bash).
set -u
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH GIT_TERMINAL_PROMPT=0

HH="${HERMES_HOME:-$HOME/.hermes}"
REPO="${HERMES_CARRY_REPO:-$HH/hermes-agent}"
FLEET_URL="${HERMES_CARRY_URL:-https://github.com/dwhly/hermes-agent.git}"
FLEET_BRANCH="${HERMES_CARRY_FLEET_BRANCH:-fleet/desktop-switcher}"
LOCAL_BRANCH="carry/desktop-switcher"
FLEET_REF="refs/fleet/desktop-switcher"
STATE="$HH/desktop-carry"
LOCK="$STATE/lock"
MARKER="$HH/.hermes-update-in-progress"
MARKER_MAX_AGE=1200   # = UPDATE_MARKER_MAX_AGE_SECONDS in hermes_cli/update_lock.py
OFFICIAL_RE='^(https://github\.com/|git@github\.com:|ssh://git@github\.com/)NousResearch/hermes-agent(\.git)?/?$'

mkdir -p "$STATE"
OWN_MARKER=0
BUSY=""
MERGE_FAIL=""

g() { git -C "$REPO" "$@"; }
gfetch() {
  git -C "$REPO" -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 \
    -c core.sshCommand='ssh -o BatchMode=yes -o ConnectTimeout=30 -o ServerAliveInterval=15 -o ServerAliveCountMax=4' \
    fetch --no-tags --quiet "$@"
}

release_marker() {
  if [ "$OWN_MARKER" = 1 ] && [ "$(head -n 1 "$MARKER" 2>/dev/null)" = "$$" ]; then
    rm -f "$MARKER"
  fi
  OWN_MARKER=0
}

finish() { # finish <result> <reason> <exit>
  local head now
  release_marker
  head="$(g rev-parse --short=10 HEAD 2>/dev/null || echo none)"
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '%s result=%s reason=%s head=%s\n' "$now" "$1" "$2" "$head" >>"$STATE/sync.log"
  printf 'result=%s\nreason=%s\nhead=%s\nat=%s\n' "$1" "$2" "$head" "$now" >"$STATE/last.tmp" &&
    mv -f "$STATE/last.tmp" "$STATE/last"
  echo "desktop-carry: $1 ($2) head=$head"
  exit "$3"
}

# Single sync instance. mkdir is atomic; a lock older than 1 h is from a killed run.
if ! mkdir "$LOCK" 2>/dev/null; then
  if [ -n "$(find "$LOCK" -maxdepth 0 -mmin +60 2>/dev/null)" ]; then
    rmdir "$LOCK" 2>/dev/null; mkdir "$LOCK" 2>/dev/null || finish held lock_busy 3
  else
    finish held lock_busy 3
  fi
fi
trap 'release_marker; rmdir "$LOCK" 2>/dev/null' EXIT

update_live() { # another live updater holds Hermes's update marker
  local pid started now
  [ -f "$MARKER" ] || return 1
  pid="$(sed -n 1p "$MARKER" 2>/dev/null | tr -d '[:space:]')"
  started="$(sed -n 2p "$MARKER" 2>/dev/null | tr -d '[:space:]')"
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  case "$started" in ''|*[!0-9]*) return 1 ;; esac
  [ "$pid" = "$$" ] && return 1
  now="$(date +%s)"
  [ $((now - started)) -le "$MARKER_MAX_AGE" ] && kill -0 "$pid" 2>/dev/null
}

claim_marker() { # take the update marker for this process, or hold. Idempotent.
  [ "$OWN_MARKER" = 1 ] && return 0
  update_live && finish held update_running 3
  rm -f "$MARKER"
  (set -C; printf '%s\n%s\n' "$$" "$(date +%s)" >"$MARKER") 2>/dev/null || finish held update_running 3
  [ "$(head -n 1 "$MARKER" 2>/dev/null)" = "$$" ] || finish held update_running 3
  OWN_MARKER=1
}

git_busy() {
  local f
  for f in MERGE_HEAD rebase-merge rebase-apply CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG sequencer index.lock; do
    if [ -e "$GITDIR/$f" ]; then BUSY="$f"; return 0; fi
  done
  return 1
}

[ -d "$REPO/.git" ] || finish held no_checkout 3
GITDIR="$(g rev-parse --absolute-git-dir 2>/dev/null)" || finish held no_checkout 3
git_busy && finish held "git_busy_$BUSY" 3
update_live && finish held update_running 3

# Raw configured URL (not insteadOf-rewritten): what hermes update itself classifies.
origin_url="$(g config --get remote.origin.url 2>/dev/null || true)"
printf '%s\n' "$origin_url" | grep -Eq "$OFFICIAL_RE" || finish held origin_not_official 3
# Fork-mode hazard: an `upstream` remote makes hermes update push to origin. Never on clients.
g config --get remote.upstream.url >/dev/null 2>&1 && finish held upstream_remote_present 3

branch="$(g symbolic-ref --short -q HEAD || true)"
case "$branch" in
  main|"$LOCAL_BRANCH") ;;
  "") finish held detached_head 3 ;;
  *) finish held foreign_branch 3 ;;
esac

gfetch origin main || finish held fetch_origin_failed 3
gfetch "$FLEET_URL" "+refs/heads/$FLEET_BRANCH:$FLEET_REF" || finish held fetch_fleet_failed 3

strategy_is_in_place() {
  hermes config get updates.parked_branch_strategy 2>/dev/null | grep -q update_in_place
}
set_strategy() {
  hermes config set updates.parked_branch_strategy "$1" >/dev/null 2>&1 || finish error "config_set_$1_failed" 1
}

# True only on PROOF that merging origin/main into HEAD conflicts: merge-tree --write-tree
# (git >= 2.38) exits 1 on conflict, 0 when clean; anything else (old git, error) is
# "unknown" and counts as no conflict, so we never merge on a guess.
upstream_conflicts() {
  g merge-tree --write-tree HEAD origin/main >/dev/null 2>&1
  [ $? -eq 1 ]
}
# Every upstream commit in the fleet branch is already in HEAD.
base_in_head() {
  local mb
  mb="$(g merge-base "$FLEET_REF" origin/main 2>/dev/null)" || return 1
  g merge-base --is-ancestor "$mb" HEAD
}
# merged_tree <a> <b>: tree OID of merging a and b, or fail on conflict/unknown.
merged_tree() {
  local out
  out="$(g merge-tree --write-tree "$1" "$2" 2>/dev/null)" || return 1
  printf '%s\n' "$out" | sed -n 1p
}
# Would merging the fleet ref change a Python dependency manifest in the checkout?
# Compares HEAD with the actual merge result, so changes HEAD already has don't count.
# JS manifests (root workspace lock, ui-tui, web, desktop) are excluded on purpose: they
# are only used by the normal update's rebuild, which installs dependencies first.
deps_change() {
  local t
  t="$(merged_tree HEAD "$FLEET_REF")" || return 1   # conflicting merge fails safe below
  ! g diff --quiet HEAD "$t" -- ':(glob)**/pyproject.toml' ':(glob)**/uv.lock' \
      ':(glob)**/requirements*.txt' 2>/dev/null
}

# guarded_merge <reason-on-conflict>: merge the fleet ref under the update marker. On
# failure, restores exactly the state it created, sets MERGE_FAIL and returns 1.
guarded_merge() {
  local fleet_sha pre mh
  claim_marker
  git_busy && finish held "git_busy_$BUSY" 3
  fleet_sha="$(g rev-parse "$FLEET_REF")"
  pre="$(g rev-parse HEAD)"
  if GIT_AUTHOR_NAME="Hermes fleet carry" GIT_AUTHOR_EMAIL=fleet-carry@hermes.local \
     GIT_COMMITTER_NAME="Hermes fleet carry" GIT_COMMITTER_EMAIL=fleet-carry@hermes.local \
     g merge --no-edit --quiet "$FLEET_REF" >/dev/null 2>&1; then
    return 0
  fi
  mh="$(head -n 1 "$GITDIR/MERGE_HEAD" 2>/dev/null)"
  if [ "$mh" = "$fleet_sha" ]; then
    g merge --abort >/dev/null 2>&1 || finish error merge_abort_failed 1
    MERGE_FAIL="$1"
  else
    # Git refused to start (a local edit would be overwritten): nothing was changed.
    MERGE_FAIL=merge_refused
  fi
  [ "$(g rev-parse HEAD)" = "$pre" ] || finish error head_moved_after_failed_merge 1
  return 1
}

# Retired: merging the fleet branch into upstream would change nothing under apps/desktop.
# Doesn't depend on the fleet branch having caught up with upstream; a conflict = not retired.
retired() {
  local t
  g merge-base --is-ancestor "$FLEET_REF" origin/main && return 0
  t="$(merged_tree origin/main "$FLEET_REF")" || return 1
  g diff --quiet origin/main "$t" -- apps/desktop 2>/dev/null
}

if retired; then
  if strategy_is_in_place; then
    set_strategy switch
    finish ok retired_strategy_switch 0
  fi
  finish ok retired 0
fi

if [ "$branch" = main ]; then
  # Adoption. Strategy first: harmless on main, and a later failure can't strand the branch.
  strategy_is_in_place || set_strategy update_in_place
  if g show-ref --verify --quiet "refs/heads/$LOCAL_BRANCH"; then
    # Left over (e.g. an update switched back to main). Drop it only if nothing unique is on it.
    if [ -n "$(g rev-list --no-merges "refs/heads/$LOCAL_BRANCH" ^origin/main "^$FLEET_REF" 2>/dev/null)" ]; then
      finish held carry_branch_has_unique_commits 3
    fi
    g branch -D "$LOCAL_BRANCH" >/dev/null 2>&1 || finish error stale_carry_branch_delete_failed 1
  fi
  base_in_head || finish held update_first 3
  claim_marker
  git_busy && finish held "git_busy_$BUSY" 3
  g checkout --quiet -b "$LOCAL_BRANCH" || finish error checkout_failed 1
  if ! guarded_merge adopt_merge_conflict; then
    g checkout --quiet main || finish error adopt_rollback_failed 1
    g branch -D "$LOCAL_BRANCH" >/dev/null 2>&1 || finish error adopt_rollback_failed 1
    finish held "$MERGE_FAIL" 3
  fi
  finish ok adopted_rebuild_pending 0
fi

# On the carry branch.
strategy_is_in_place || set_strategy update_in_place
if g merge-base --is-ancestor "$FLEET_REF" HEAD; then
  # Fleet branch already in. If upstream now conflicts, the central merge hasn't landed yet.
  upstream_conflicts && finish held waiting_for_fleet_merge 3
  finish ok up_to_date 0
fi
new_carry="$(g rev-list --no-merges --count HEAD.."$FLEET_REF" ^origin/main 2>/dev/null || echo 0)"
if [ "${new_carry:-0}" -gt 0 ] && base_in_head; then
  guarded_merge merge_conflict || finish held "$MERGE_FAIL" 3
  finish ok merged_new_carry_rebuild_pending 0
fi
if upstream_conflicts; then
  deps_change && finish held needs_full_update 3
  guarded_merge merge_conflict || finish held "$MERGE_FAIL" 3
  finish ok merged_conflict_resolution_rebuild_pending 0
fi
[ "${new_carry:-0}" -gt 0 ] && finish held update_first 3
finish ok no_merge_needed 0

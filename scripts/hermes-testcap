#!/usr/bin/env python3
"""hermes-testcap: put every test run started from a login/agent session into a memory-capped systemd scope.

WHY (h-do1, 2026-11-15): one agent-run `python -m pytest` grew to 4.3 GB while 17 TUI sessions, Chief and ~40
containers shared the box. The host OOM-killed 78 processes in three days, swap filled, and the tailnet/SSH path
stopped answering. A runaway test must die inside its own cgroup, never take the control plane with it.

HOW: every INTERVAL seconds, scan /proc. A process under /user.slice/ whose argv is a test runner (pytest, vitest,
jest, `playwright test`, `cargo test`, `go test`) is moved, with all its current descendants, into a new transient
scope `testcap-<pid>.scope` inside `testcap.slice` (MemoryMax=PER_RUN, MemorySwapMax=SWAP; the slice caps the total).
Children forked later inherit the scope. A descendant that raced the move is attached on the next tick.
Docker/system services are never touched: containers already carry their own mem_limit.

No agent or script has to change. The kernel kills the biggest process INSIDE the scope at the cap; the event is
logged to LOG (JSONL) and the journal.
Limit: memory a runner allocates in the <= INTERVAL seconds before it is moved stays charged to its old cgroup
(cgroup v2 does not migrate charges), so a fast grower can exceed PER_RUN by that much. Explicit wrapper for other heavy commands: hermes-capped <cmd...>.
"""
import json
import os
import subprocess
import sys
import time

SLICE = "testcap.slice"
PER_RUN = os.environ.get("TESTCAP_PER_RUN", "6G")
SWAP = os.environ.get("TESTCAP_SWAP", "512M")
INTERVAL = float(os.environ.get("TESTCAP_INTERVAL", "2"))
LOG = os.environ.get("TESTCAP_LOG", "/root/.hermes/logs/testcap.jsonl")
CG_ROOT = "/sys/fs/cgroup"


def parse_size(s):
    s = s.strip().upper()
    mult = {"K": 1 << 10, "M": 1 << 20, "G": 1 << 30, "T": 1 << 40}
    if s and s[-1] in mult:
        return int(float(s[:-1]) * mult[s[-1]])
    return int(s)


def base(p):
    return os.path.basename(p)


def is_test_runner(argv):
    """True when argv is a test-runner process itself (not a shell that merely mentions one)."""
    if not argv:
        return False
    a0 = base(argv[0])
    rest = argv[1:]
    if a0 in ("pytest", "py.test"):
        return True
    if a0.startswith("python"):
        for i, t in enumerate(rest):
            if t == "-m" and i + 1 < len(rest) and rest[i + 1] in ("pytest", "py.test"):
                return True
            if t in ("-mpytest", "-mpy.test"):
                return True
            if not t.startswith("-"):
                # first positional is the script: python /venv/bin/pytest ...
                return base(t) in ("pytest", "py.test")
        return False
    if a0 in ("cargo", "go"):
        return bool(rest) and rest[0] == "test"
    names = [a0] + [base(t) for t in rest[:2]]
    if a0 in ("node", "bun") or a0.startswith("node"):
        names = [base(t) for t in rest[:2]]
    for n in names:
        if n in ("vitest", "vitest.mjs", "jest", "jest.js"):
            return True
        if n in ("playwright", "cli.js") and "test" in rest[:4]:
            if n == "cli.js" and not any("playwright" in t for t in rest[:2]):
                continue
            return True
    return False


def read_argv(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            raw = f.read()
    except OSError:
        return None
    return [x.decode(errors="replace") for x in raw.split(b"\0") if x]


def read_cgroup(pid):
    try:
        with open(f"/proc/{pid}/cgroup") as f:
            for line in f:
                if line.startswith("0::"):
                    return line[3:].strip()
    except OSError:
        pass
    return None


def read_ppid(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            s = f.read()
        return int(s[s.rindex(")") + 2:].split()[1])
    except (OSError, ValueError, IndexError):
        return None


def snapshot():
    procs = {}
    for d in os.listdir("/proc"):
        if d.isdigit():
            pid = int(d)
            pp = read_ppid(pid)
            if pp is not None:
                procs[pid] = pp
    return procs


def descendants(root, ppids):
    kids = {}
    for p, pp in ppids.items():
        kids.setdefault(pp, []).append(p)
    out, stack = [], [root]
    while stack:
        p = stack.pop()
        out.append(p)
        stack.extend(kids.get(p, []))
    return out


def in_testcap(cg):
    return cg is not None and f"/{SLICE}/" in cg + "/"


def log(event):
    event["at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    line = json.dumps(event)
    print(line, flush=True)
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def busctl(*args):
    return subprocess.run(
        ["busctl", "call", "org.freedesktop.systemd1", "/org/freedesktop/systemd1",
         "org.freedesktop.systemd1.Manager", *args],
        capture_output=True, text=True, timeout=10)


def cap(root, pids, argv):
    unit = f"testcap-{root}.scope"
    props = [
        "PIDs", "au", str(len(pids)), *map(str, pids),
        "Slice", "s", SLICE,
        "MemoryMax", "t", str(parse_size(PER_RUN)),
        "MemorySwapMax", "t", str(parse_size(SWAP)),
        "CollectMode", "s", "inactive-or-failed",
        "Description", "s", "hermes-testcap: " + " ".join(argv)[:120],
    ]
    r = busctl("StartTransientUnit", "ssa(sv)a(sa(sv))", unit, "fail", str(len(props) // 3), *props, "0")
    log({"event": "capped" if r.returncode == 0 else "cap_failed", "unit": unit, "pids": pids,
         "cmd": " ".join(argv)[:200], "cap": PER_RUN, "err": r.stderr.strip()[:200] or None})


def attach(unit, pids):
    r = busctl("AttachProcessesToUnit", "ssau", unit, "", str(len(pids)), *map(str, pids))
    log({"event": "attached" if r.returncode == 0 else "attach_failed", "unit": unit, "pids": pids,
         "err": r.stderr.strip()[:200] or None})


OOM_SEEN = [None]


def watch_ooms():
    """memory.events is hierarchical, so the slice counter includes scopes systemd has already collected."""
    try:
        with open(os.path.join(CG_ROOT, SLICE, "memory.events")) as f:
            n = int(dict(l.split() for l in f).get("oom_kill", 0))
    except (OSError, ValueError):
        return
    if OOM_SEEN[0] is not None and n > OOM_SEEN[0]:
        log({"event": "oom_kill_in_cap", "new_kills": n - OOM_SEEN[0], "total": n, "cap": PER_RUN})
    OOM_SEEN[0] = n


def tick():
    ppids = snapshot()
    cgs = {p: read_cgroup(p) for p in ppids}
    capped_roots = set()
    for pid in sorted(ppids):
        cg = cgs.get(pid)
        if cg is None or not cg.startswith("/user.slice/") or in_testcap(cg):
            continue
        # A straggler whose ancestor is already capped: attach it to that scope.
        a, hops = ppids.get(pid), 0
        while a and a > 1 and hops < 64:
            acg = cgs.get(a)
            if in_testcap(acg):
                attach(acg.rstrip("/").split("/")[-1], [pid])
                break
            a, hops = ppids.get(a), hops + 1
        else:
            argv = read_argv(pid)
            if not argv or not is_test_runner(argv):
                continue
            # Cap only the top-most runner in a chain (pytest spawning pytest is one run).
            a, top = ppids.get(pid), True
            while a and a > 1:
                if a in capped_roots:
                    top = False
                    break
                a = ppids.get(a)
            if not top:
                continue
            tree = [p for p in descendants(pid, ppids) if (cgs.get(p) or "").startswith("/user.slice/")]
            cap(pid, tree, argv)
            capped_roots.add(pid)
    watch_ooms()


def main():
    if "--check" in sys.argv:  # argv self-test: hermes-testcap --check -- <argv...>
        i = sys.argv.index("--")
        print("match" if is_test_runner(sys.argv[i + 1:]) else "no-match")
        return
    log({"event": "start", "per_run": PER_RUN, "swap": SWAP, "interval": INTERVAL})
    while True:
        try:
            tick()
        except Exception as e:  # never die on a /proc race
            log({"event": "tick_error", "err": repr(e)[:200]})
        time.sleep(INTERVAL)


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""hermes-testcap: put every test run started from a login/agent session into a memory-capped systemd scope.

WHY (h-do1, 2026-11-15): one agent-run `python -m pytest` grew to 4.3 GB while 17 TUI sessions, Chief and ~40
containers shared the box. The host OOM-killed 78 processes in three days, swap filled, and the tailnet/SSH path
stopped answering. A runaway test must die inside its own cgroup, never take the control plane with it.

HOW: every INTERVAL seconds, scan /proc. A process under /user.slice/ whose argv is a test runner (pytest, vitest,
jest, `playwright test`, `cargo test`, `go test`) is moved, with all its current descendants, into a new transient
scope `testcap-<pid>.scope` inside `testcap.slice` (MemoryMax=PER_RUN, MemorySwapMax=SWAP; the slice caps the total).
Children forked later inherit the scope. A descendant that raced the move gets its own capped scope next tick.
Docker/system services are never touched: containers already carry their own mem_limit.

No agent or script has to change. The kernel kills the biggest process INSIDE the scope at the cap; the event is
logged to LOG (JSONL) and the journal. systemd then stops the whole scope (default OOMPolicy=stop), so the
run ends as one unit (exit 143/137) instead of limping on with a dead worker.
Limits: a runner is moved within ~INTERVAL seconds while systemd answers (all D-Bus work runs on a separate
migrator thread, each call bounded by TESTCAP_DBUS_TIMEOUT; the scan never waits on it). Memory allocated before
the move stays charged to the old cgroup (cgroup v2 does not migrate charges), so a fast grower can exceed PER_RUN
by that much. Processes are only ever moved by pidfd (StartTransientUnit PIDFDs), never by a bare PID that could
have been recycled since the scan. Explicit wrapper for other heavy commands: hermes-capped <cmd...>.
"""
import json
import os
import sys
import time

SLICE = "testcap.slice"
PER_RUN = os.environ.get("TESTCAP_PER_RUN", "6G")
SWAP = os.environ.get("TESTCAP_SWAP", "512M")
INTERVAL = float(os.environ.get("TESTCAP_INTERVAL", "2"))
LOG = os.environ.get("TESTCAP_LOG", "/root/.hermes/logs/testcap.jsonl")
CG_ROOT = "/sys/fs/cgroup"


def parse_size(s):
    s = s.strip().upper()
    mult = {"K": 1 << 10, "M": 1 << 20, "G": 1 << 30, "T": 1 << 40}
    if s and s[-1] in mult:
        return int(float(s[:-1]) * mult[s[-1]])
    return int(s)


def base(p):
    return os.path.basename(p)


PYTEST_NAMES = ("pytest", "py.test")
PY_VALUE_LETTERS = "XWQ"           # short options whose value may be attached (-Ximporttime) or the next arg
NODE_VALUE_FLAGS = ("-r", "--require", "--import", "--loader", "--experimental-loader", "-C", "--conditions")
NODE_INLINE = ("-e", "--eval", "-p", "--print")


def python_target(rest):
    """What a python interpreter will run: ("module", name) | ("script", path) | None (inline -c, stdin, REPL)."""
    i = 0
    while i < len(rest):
        t = rest[i]
        if t == "-":
            return None                      # program from stdin
        if t == "--":
            return ("script", rest[i + 1]) if i + 1 < len(rest) else None
        if t.startswith("--"):
            i += 1                           # --version, --help, ... (no long option takes a separate value)
            continue
        if t.startswith("-") and len(t) > 1:
            letters = t[1:]
            for j, ch in enumerate(letters):
                if ch == "c":
                    return None              # -c code, -cCODE, -uc code
                if ch == "m":
                    mod = letters[j + 1:] or (rest[i + 1] if i + 1 < len(rest) else "")
                    return ("module", mod) if mod else None
                if ch in PY_VALUE_LETTERS:
                    if not letters[j + 1:]:
                        i += 1               # value is the next argument
                    break                    # rest of this token is the value
            i += 1
            continue
        return ("script", t)
    return None


def node_script(rest):
    """Index of node's script argument, or None for inline code (-e/-p/--eval[=]/--print[=]) or stdin."""
    i = 0
    while i < len(rest):
        t = rest[i]
        if t == "-":
            return None
        if t == "--":
            return i + 1 if i + 1 < len(rest) else None
        name = t.split("=", 1)[0]
        if name in NODE_INLINE or (t.startswith("-") and not t.startswith("--") and len(t) > 1
                                   and any(c in "ep" for c in t[1:])):
            return None
        if t.startswith("-"):
            i += 2 if (name in NODE_VALUE_FLAGS and "=" not in t and t == name) else 1
            continue
        return i
    return None


def is_test_runner(argv):
    """True only when the EXECUTABLE (or the interpreter's script / -m module) is a test runner.

    Arguments are never matched on their own: `vim jest`, `grep vitest log`, `node server.js jest` are not runs.
    """
    if not argv:
        return False
    a0 = base(argv[0])
    rest = argv[1:]
    if a0 in PYTEST_NAMES or a0 in ("vitest", "jest"):
        return True
    if a0 in ("playwright", "cargo", "go"):
        return rest[:1] == ["test"]
    if a0.startswith("python"):
        tgt = python_target(rest)
        if tgt is None:
            return False
        kind, val = tgt
        return val in PYTEST_NAMES if kind == "module" else base(val) in PYTEST_NAMES
    if a0 in ("node", "bun") or a0.startswith("node"):
        i = node_script(rest)
        if i is None or i >= len(rest):
            return False
        script, after = rest[i], rest[i + 1:]
        b = base(script)
        if b in ("vitest", "vitest.mjs", "jest", "jest.js"):
            return True
        if b == "playwright" or (b == "cli.js" and "playwright" in script):
            return after[:1] == ["test"]
        return False
    return False


def read_argv(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            raw = f.read()
    except OSError:
        return None
    return [x.decode(errors="replace") for x in raw.split(b"\0") if x]


def read_cgroup(pid):
    try:
        with open(f"/proc/{pid}/cgroup") as f:
            for line in f:
                if line.startswith("0::"):
                    return line[3:].strip()
    except OSError:
        pass
    return None


def read_stat(pid):
    """(ppid, starttime) from /proc/<pid>/stat; starttime identifies the process across PID reuse."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            s = f.read()
        fields = s[s.rindex(")") + 2:].split()
        return int(fields[1]), int(fields[19])
    except (OSError, ValueError, IndexError):
        return None


def read_ppid(pid):
    st = read_stat(pid)
    return st[0] if st else None


def snapshot():
    """{pid: (ppid, starttime)}"""
    procs = {}
    for d in os.listdir("/proc"):
        if d.isdigit():
            st = read_stat(int(d))
            if st is not None:
                procs[int(d)] = st
    return procs


def descendants(root, ppids):
    kids = {}
    for p, pp in ppids.items():
        kids.setdefault(pp, []).append(p)
    out, stack = [], [root]
    while stack:
        p = stack.pop()
        out.append(p)
        stack.extend(kids.get(p, []))
    return out


def in_testcap(cg):
    return cg is not None and f"/{SLICE}/" in cg + "/"


def log(event):
    event["at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    line = json.dumps(event)
    print(line, flush=True)
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


DBUS_TIMEOUT = float(os.environ.get("TESTCAP_DBUS_TIMEOUT", "3"))


def manager():
    """Private system-bus connection used ONLY by the migrator thread. introspect=False: no Introspect round trip;
    every call passes an explicit signature, so nothing blocks outside the per-call DBUS_TIMEOUT except the
    socket connect itself, which also happens on the migrator thread, never on the scanner."""
    import dbus  # system python3-dbus; imported lazily so the matcher stays testable without it
    bus = dbus.SystemBus(private=True)
    obj = bus.get_object("org.freedesktop.systemd1", "/org/freedesktop/systemd1", introspect=False)
    return dbus.Interface(obj, "org.freedesktop.systemd1.Manager")


def pin(pid, ident):
    """Open a pidfd and prove it is still the process we scanned (same starttime, still in /user.slice/)."""
    try:
        fd = os.pidfd_open(pid)
    except OSError:
        return None
    st = read_stat(pid)
    cg = read_cgroup(pid)
    if st is None or st[1] != ident or not (cg or "").startswith("/user.slice/") or in_testcap(cg):
        os.close(fd)
        return None
    return fd


def scope_properties(pidfds, argv):
    """Plain (name, type, value) triples; converted to D-Bus types in start_scope(). One entry per PROPERTY."""
    return [
        ("PIDFDs", "ah", list(pidfds)),
        ("Slice", "s", SLICE),
        ("MemoryMax", "t", parse_size(PER_RUN)),
        ("MemorySwapMax", "t", parse_size(SWAP)),
        ("CollectMode", "s", "inactive-or-failed"),
        ("Description", "s", "hermes-testcap: " + " ".join(argv)[:120]),
    ]


def _dbus_props(props):
    import dbus
    conv = {"s": dbus.String, "t": dbus.UInt64}
    out = []
    for name, sig, val in props:
        v = dbus.Array([dbus.types.UnixFd(fd) for fd in val], signature="h") if sig == "ah" else conv[sig](val)
        out.append(dbus.Struct((name, v), signature=None))
    return dbus.Array(out, signature="(sv)")


class Migrator:
    """Runs every systemd call on its own thread so the /proc scan never waits on systemd.

    Jobs are (unit, [(pid, starttime)], argv, event). Processes are pinned by pidfd and handed to systemd as
    PIDFDs, so a PID recycled since the scan can never be moved. A straggler (a child that forked before its
    runner moved) gets its OWN capped scope rather than a by-PID attach; the slice still caps the total.
    Latency: a job runs within INTERVAL of its process appearing while systemd answers inside DBUS_TIMEOUT;
    while systemd is stalled nothing can be moved, jobs wait (deduplicated) and the scan carries on."""

    def __init__(self, mgr_factory=manager):
        import queue
        import threading
        self.q = queue.Queue()
        self.inflight = set()
        self.lock = threading.Lock()
        self.mgr_factory = mgr_factory
        self.mgr = None
        threading.Thread(target=self._run, name="testcap-migrator", daemon=True).start()

    def submit(self, unit, procs, argv, event):
        key = procs[0]
        with self.lock:
            if key in self.inflight:
                return False
            self.inflight.add(key)
        self.q.put((unit, procs, argv, event))
        return True

    def _run(self):
        while True:
            job = self.q.get()
            try:
                self._do(*job)
            except Exception as e:  # noqa: BLE001 - logged; the thread never dies
                log({"event": "migrator_error", "err": repr(e)[:200]})
            finally:
                with self.lock:
                    self.inflight.discard(job[1][0])

    def _do(self, unit, procs, argv, event):
        fds, pids = [], []
        try:
            for pid, ident in procs:
                fd = pin(pid, ident)
                if fd is not None:
                    fds.append(fd)
                    pids.append(pid)
            if procs[0][0] not in pids:
                return  # the runner itself is gone or no longer eligible
            import dbus
            err = None
            try:
                if self.mgr is None:
                    self.mgr = self.mgr_factory()
                self.mgr.StartTransientUnit(unit, "fail", _dbus_props(scope_properties(fds, argv)),
                                            dbus.Array([], signature="(sa(sv))"),
                                            signature="ssa(sv)a(sa(sv))", timeout=DBUS_TIMEOUT)
            except Exception as e:  # noqa: BLE001
                err = str(e)[:200]
                self.mgr = None
            log({"event": (event + "_failed") if err else event, "unit": unit, "pids": pids,
                 "cmd": " ".join(argv)[:200], "cap": PER_RUN, "err": err})
        finally:
            for fd in fds:
                os.close(fd)


OOM_SEEN = [None]


def watch_ooms():
    """memory.events is hierarchical, so the slice counter includes scopes systemd has already collected."""
    try:
        with open(os.path.join(CG_ROOT, SLICE, "memory.events")) as f:
            n = int(dict(l.split() for l in f).get("oom_kill", 0))
    except (OSError, ValueError):
        return
    if OOM_SEEN[0] is not None and n > OOM_SEEN[0]:
        log({"event": "oom_kill_in_cap", "new_kills": n - OOM_SEEN[0], "total": n, "cap": PER_RUN})
    OOM_SEEN[0] = n


def tick(mig):
    snap = snapshot()
    ppids = {p: v[0] for p, v in snap.items()}
    ident = {p: v[1] for p, v in snap.items()}
    cgs = {p: read_cgroup(p) for p in snap}
    capped_roots = set()
    for pid in sorted(snap):
        cg = cgs.get(pid)
        if cg is None or not cg.startswith("/user.slice/") or in_testcap(cg):
            continue
        try:
            a, hops, parent_scope = ppids.get(pid), 0, None
            while a and a > 1 and hops < 64:
                if in_testcap(cgs.get(a)):
                    parent_scope = cgs[a].rstrip("/").split("/")[-1]
                    break
                a, hops = ppids.get(a), hops + 1
            if parent_scope:
                stem = parent_scope[:-len(".scope")] if parent_scope.endswith(".scope") else parent_scope
                mig.submit(f"{stem}-s{pid}.scope", [(pid, ident[pid])], read_argv(pid) or ["?"], "straggler_capped")
                continue
            argv = read_argv(pid)
            if not argv or not is_test_runner(argv):
                continue
            a, top = ppids.get(pid), True
            while a and a > 1:
                if a in capped_roots:
                    top = False
                    break
                a = ppids.get(a)
            if not top:
                continue
            tree = [p for p in descendants(pid, ppids) if (cgs.get(p) or "").startswith("/user.slice/")]
            mig.submit(f"testcap-{pid}.scope", [(p, ident[p]) for p in tree], argv, "capped")
            capped_roots.add(pid)
        except Exception as e:  # noqa: BLE001 - one bad candidate never stops the scan
            log({"event": "candidate_error", "pid": pid, "err": repr(e)[:200]})
    watch_ooms()


def main():
    if "--check" in sys.argv:  # argv self-test: hermes-testcap --check -- <argv...>
        i = sys.argv.index("--")
        print("match" if is_test_runner(sys.argv[i + 1:]) else "no-match")
        return
    log({"event": "start", "per_run": PER_RUN, "swap": SWAP, "interval": INTERVAL})
    mig = Migrator()
    while True:
        try:
            tick(mig)
        except Exception as e:  # never die on a /proc race
            log({"event": "tick_error", "err": repr(e)[:200]})
        time.sleep(INTERVAL)


if __name__ == "__main__":
    main()

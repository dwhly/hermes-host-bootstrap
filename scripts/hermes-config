#!/usr/bin/env bash
# scripts/hermes-config — personal config-sync layer helper.
#
# Companion to `hermes-reload` (bootstrap repo). This one manages
# the ~/.hermes/ git repo (config + memories + agent-authored skills).
#
# Symlinked to ~/.local/bin/hermes-config by lib/99-register-host.sh.
# Aliased to `hmc` in dotfiles/aliases.sh.
#
# Usage:
#   hermes-config              status (drifted files, what would pull)
#   hermes-config status       same as bare invocation
#   hermes-config pull         git pull --ff-only in ~/.hermes
#   hermes-config save "msg"   commit local changes + push (incl. refresh-skills)
#   hermes-config bootstrap    one-shot clone-if-missing for new hosts
#   hermes-config refresh-secrets   re-run op inject without full bootstrap
#   hermes-config --help       this message
#
# Most subcommands delegate to ~/.hermes/sync.sh (which carries the actual
# logic — this file just provides a uniform CLI surface and adds the
# `bootstrap` and `refresh-secrets` actions that sync.sh doesn't have).

set -euo pipefail

HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
SYNC_SH="$HERMES_HOME/sync.sh"

# ── Source per-user defaults so HERMES_CONFIG_REPO is available ─────
if [[ -f "$HOME/.hermes-bootstrap.conf" ]]; then
  # shellcheck disable=SC1091
  source "$HOME/.hermes-bootstrap.conf"
fi

cmd_help() {
  sed -n '2,18p' "$0" | sed 's/^#\s\{0,1\}//'
}

cmd_bootstrap() {
  # One-shot for new hosts: if ~/.hermes/.git doesn't exist, clone the
  # personal config repo into it (safely backing up any pre-existing
  # non-git ~/.hermes/ content first, then restoring runtime-only files).
  #
  # Recovery-aware: if a previous run failed mid-clone (e.g. on the auth
  # prompt) and left a .pre-config-sync-*.bak alongside an empty/missing
  # ~/.hermes/, this re-run picks up where it left off using the most
  # recent backup.

  if [[ -d "$HERMES_HOME/.git" ]]; then
    echo "==> $HERMES_HOME is already a git repo — nothing to bootstrap"
    cd "$HERMES_HOME"
    echo "    remote: $(git remote get-url origin 2>/dev/null || echo '<none>')"
    echo "    branch: $(git branch --show-current 2>/dev/null || echo '<none>')"
    echo "    last commit: $(git log -1 --format='%h %s' 2>/dev/null || echo '<none>')"
    return 0
  fi

  if [[ -z "${HERMES_CONFIG_REPO:-}" ]]; then
    echo "ERROR: HERMES_CONFIG_REPO is not set in ~/.hermes-bootstrap.conf"  >&2
    echo "  Set it to the URL of your personal hermes-config repo, e.g.:"   >&2
    echo "    export HERMES_CONFIG_REPO=\"https://github.com/USER/hermes-config.git\"" >&2
    return 1
  fi

  # Find any existing backup from a previous failed run, so we don't lose
  # runtime files even if this run's backup-step gets skipped.
  # Pick the most-recent backup that actually has runtime content (state.db
  # is a good proxy — present in any Hermes install that's been used).
  # If no backup has state.db, fall through to most-recent-by-date.
  local pre_existing_backup=""
  for b in $(ls -td "${HERMES_HOME}".pre-config-sync-*.bak 2>/dev/null); do
    if [[ -e "$b/state.db" || -e "$b/hermes-agent" ]]; then
      pre_existing_backup="$b"
      break
    fi
  done
  if [[ -z "$pre_existing_backup" ]]; then
    # shellcheck disable=SC2012
    pre_existing_backup="$(ls -td "${HERMES_HOME}".pre-config-sync-*.bak 2>/dev/null | head -1 || true)"
  fi

  echo "==> No ~/.hermes/.git found. Cloning $HERMES_CONFIG_REPO → $HERMES_HOME"

  # If ~/.hermes/ exists but isn't git, back it up first.
  local backup=""
  if [[ -d "$HERMES_HOME" ]]; then
    backup="${HERMES_HOME}.pre-config-sync-$(date +%Y%m%d-%H%M%S).bak"
    echo "==> Backing up existing $HERMES_HOME → $backup"
    mv "$HERMES_HOME" "$backup"
  fi

  # Clone fresh. If this fails (auth prompt timeout, etc.) the backup stays
  # in place for the next retry.
  if ! git clone "$HERMES_CONFIG_REPO" "$HERMES_HOME"; then
    echo "ERROR: git clone failed." >&2
    if [[ -n "$backup" ]]; then
      echo "  Your prior ~/.hermes is safely backed up at: $backup" >&2
    fi
    echo "  Fix auth (try: gh auth login && gh auth setup-git), then re-run hermes-config bootstrap." >&2
    return 1
  fi

  # Restore runtime-only files. Prefer a pre-existing backup that has real
  # content over a this-run backup that might be empty (which happens when
  # an earlier failed run already moved the runtime files into a pre-existing
  # backup, leaving the path mostly-empty before this run's mv).
  local restore_src=""
  if [[ -n "$pre_existing_backup" && ( -e "$pre_existing_backup/state.db" || -e "$pre_existing_backup/hermes-agent" ) ]]; then
    restore_src="$pre_existing_backup"
  elif [[ -n "$backup" && -d "$backup" ]]; then
    restore_src="$backup"
  fi

  if [[ -n "$restore_src" && -d "$restore_src" ]]; then
    echo "==> Restoring runtime-only files from $restore_src"
    local restored=0
    for item in auth.json state.db state.db-wal state.db-shm \
                kanban.db kanban.db-wal kanban.db-shm \
                logs sessions cache image_cache audio_cache pastes lsp \
                .hermes_history channel_directory.json gateway_state.json \
                hermes-agent; do
      if [[ -e "$restore_src/$item" && ! -e "$HERMES_HOME/$item" ]]; then
        cp -r "$restore_src/$item" "$HERMES_HOME/$item"
        echo "    restored: $item"
        restored=$((restored + 1))
      fi
    done
    if [[ "$restored" -eq 0 ]]; then
      echo "    (nothing to restore — backup was empty or all items already present)"
    fi
    echo "==> Backup retained at $restore_src (safe to delete after verifying)"
  fi

  echo "==> Done. $HERMES_HOME is now a clone of $HERMES_CONFIG_REPO"
}

cmd_refresh_secrets() {
  # Re-run just the 35-secrets module from the bootstrap.
  # Useful after rotating a key in 1Password — picks up the new value
  # without re-running the full bootstrap.
  if ! command -v hermes-reload >/dev/null 2>&1; then
    echo "ERROR: hermes-reload not on PATH — install the bootstrap first" >&2
    return 1
  fi
  exec hermes-reload --only=35-secrets
}

# ── Dispatcher ──────────────────────────────────────────────────────
sub="${1:-status}"
shift 2>/dev/null || true

case "$sub" in
  -h|--help|help)
    cmd_help
    ;;
  bootstrap)
    cmd_bootstrap "$@"
    ;;
  refresh-secrets|refresh)
    cmd_refresh_secrets "$@"
    ;;
  status|pull|save|refresh-skills|auto)
    # Delegate to ~/.hermes/sync.sh for the canonical operations.
    if [[ ! -x "$SYNC_SH" ]]; then
      echo "ERROR: $SYNC_SH not found or not executable." >&2
      echo "  Run 'hermes-config bootstrap' first to clone your config repo." >&2
      exit 1
    fi
    exec "$SYNC_SH" "$sub" "$@"
    ;;
  *)
    echo "unknown subcommand: $sub" >&2
    echo "" >&2
    cmd_help >&2
    exit 2
    ;;
esac

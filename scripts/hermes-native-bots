#!/usr/bin/env bash
# hermes-native-bots: fleet helper for native Hermes Desktop and API server plumbing.

set -euo pipefail

VERSION="2"
API_PORT_DEFAULT="8642"
DESKTOP_LABEL="com.hermes.desktop"
DESKTOP_BUNDLE_ID="com.nousresearch.hermes"

json_escape() {
  local s="${1:-}"
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json,sys; print(json.dumps(sys.argv[1])[1:-1], end="")' "$s" 2>/dev/null && return
  fi
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\n'/\\n}"
  printf '%s' "$s"
}

json_bool() {
  case "${1:-0}" in
    1|true|yes|on) printf true ;;
    *) printf false ;;
  esac
}

die_json() {
  local code="$1" msg="$2"
  printf '{"schema_version":1,"ok":false,"error_code":"%s","error":"%s"}\n' \
    "$(json_escape "$code")" "$(json_escape "$msg")"
  exit 1
}

short_host() {
  hostname -s 2>/dev/null || hostname 2>/dev/null || printf unknown
}

stat_uid() {
  if stat -c '%u' "$1" >/dev/null 2>&1; then
    stat -c '%u' "$1"
  else
    stat -f '%u' "$1"
  fi
}

uid_for_user() {
  id -u "$1" 2>/dev/null || id -u 2>/dev/null || printf 0
}

runtime_from_hbtp_registry() {
  local metadata candidate home_candidate="${HERMES_HOME:-$HOME/.hermes}"
  if [[ -n "${HERMES_NATIVE_BOTS_HOSTS_METADATA:-}" ]]; then
    metadata="$HERMES_NATIVE_BOTS_HOSTS_METADATA"
    [[ -r "$metadata" ]] || return 1
    runtime_from_registry_file "$metadata"
    return
  fi
  for candidate in \
    "$home_candidate/fleet/hosts.yaml" \
    "$HOME/.hermes/fleet/hosts.yaml" \
    /opt/hermes-config-baseline/fleet/hosts.yaml; do
    [[ -r "$candidate" ]] || continue
    runtime_from_registry_file "$candidate" && return 0
  done
  return 1
}

runtime_from_registry_file() {
  local metadata="$1"
  command -v python3 >/dev/null 2>&1 || return 1
  python3 - "$metadata" <<'PY' 2>/dev/null
import re
import sys
from pathlib import Path

text = Path(sys.argv[1]).read_text(encoding="utf-8", errors="replace")

def emit(user, home):
    user = (user or "").strip().strip('"\'')
    home = (home or "").strip().strip('"\'')
    if user and home:
        print(f"{user}\t{home}")
        raise SystemExit(0)

try:
    import yaml
except Exception:
    yaml = None

if yaml is not None:
    data = yaml.safe_load(text) or {}
    hosts = data.get("hosts") if isinstance(data, dict) else None
    if isinstance(hosts, dict):
        hosts = hosts.values()
    if isinstance(hosts, list):
        for host in hosts:
            if isinstance(host, dict) and host.get("hostname") == "h-btp":
                mgmt = host.get("management") if isinstance(host.get("management"), dict) else {}
                emit(mgmt.get("runtime_user"), mgmt.get("hermes_home"))

lines = text.splitlines()
in_hbtp = False
in_management = False
user = ""
home = ""
for raw in lines:
    line = raw.rstrip()
    if re.match(r"^\s*-\s*hostname:\s*['\"]?h-btp['\"]?\s*$", line) or re.match(r"^\s*hostname:\s*['\"]?h-btp['\"]?\s*$", line):
        in_hbtp = True
        in_management = False
        continue
    if in_hbtp and re.match(r"^\s*-\s*hostname:\s*", line):
        break
    if in_hbtp and re.match(r"^\s*management:\s*$", line):
        in_management = True
        continue
    if in_hbtp and in_management:
        m = re.match(r"^\s*runtime_user:\s*(.+?)\s*$", line)
        if m:
            user = m.group(1)
        m = re.match(r"^\s*hermes_home:\s*(.+?)\s*$", line)
        if m:
            home = m.group(1)
        if user and home:
            emit(user, home)
raise SystemExit(1)
PY
}

resolve_runtime() {
  RUNTIME_USER="$(id -un 2>/dev/null || whoami 2>/dev/null || printf unknown)"
  RUNTIME_LOGIN_HOME="$HOME"
  RUNTIME_HOME="${HERMES_HOME:-$HOME/.hermes}"
  RUNTIME_DEFER=0
  RUNTIME_DEFER_REASON=""

  if [[ "$(short_host)" == "h-btp" ]]; then
    local record target_user target_home target_login
    record="$(runtime_from_hbtp_registry || true)"
    if [[ -n "$record" ]]; then
      target_user="${record%%$'\t'*}"
      target_home="${record#*$'\t'}"
      target_login="${target_home%/.hermes}"
      if [[ "$target_login" == "$target_home" ]]; then
        target_login="$HOME"
      fi
      if [[ "$RUNTIME_USER" != "$target_user" || "$RUNTIME_HOME" != "$target_home" ]]; then
        RUNTIME_USER="$target_user"
        RUNTIME_HOME="$target_home"
        RUNTIME_LOGIN_HOME="$target_login"
        RUNTIME_DEFER=1
        RUNTIME_DEFER_REASON="h-btp runtime is managed by registry user $target_user at $target_home; refusing to edit caller runtime"
        return 0
      fi
      RUNTIME_LOGIN_HOME="$target_login"
    elif [[ "$(id -u 2>/dev/null || printf 1)" == "0" ]]; then
      RUNTIME_DEFER=1
      RUNTIME_DEFER_REASON="h-btp runtime registry metadata unavailable; refusing to edit root default home"
    fi
  fi
}

env_path() {
  printf '%s/.env' "$RUNTIME_HOME"
}

api_state_path() {
  printf '%s/runtime/native-bots-api-state.json' "$RUNTIME_HOME"
}

validate_runtime_home() {
  local parent target_uid actual_uid
  parent="$(dirname "$RUNTIME_HOME")"
  target_uid="$(uid_for_user "$RUNTIME_USER")"
  [[ "$RUNTIME_USER" == "$(id -un 2>/dev/null || whoami 2>/dev/null || printf unknown)" ]] \
    || die_json wrong_runtime_user "refusing to edit runtime for a different user"
  [[ ! -L "$parent" ]] || die_json unsafe_home "refusing symlink runtime parent"
  [[ ! -L "$RUNTIME_HOME" ]] || die_json unsafe_home "refusing symlink runtime home"
  [[ -d "$parent" ]] || die_json unsafe_home "runtime parent does not exist"
  if [[ -e "$RUNTIME_HOME" ]]; then
    [[ -d "$RUNTIME_HOME" ]] || die_json unsafe_home "runtime home is not a directory"
    actual_uid="$(stat_uid "$RUNTIME_HOME")"
    [[ "$actual_uid" == "$target_uid" ]] || die_json unsafe_home "runtime home owner does not match runtime user"
  else
    mkdir "$RUNTIME_HOME" || die_json unsafe_home "could not create runtime home"
  fi
}

validate_env_target() {
  local env_file
  validate_runtime_home
  env_file="$(env_path)"
  if [[ -L "$env_file" ]]; then
    die_json unsafe_env "refusing to edit symlink .env"
  fi
  if [[ -e "$env_file" && ! -f "$env_file" ]]; then
    die_json unsafe_env "refusing to edit non-regular .env"
  fi
}

with_env_lock() {
  local lock_dir="$RUNTIME_HOME/.native-bots-env.lock"
  if ! mkdir "$lock_dir" 2>/dev/null; then
    die_json env_locked "runtime .env is already being edited"
  fi
  ENV_LOCK_DIR="$lock_dir"
}

release_env_lock() {
  if [[ -n "${ENV_LOCK_DIR:-}" ]]; then
    rmdir "$ENV_LOCK_DIR" 2>/dev/null || true
    ENV_LOCK_DIR=""
  fi
}

runtime_python() {
  local hermes_bin candidate real
  for candidate in "${HERMES_NATIVE_BOTS_PYTHON:-}" "$RUNTIME_HOME/hermes-agent/venv/bin/python3" "$RUNTIME_HOME/hermes-agent/.venv/bin/python3"; do
    [[ -n "$candidate" && -x "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
  done
  hermes_bin="$(hermes_bin 2>/dev/null || true)"
  if [[ -n "$hermes_bin" ]]; then
    real="$(grep -oE '"[^"]*venv/bin/hermes"' "$hermes_bin" 2>/dev/null | head -1 | tr -d '"' || true)"
    [[ -z "$real" ]] && real="$hermes_bin"
    for candidate in "$(dirname "$real")/python3" "$(dirname "$real")/python"; do
      [[ -x "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
    done
  fi
  for candidate in /usr/local/lib/hermes-agent/venv/bin/python3 python3; do
    if command -v "$candidate" >/dev/null 2>&1; then
      command -v "$candidate"
      return 0
    fi
    [[ -x "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
  done
  return 1
}

hermes_bin() {
  local candidate
  for candidate in "${HERMES_NATIVE_BOTS_HERMES_BIN:-}" "$RUNTIME_LOGIN_HOME/.local/bin/hermes" "$HOME/.local/bin/hermes" /usr/local/bin/hermes /usr/local/lib/hermes-agent/venv/bin/hermes hermes; do
    [[ -n "$candidate" ]] || continue
    if command -v "$candidate" >/dev/null 2>&1; then
      command -v "$candidate"
      return 0
    fi
    [[ -x "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
  done
  return 1
}

env_tool() {
  local py
  py="$(runtime_python)" || die_json missing_python "python is required to parse .env safely"
  "$py" - "$@" <<'PY'
import json
import os
import re
import secrets
import shlex
import sys
import tempfile
from pathlib import Path

MANAGED = {"API_SERVER_ENABLED", "API_SERVER_HOST", "API_SERVER_PORT", "API_SERVER_KEY"}
PLACEHOLDER_MARKERS = ("changeme", "change-me", "placeholder", "example", "dummy", "test-key", "secret", "your_key", "apikey")

def fail(code, msg):
    print(json.dumps({"ok": False, "error_code": code, "error": msg}, separators=(",", ":")))
    raise SystemExit(9)

def usable_secret(value):
    value = (value or "").rstrip("\r")
    low = value.lower()
    return len(value) >= 16 and not any(marker in low for marker in PLACEHOLDER_MARKERS)

def parse_line(line):
    stripped = line.lstrip()
    if not stripped or stripped.startswith("#"):
        return None, None
    if stripped.startswith("export "):
        stripped = stripped[7:].lstrip()
    match = re.match(r"([A-Za-z_][A-Za-z0-9_]*)=(.*)$", stripped, re.S)
    if not match:
        return None, None
    key, raw = match.group(1), match.group(2).rstrip("\n")
    lexer = shlex.shlex(raw, posix=True)
    lexer.whitespace_split = True
    lexer.commenters = "#"
    try:
        parts = list(lexer)
        value = " ".join(parts) if parts else ""
    except ValueError:
        value = raw.split("#", 1)[0].strip().strip("'\"")
    return key, value

def read_text(path):
    p = Path(path)
    if not p.exists():
        return ""
    return p.read_bytes().decode("utf-8", "surrogateescape")

def parsed_env(path):
    values = {}
    lines = read_text(path).splitlines(True)
    for line in lines:
        key, value = parse_line(line)
        if key:
            values.setdefault(key, []).append(value)
    return values, lines

def require_unambiguous(values, keys=MANAGED):
    for key in keys:
        vals = values.get(key, [])
        if len(set(vals)) > 1:
            fail("duplicate_managed_key", f"conflicting duplicate {key} entries in .env")

def config_api_key(path):
    p = Path(path)
    if not p.exists():
        return ""
    text = p.read_text(encoding="utf-8", errors="replace")
    found = []
    try:
        import yaml
    except Exception:
        yaml = None
    if yaml is not None:
        data = yaml.safe_load(text) or {}
        def walk(obj, parents=()):
            if isinstance(obj, dict):
                for k, v in obj.items():
                    ks = str(k).lower()
                    next_parents = parents + (ks,)
                    if isinstance(v, str):
                        under_api = any(p in {"api", "api_server", "gateway"} for p in parents)
                        if ks == "api_server_key" or (under_api and ks in {"api_key", "server_key", "key"}):
                            found.append(v)
                    walk(v, next_parents)
            elif isinstance(obj, list):
                for item in obj:
                    walk(item, parents)
        walk(data)
    if not found:
        stack = []
        for line in text.splitlines():
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            indent = len(line) - len(line.lstrip(" "))
            match = re.match(r"^\s*([A-Za-z_][A-Za-z0-9_]*):\s*(.*?)\s*$", line)
            if not match:
                continue
            key = match.group(1).lower()
            value = match.group(2).strip().strip("'\"")
            while stack and stack[-1][0] >= indent:
                stack.pop()
            parents = [name for _, name in stack]
            if key == "api_server_key" and value:
                found.append(value)
            elif any(parent in {"api", "api_server", "gateway"} for parent in parents) and key in {"api_key", "server_key", "key"} and value:
                found.append(value)
            if not value:
                stack.append((indent, key))
    found = [v for v in found if v]
    if len(set(found)) > 1:
        fail("config_key_conflict", "conflicting API key values found in Hermes gateway config")
    return found[0] if found else ""

def append_managed(lines, host, port, key_value):
    kept = []
    for line in lines:
        key, _ = parse_line(line)
        if key in MANAGED:
            continue
        if line.rstrip("\n") == "# Hermes native Bot API fleet defaults":
            continue
        kept.append(line)
    text = "".join(kept)
    if text and not text.endswith("\n"):
        text += "\n"
    text += "# Hermes native Bot API fleet defaults\n"
    text += "API_SERVER_ENABLED=true\n"
    text += f"API_SERVER_HOST={host}\n"
    text += f"API_SERVER_PORT={port}\n"
    text += f"API_SERVER_KEY={key_value}\n"
    return text

def secure_env_mode(path):
    try:
        os.chmod(path, 0o600)
    except FileNotFoundError:
        pass

def write_env_atomic(path, text):
    p = Path(path)
    p.parent.mkdir(parents=True, exist_ok=True)
    if p.is_symlink():
        fail("unsafe_env", "refusing to edit symlink .env")
    if p.exists():
        secure_env_mode(p)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{p.name}.", dir=str(p.parent))
    tmp = Path(tmp_name)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb") as fh:
            fh.write(text.encode("utf-8", "surrogateescape"))
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, p)
        secure_env_mode(p)
    except Exception:
        try:
            os.close(fd)
        except OSError:
            pass
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass
        raise

action = sys.argv[1]
env_path = sys.argv[2]
config_path = sys.argv[3] if len(sys.argv) > 3 else ""
if action == "apply" and Path(env_path).is_symlink():
    fail("unsafe_env", "refusing to edit symlink .env")
values, lines = parsed_env(env_path)
require_unambiguous(values)

if action == "read":
    key = sys.argv[3]
    vals = values.get(key, [])
    print(vals[-1] if vals else "")
elif action == "has-key":
    vals = values.get("API_SERVER_KEY", [])
    key = vals[-1] if vals else ""
    print("1" if usable_secret(key) else "0")
elif action == "apply":
    host, port = sys.argv[4], sys.argv[5]
    env_vals = values.get("API_SERVER_KEY", [])
    env_key = env_vals[-1] if env_vals else ""
    cfg_key = config_api_key(config_path)
    key_created = False
    if env_vals:
        if not usable_secret(env_key):
            fail("insecure_key", "existing API_SERVER_KEY is blank, placeholder-like, or too short; refusing silent rotation")
        if cfg_key and cfg_key != env_key:
            fail("key_conflict", "API_SERVER_KEY in .env conflicts with Hermes gateway config")
        key_value = env_key
    elif cfg_key:
        if not usable_secret(cfg_key):
            fail("insecure_key", "Hermes gateway config API key is blank, placeholder-like, or too short; refusing silent rotation")
        key_value = cfg_key
    else:
        key_value = secrets.token_hex(32)
        key_created = True
    new_text = append_managed(lines, host, port, key_value)
    old_text = "".join(lines)
    changed = old_text != new_text
    p = Path(env_path)
    if changed:
        write_env_atomic(p, new_text)
    elif p.exists():
        secure_env_mode(p)
    print(json.dumps({"ok": True, "changed": changed, "key_created": key_created, "key_present": usable_secret(key_value)}, separators=(",", ":")))
else:
    fail("usage", f"unknown env action {action}")
PY
}

read_env_value() {
  local key="$1" out
  out="$(env_tool read "$(env_path)" "$key")" || return 1
  printf '%s' "$out"
}

has_key() {
  local out
  out="$(env_tool has-key "$(env_path)" 2>/dev/null || true)"
  [[ "$out" == "1" ]] && printf 1 || printf 0
}

generate_api_state() {
  local pending="$1" host="${2:-}" port="${3:-$API_PORT_DEFAULT}" state_file
  state_file="$(api_state_path)"
  mkdir -p "$(dirname "$state_file")"
  printf '{"schema_version":1,"restart_pending":%s,"host":"%s","port":%s,"safe_reapply":"hermes-native-bots apply-api"}\n' \
    "$(json_bool "$pending")" "$(json_escape "$host")" "$port" >"$state_file"
  chmod 600 "$state_file" 2>/dev/null || true
}

api_restart_pending() {
  local state_file
  state_file="$(api_state_path)"
  [[ -f "$state_file" ]] && grep -q '"restart_pending":true' "$state_file"
}

atomic_update_env() {
  local host="$1" port="$2" env_file config_file result rc
  validate_env_target
  with_env_lock
  trap release_env_lock RETURN
  env_file="$(env_path)"
  config_file="$RUNTIME_HOME/config.yaml"
  set +e
  result="$(env_tool apply "$env_file" "$config_file" "$host" "$port")"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    release_env_lock
    if [[ "$result" == \{* ]]; then
      printf '%s\n' "$result"
      exit 1
    fi
    die_json env_update_failed "failed to update .env"
  fi
  release_env_lock
  CONFIG_CHANGED="$(printf '%s' "$result" | sed -n 's/.*"changed":\([^,}]*\).*/\1/p')"
  KEY_CREATED="$(printf '%s' "$result" | sed -n 's/.*"key_created":\([^,}]*\).*/\1/p')"
  [[ "$CONFIG_CHANGED" == "true" ]] && CONFIG_CHANGED=1 || CONFIG_CHANGED=0
  [[ "$KEY_CREATED" == "true" ]] && KEY_CREATED=1 || KEY_CREATED=0
}

valid_tailnet_ipv4() {
  local ip="$1"
  [[ "$ip" =~ ^100\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  IFS=. read -r _ a b c <<<"$ip"
  [[ "$a" -ge 64 && "$a" -le 127 && "$b" -le 255 && "$c" -le 255 ]]
}

local_tailscale_ipv4() {
  local ts
  if [[ -n "${HERMES_NATIVE_BOTS_TAILSCALE_IP:-}" ]]; then
    printf '%s\n' "$HERMES_NATIVE_BOTS_TAILSCALE_IP"
    return 0
  fi
  if command -v tailscale >/dev/null 2>&1; then
    tailscale ip -4 2>/dev/null | sed -n '1p'
    return 0
  fi
  if [[ -x /Applications/Tailscale.app/Contents/MacOS/tailscale ]]; then
    /Applications/Tailscale.app/Contents/MacOS/tailscale ip -4 2>/dev/null | sed -n '1p'
    return 0
  fi
  return 1
}

validate_requested_host() {
  local host="$1" local_ip
  valid_tailnet_ipv4 "$host" || die_json invalid_host "API_SERVER_HOST must be a Tailscale IPv4"
  local_ip="$(local_tailscale_ipv4 || true)"
  [[ -n "$local_ip" ]] || die_json missing_tailscale "could not verify local Tailscale IPv4"
  [[ "$host" == "$local_ip" ]] || die_json invalid_host "API_SERVER_HOST must match the local Tailscale IPv4"
}

gateway_restart() {
  local reason="$1" hermes
  hermes="$(hermes_bin || true)"
  [[ -n "$hermes" ]] || die_json missing_hermes "hermes CLI not found; cannot restart gateway"
  if ! HOME="$RUNTIME_LOGIN_HOME" HERMES_HOME="$RUNTIME_HOME" "$hermes" gateway status >/dev/null 2>&1; then
    die_json gateway_not_supervised "existing supervised Hermes gateway service was not found"
  fi
  HOME="$RUNTIME_LOGIN_HOME" HERMES_HOME="$RUNTIME_HOME" "$hermes" gateway restart >/dev/null \
    || die_json gateway_restart_failed "hermes gateway restart failed"
  GATEWAY_RESTART_STATUS="restarted"
  GATEWAY_RESTART_REASON="$reason"
}

receipt_api() {
  local action="$1" status="$2" host="${3:-}" port="${4:-$API_PORT_DEFAULT}" changed="${5:-0}" key_created="${6:-0}" restart_status="${7:-deferred}" extra="${8:-}" pending=0
  api_restart_pending && pending=1 || pending=0
  printf '{"schema_version":1,"ok":true,"action":"%s","version":"%s","runtime_user":"%s","hermes_home":"%s","api":{"status":"%s","host":"%s","port":%s,"config_changed":%s,"restart_pending":%s,"needs_restart":%s,"restart_status":"%s","safe_reapply":"hermes-native-bots apply-api","key_present":%s,"key_created":%s%s}}\n' \
    "$(json_escape "$action")" \
    "$(json_escape "$VERSION")" \
    "$(json_escape "$RUNTIME_USER")" \
    "$(json_escape "$RUNTIME_HOME")" \
    "$(json_escape "$status")" \
    "$(json_escape "$host")" \
    "$port" \
    "$(json_bool "$changed")" \
    "$(json_bool "$pending")" \
    "$(json_bool "$pending")" \
    "$(json_escape "$restart_status")" \
    "$(json_bool "$(has_key)")" \
    "$(json_bool "$key_created")" \
    "$extra"
}

cmd_configure_api() {
  resolve_runtime
  if [[ "$RUNTIME_DEFER" -eq 1 ]]; then
    receipt_api configure deferred "" "$API_PORT_DEFAULT" 0 0 deferred ",\"defer_reason\":\"$(json_escape "$RUNTIME_DEFER_REASON")\""
    return 0
  fi
  local host="${HERMES_NATIVE_BOTS_TAILSCALE_IP:-}" port="${API_SERVER_PORT:-$API_PORT_DEFAULT}" restart_gateway=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host) host="${2:-}"; shift 2 ;;
      --port) port="${2:-}"; shift 2 ;;
      --restart-gateway) restart_gateway=1; shift ;;
      *) die_json usage "unknown configure-api argument: $1" ;;
    esac
  done
  [[ -n "$host" ]] || die_json missing_tailscale "no Tailscale IPv4 supplied"
  validate_requested_host "$host"
  [[ "$port" =~ ^[0-9]+$ && "$port" -gt 0 && "$port" -le 65535 ]] || die_json invalid_port "API_SERVER_PORT must be a TCP port"
  atomic_update_env "$host" "$port"
  if [[ "$CONFIG_CHANGED" -eq 1 ]]; then
    generate_api_state 1 "$host" "$port"
  fi
  if [[ "$restart_gateway" -eq 1 ]]; then
    gateway_restart "requested"
    if wait_verify_api "$host" "$port" "$(env_path)"; then
      generate_api_state 0 "$host" "$port"
      receipt_api configure verified "$host" "$port" "$CONFIG_CHANGED" "$KEY_CREATED" verified ",\"restart_reason\":\"$(json_escape "$GATEWAY_RESTART_REASON")\""
    else
      generate_api_state 1 "$host" "$port"
      receipt_api configure restart-requested "$host" "$port" "$CONFIG_CHANGED" "$KEY_CREATED" restart-requested ",\"restart_reason\":\"$(json_escape "$GATEWAY_RESTART_REASON")\""
    fi
  else
    receipt_api configure configured "$host" "$port" "$CONFIG_CHANGED" "$KEY_CREATED" "$(api_restart_pending && printf pending || printf not_required)"
  fi
}

cmd_apply_api() {
  resolve_runtime
  [[ "$RUNTIME_DEFER" -eq 0 ]] || die_json deferred "$RUNTIME_DEFER_REASON"
  local host port
  host="$(read_env_value API_SERVER_HOST || true)"
  port="$(read_env_value API_SERVER_PORT || true)"
  [[ -n "$host" ]] || die_json not_configured "API_SERVER_HOST missing"
  [[ -n "$port" ]] || port="$API_PORT_DEFAULT"
  [[ "$(has_key)" == "1" ]] || die_json missing_key "usable API_SERVER_KEY missing"
  gateway_restart "requested"
  if wait_verify_api "$host" "$port" "$(env_path)"; then
    generate_api_state 0 "$host" "$port"
    receipt_api apply verified "$host" "$port" 0 0 verified ",\"restart_reason\":\"$(json_escape "$GATEWAY_RESTART_REASON")\""
  else
    generate_api_state 1 "$host" "$port"
    receipt_api apply restart-requested "$host" "$port" 0 0 restart-requested ",\"restart_reason\":\"$(json_escape "$GATEWAY_RESTART_REASON")\""
  fi
}

cmd_status_api() {
  resolve_runtime
  local host port key_state status="configured" restart_status
  host="$(read_env_value API_SERVER_HOST || true)"
  port="$(read_env_value API_SERVER_PORT || true)"
  [[ -n "$port" ]] || port="$API_PORT_DEFAULT"
  [[ "$(has_key)" == "1" ]] && key_state=present || key_state=missing
  if [[ "$RUNTIME_DEFER" -eq 1 ]]; then
    status="deferred"
  elif [[ "$(read_env_value API_SERVER_ENABLED || true)" != "true" ]]; then
    status="disabled"
  elif [[ "$key_state" != "present" ]]; then
    status="missing_key"
  elif ! valid_tailnet_ipv4 "$host"; then
    status="invalid_host"
  fi
  api_restart_pending && restart_status=pending || restart_status=not_required
  receipt_api status "$status" "$host" "$port" 0 0 "$restart_status" ",\"key_state\":\"$(json_escape "$key_state")\""
}

python_verify_api() {
  local host="$1" port="$2" env_file="$3"
  "$(runtime_python)" - "$host" "$port" "$env_file" <<'PY'
import json, os, shlex, sys, urllib.error, urllib.request

host, port, env_file = sys.argv[1:4]
key = ""
with open(env_file, encoding="utf-8") as fh:
    for line in fh:
        stripped = line.lstrip()
        if stripped.startswith("export "):
            stripped = stripped[7:].lstrip()
        if stripped.startswith("API_SERVER_KEY="):
            raw = stripped.split("=", 1)[1]
            lexer = shlex.shlex(raw, posix=True)
            lexer.whitespace_split = True
            lexer.commenters = "#"
            parts = list(lexer)
            key = " ".join(parts) if parts else ""

def request(path, token):
    url = f"http://{host}:{port}{path}"
    headers = {}
    if token is not None:
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(url, headers=headers, method="GET")
    timeout = float(os.environ.get("HERMES_NATIVE_BOTS_API_PROBE_TIMEOUT", "5"))
    max_body = 1024 * 1024
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read(max_body + 1)
            return resp.status, body[:max_body], len(body) > max_body
    except urllib.error.HTTPError as exc:
        body = exc.read(max_body + 1)
        return exc.code, body[:max_body], len(body) > max_body
    except (urllib.error.URLError, TimeoutError, OSError):
        return 0, b"", False

no_key, _, no_key_overlength = request("/v1/capabilities", None)
wrong_key, _, wrong_key_overlength = request("/v1/capabilities", "wrong-key")
caps_status, caps_body, caps_overlength = request("/v1/capabilities", key)
models_status, models_body, models_overlength = request("/v1/models", key)
response_overlength = no_key_overlength or wrong_key_overlength or caps_overlength or models_overlength
caps_ok = False
models_ok = False
try:
    caps = json.loads(caps_body.decode("utf-8")) if caps_status == 200 and not caps_overlength else {}
    models = json.loads(models_body.decode("utf-8")) if models_status == 200 and not models_overlength else {}
    caps_ok = isinstance(caps, dict) and caps.get("object") == "hermes.api_server.capabilities"
    models_ok = isinstance(models, dict) and models.get("object") == "list"
except Exception:
    caps = {}
    models = {}
ok = (
    no_key == 401
    and wrong_key == 401
    and caps_status == 200
    and models_status == 200
    and not response_overlength
    and caps_ok
    and models_ok
)
error = "response_too_large" if response_overlength else None
print(json.dumps({
    "schema_version": 1,
    "ok": ok,
    "action": "verify-api",
    "api": {
        "host": host,
        "port": int(port),
        "no_key_denied": no_key == 401,
        "wrong_key_denied": wrong_key == 401,
        "capabilities_authenticated": caps_ok,
        "models_authenticated": models_ok,
        "response_overlength": response_overlength,
        **({"error": error} if error else {}),
    },
}, separators=(",", ":")))
raise SystemExit(0 if ok else 1)
PY
}

cmd_verify_api() {
  resolve_runtime
  [[ "$RUNTIME_DEFER" -eq 0 ]] || die_json deferred "$RUNTIME_DEFER_REASON"
  local host port env_file
  host="$(read_env_value API_SERVER_HOST || true)"
  port="$(read_env_value API_SERVER_PORT || true)"
  env_file="$(env_path)"
  [[ -n "$host" ]] || die_json not_configured "API_SERVER_HOST missing"
  [[ -n "$port" ]] || port="$API_PORT_DEFAULT"
  [[ -f "$env_file" ]] || die_json not_configured ".env missing"
  [[ "$(has_key)" == "1" ]] || die_json missing_key "usable API_SERVER_KEY missing"
  python_verify_api "$host" "$port" "$env_file"
}

wait_verify_api() {
  local host="$1" port="$2" env_file="$3" attempts interval probe_timeout i
  attempts="${HERMES_NATIVE_BOTS_API_VERIFY_ATTEMPTS:-15}"
  interval="${HERMES_NATIVE_BOTS_API_VERIFY_INTERVAL:-1}"
  probe_timeout="${HERMES_NATIVE_BOTS_API_PROBE_TIMEOUT:-1}"
  [[ "$attempts" =~ ^[0-9]+$ && "$attempts" -gt 0 ]] || attempts=1
  for ((i = 1; i <= attempts; i++)); do
    if HERMES_NATIVE_BOTS_API_PROBE_TIMEOUT="$probe_timeout" python_verify_api "$host" "$port" "$env_file" >/dev/null 2>&1; then
      return 0
    fi
    if [[ "$i" -lt "$attempts" ]]; then
      sleep "$interval"
    fi
  done
  return 1
}

desktop_release_app_candidates() {
  local root runtime_source roots=()
  if [[ -n "${HERMES_SOURCE_ROOT:-}" ]]; then
    roots=("$HERMES_SOURCE_ROOT")
  else
    runtime_source="${RUNTIME_HOME:-${HERMES_HOME:-$HOME/.hermes}}/hermes-agent"
    roots=("$runtime_source" "/usr/local/lib/hermes-agent")
  fi
  for root in "${roots[@]}"; do
    [[ -d "$root/apps/desktop/release" ]] || continue
    find "$root/apps/desktop/release" -maxdepth 4 -type d -name 'Hermes.app' 2>/dev/null
  done | sort -u
}

app_info_value() {
  local app="$1" key="$2"
  if command -v defaults >/dev/null 2>&1; then
    defaults read "$app/Contents/Info" "$key" 2>/dev/null && return 0
  fi
  "$(runtime_python)" - "$app/Contents/Info.plist" "$key" <<'PY' 2>/dev/null
import plistlib, sys
with open(sys.argv[1], "rb") as fh:
    print(plistlib.load(fh).get(sys.argv[2], ""))
PY
}

verify_desktop_app() {
  local app="$1" bundle version exe exe_path arch_info codesign_state="not_checked"
  [[ -d "$app/Contents" ]] || return 1
  bundle="$(app_info_value "$app" CFBundleIdentifier || true)"
  [[ "$bundle" == "$DESKTOP_BUNDLE_ID" ]] || return 1
  version="$(app_info_value "$app" CFBundleShortVersionString || true)"
  [[ -n "$version" ]] || return 1
  exe="$(app_info_value "$app" CFBundleExecutable || true)"
  [[ -n "$exe" ]] || return 1
  exe_path="$app/Contents/MacOS/$exe"
  [[ -x "$exe_path" ]] || return 1
  if command -v file >/dev/null 2>&1; then
    arch_info="$(file "$exe_path" 2>/dev/null || true)"
    case "$(uname -m)" in
      arm64) [[ "$arch_info" == *arm64* || "$arch_info" == *universal* ]] || return 1 ;;
      x86_64) [[ "$arch_info" == *x86_64* || "$arch_info" == *universal* ]] || return 1 ;;
    esac
  fi
  if command -v codesign >/dev/null 2>&1; then
    if codesign --verify --deep --strict "$app" >/dev/null 2>&1; then
      codesign_state="verified"
    elif [[ -d "$app/Contents/_CodeSignature" ]]; then
      return 1
    else
      codesign_state="unsigned"
    fi
  fi
  DESKTOP_APP_VERSION="$version"
  DESKTOP_APP_EXECUTABLE="$exe_path"
  DESKTOP_APP_CODESIGN="$codesign_state"
  return 0
}

desktop_source_app() {
  local candidate
  if [[ -n "${HERMES_DESKTOP_APP_SOURCE:-}" ]]; then
    verify_desktop_app "$HERMES_DESKTOP_APP_SOURCE" || return 1
    printf '%s\n' "$HERMES_DESKTOP_APP_SOURCE"
    return 0
  fi
  while IFS= read -r candidate; do
    verify_desktop_app "$candidate" && printf '%s\n' "$candidate"
  done < <(desktop_release_app_candidates)
}

ensure_desktop_source_app() {
  local src hermes
  src="$(desktop_source_app | tail -n 1 || true)"
  if [[ -n "$src" ]]; then
    printf '%s\n' "$src"
    return 0
  fi
  hermes="$(hermes_bin || true)"
  [[ -n "$hermes" ]] || die_json desktop_build_unavailable "hermes CLI not found; cannot build Hermes Desktop"
  HOME="$RUNTIME_LOGIN_HOME" HERMES_HOME="$RUNTIME_HOME" "$hermes" desktop --build-only >/dev/null \
    || die_json desktop_build_failed "hermes desktop --build-only failed"
  src="$(desktop_source_app | tail -n 1 || true)"
  [[ -n "$src" ]] || die_json desktop_app_missing "hermes desktop --build-only completed but no verified Hermes.app was found"
  printf '%s\n' "$src"
}

desktop_target_app() {
  printf '%s/Applications/Hermes.app' "$HOME"
}

desktop_plist() {
  printf '%s/Library/LaunchAgents/%s.plist' "$HOME" "$DESKTOP_LABEL"
}

plist_status_json() {
  local plist="$1"
  "$(runtime_python)" - "$plist" "$DESKTOP_LABEL" "$(desktop_target_app)" <<'PY'
import json, plistlib, sys
path, label, target = sys.argv[1:4]
result = {"exists": False, "label_ok": False, "program_ok": False, "run_at_load": False, "keep_alive": False}
try:
    with open(path, "rb") as fh:
        data = plistlib.load(fh)
    result["exists"] = True
    result["label_ok"] = data.get("Label") == label
    result["program_ok"] = data.get("ProgramArguments") == ["/usr/bin/open", target]
    result["run_at_load"] = data.get("RunAtLoad") is True
    result["keep_alive"] = "KeepAlive" in data
except Exception:
    pass
print(json.dumps(result, separators=(",", ":")))
PY
}

launchagent_loaded() {
  command -v launchctl >/dev/null 2>&1 || return 1
  launchctl print "gui/$(id -u)/$DESKTOP_LABEL" >/dev/null 2>&1
}

render_desktop_plist() {
  local target="$1" tmp="$2"
  cat >"$tmp" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$DESKTOP_LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>$target</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
PLIST
}

cmd_configure_desktop() {
  resolve_runtime
  if [[ "$(uname -s)" != "Darwin" ]]; then
    printf '{"schema_version":1,"ok":true,"action":"configure-desktop","desktop":{"status":"not_applicable"}}\n'
    return 0
  fi
  [[ "$RUNTIME_DEFER" -eq 0 ]] || die_json deferred "$RUNTIME_DEFER_REASON"
  local src target plist changed=0 tmp plist_json
  src="$(ensure_desktop_source_app)"
  verify_desktop_app "$src" || die_json desktop_app_invalid "source Hermes.app did not pass package verification"
  target="$(desktop_target_app)"
  mkdir -p "$(dirname "$target")" "$HOME/Library/LaunchAgents"
  if [[ -e "$target" || -L "$target" ]]; then
    if [[ ! -L "$target" || "$(readlink "$target")" != "$src" ]]; then
      die_json desktop_conflict "refusing to replace existing ~/Applications/Hermes.app"
    fi
  else
    ln -s "$src" "$target"
    changed=1
  fi
  plist="$(desktop_plist)"
  tmp="$(mktemp "${plist}.tmp.XXXXXX")"
  render_desktop_plist "$target" "$tmp"
  if [[ ! -f "$plist" ]] || ! cmp -s "$tmp" "$plist"; then
    mv "$tmp" "$plist"
    changed=1
  else
    rm -f "$tmp"
  fi
  plist_json="$(plist_status_json "$plist")"
  [[ "$plist_json" == *'"label_ok":true'* && "$plist_json" == *'"program_ok":true'* && "$plist_json" == *'"run_at_load":true'* && "$plist_json" == *'"keep_alive":false'* ]] \
    || die_json desktop_plist_invalid "LaunchAgent plist did not read back with expected ProgramArguments/RunAtLoad"
  command -v launchctl >/dev/null 2>&1 || die_json desktop_launchctl_missing "launchctl not found"
  launchctl bootout "gui/$(id -u)/$DESKTOP_LABEL" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/$(id -u)" "$plist" >/dev/null 2>&1 \
    || launchctl load -w "$plist" >/dev/null 2>&1 \
    || die_json desktop_launchagent_failed "failed to bootstrap Hermes Desktop LaunchAgent"
  launchctl enable "gui/$(id -u)/$DESKTOP_LABEL" >/dev/null 2>&1 || true
  launchctl kickstart -k "gui/$(id -u)/$DESKTOP_LABEL" >/dev/null 2>&1 || true
  launchagent_loaded || die_json desktop_launchagent_unloaded "Hermes Desktop LaunchAgent did not load"
  /usr/bin/open "$target" >/dev/null 2>&1 || die_json desktop_open_failed "failed to launch Hermes Desktop app"
  printf '{"schema_version":1,"ok":true,"action":"configure-desktop","desktop":{"status":"configured","app_link":"%s","source_app":"%s","launchagent":"%s","config_changed":%s,"run_at_load":true,"keep_alive":false,"bundle_id":"%s","version":"%s","arch":"%s","codesign":"%s","executable":"%s","loaded":true}}\n' \
    "$(json_escape "$target")" "$(json_escape "$src")" "$(json_escape "$plist")" "$(json_bool "$changed")" \
    "$(json_escape "$DESKTOP_BUNDLE_ID")" "$(json_escape "${DESKTOP_APP_VERSION:-}")" "$(json_escape "$(uname -m)")" "$(json_escape "${DESKTOP_APP_CODESIGN:-}")" "$(json_escape "${DESKTOP_APP_EXECUTABLE:-}")"
}

cmd_status_desktop() {
  resolve_runtime
  if [[ "$(uname -s)" != "Darwin" ]]; then
    printf '{"schema_version":1,"ok":true,"action":"status-desktop","desktop":{"status":"not_applicable"}}\n'
    return 0
  fi
  local src target plist status="missing" source_verified=0 link_ok=0 plist_ok=0 loaded=0 plist_json
  src="$(desktop_source_app | tail -n 1 || true)"
  target="$(desktop_target_app)"
  plist="$(desktop_plist)"
  if [[ -n "$src" ]]; then source_verified=1; fi
  if [[ -L "$target" && -n "$src" && "$(readlink "$target")" == "$src" ]]; then link_ok=1; fi
  plist_json="$(plist_status_json "$plist")"
  if [[ "$plist_json" == *'"program_ok":true'* && "$plist_json" == *'"run_at_load":true'* && "$plist_json" == *'"keep_alive":false'* ]]; then
    plist_ok=1
  fi
  if launchagent_loaded; then loaded=1; fi
  if [[ -e "$target" && ! -L "$target" ]]; then
    status="conflict"
  elif [[ "$source_verified" -eq 0 ]]; then
    status="source_missing"
  elif [[ "$link_ok" -eq 1 && "$plist_ok" -eq 1 ]]; then
    status="configured"
  fi
  printf '{"schema_version":1,"ok":true,"action":"status-desktop","desktop":{"status":"%s","app_link":"%s","source_app":"%s","launchagent":"%s","source_verified":%s,"link_ok":%s,"plist_ok":%s,"loaded":%s,"run_at_load":%s,"keep_alive":false,"program_path":"/usr/bin/open","bundle_id":"%s","version":"%s","arch":"%s","codesign":"%s","executable":"%s"}}\n' \
    "$(json_escape "$status")" "$(json_escape "$target")" "$(json_escape "$src")" "$(json_escape "$plist")" \
    "$(json_bool "$source_verified")" "$(json_bool "$link_ok")" "$(json_bool "$plist_ok")" "$(json_bool "$loaded")" "$(json_bool "$plist_ok")" \
    "$(json_escape "$DESKTOP_BUNDLE_ID")" "$(json_escape "${DESKTOP_APP_VERSION:-}")" "$(json_escape "$(uname -m)")" "$(json_escape "${DESKTOP_APP_CODESIGN:-}")" "$(json_escape "${DESKTOP_APP_EXECUTABLE:-}")"
}

usage() {
  cat <<'USAGE'
usage: hermes-native-bots <command>

Commands:
  configure-api [--host 100.x.y.z] [--port 8642] [--restart-gateway]
  apply-api
  status-api
  verify-api
  configure-desktop
  status-desktop
  --version
USAGE
}

case "${1:-}" in
  configure-api) shift; cmd_configure_api "$@" ;;
  apply-api) shift; cmd_apply_api "$@" ;;
  status-api) shift; cmd_status_api "$@" ;;
  verify-api) shift; cmd_verify_api "$@" ;;
  configure-desktop) shift; cmd_configure_desktop "$@" ;;
  status-desktop) shift; cmd_status_desktop "$@" ;;
  --version) printf 'hermes-native-bots %s\n' "$VERSION" ;;
  -h|--help|"") usage ;;
  *) die_json usage "unknown command: $1" ;;
esac

#!/usr/bin/env bash
# hermes-fleet — dashboard for all Hermes hosts you've bootstrapped.
#
# Reads ~/.hermes/hosts/*.yaml (written by 99-register-host.sh during
# bootstrap) and prints a one-screen overview of the fleet. Optionally
# probes each host live over SSH for current uptime / load.
#
# Usage:
#   hermes-fleet                # static view from registry files
#   hermes-fleet --live         # also ssh into each reachable host
#   hermes-fleet --check-ssh    # verify registry SSH targets for every host
#   hermes-fleet --refresh      # re-snapshot THIS box's entry, then show
#   hermes-fleet <hostname>     # focus on one host (full yaml)
#   hermes-fleet --json         # raw JSON for scripting
#   hermes-fleet -h | --help

set -euo pipefail

HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
REGISTRY_DIR="$HERMES_HOME/hosts"
LIVE=0
CHECK_SSH=0
REFRESH=0
JSON=0
FOCUS=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --live)    LIVE=1; shift ;;
    --check-ssh|doctor) CHECK_SSH=1; shift ;;
    --refresh) REFRESH=1; shift ;;
    --json)    JSON=1; shift ;;
    -h|--help)
      grep -E '^#( |$)' "$0" | sed 's/^# \?//' | head -20
      exit 0 ;;
    -*) echo "unknown flag: $1" >&2; exit 2 ;;
    *)  FOCUS="$1"; shift ;;
  esac
done

if [[ ! -d "$REGISTRY_DIR" ]]; then
  echo "no hosts registry at $REGISTRY_DIR" >&2
  echo "bootstrap a host with hermes-host-bootstrap to populate it." >&2
  exit 1
fi

# Lightweight yaml reader — flat key extraction, indented one level.
# Good enough for the host snapshot format; not a general yaml parser.
get_field() {
  local file="$1" key="$2"
  awk -v key="$key" '
    $0 ~ "^"key":" {
      sub("^"key":[[:space:]]*", "")
      gsub(/^"|"$/, "")
      print
      exit
    }
    $0 ~ "^[[:space:]]+"key":" {
      sub("^[[:space:]]+"key":[[:space:]]*", "")
      gsub(/^"|"$/, "")
      print
      exit
    }
  ' "$file"
}

# Refresh this box's entry — re-run the relevant module of bootstrap.
if [[ "$REFRESH" -eq 1 ]]; then
  REPO_ROOT_FALLBACK="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  if [[ -f "$REPO_ROOT_FALLBACK/bootstrap.sh" ]]; then
    echo "▸ refreshing this host's snapshot…"
    "$REPO_ROOT_FALLBACK/bootstrap.sh" --only=99-register-host \
      --tier="${HERMES_DEFAULT_TIER:-recommended}" >/dev/null 2>&1 || \
      echo "  (refresh failed — try running ./bootstrap.sh --only=99-register-host manually)"
  else
    echo "  (can't locate bootstrap.sh — run --only=99-register-host directly)"
  fi
fi

# Focus mode: dump one host's full yaml.
if [[ -n "$FOCUS" ]]; then
  if [[ -f "$REGISTRY_DIR/$FOCUS.yaml" ]]; then
    cat "$REGISTRY_DIR/$FOCUS.yaml"
  else
    echo "no registry entry for '$FOCUS'" >&2
    echo "known hosts:" >&2
    for f in "$REGISTRY_DIR"/*.yaml; do
      [[ -f "$f" ]] || continue
      [[ "$f" == *.live.yaml ]] && continue
      basename "$f" .yaml | sed 's/^/  /'
    done >&2
    exit 1
  fi
  exit 0
fi

# JSON mode: emit array of objects.
if [[ "$JSON" -eq 1 ]]; then
  command -v python3 >/dev/null || { echo "python3 required for --json" >&2; exit 1; }
  python3 - <<'PY' "$REGISTRY_DIR"
import json, os, re, sys
d = sys.argv[1]
out = []
for fn in sorted(os.listdir(d)):
    if not fn.endswith(".yaml"): continue
    if fn.endswith(".live.yaml"): continue   # live heartbeat snapshots are per-host overlays, not separate hosts
    rec = {}
    section = None
    for raw in open(os.path.join(d, fn)):
        line = raw.rstrip()
        if not line or line.lstrip().startswith("#"): continue
        m = re.match(r"^(\w+):\s*$", line)
        if m: section = m.group(1); rec[section] = {}; continue
        m = re.match(r"^(\w+):\s*(.*)$", line)
        if m: rec[m.group(1)] = m.group(2).strip().strip('"'); section = None; continue
        m = re.match(r"^\s+(\w+):\s*(.*)$", line)
        if m and section: rec[section][m.group(1)] = m.group(2).strip().strip('"')
    out.append(rec)
print(json.dumps(out, indent=2))
PY
  exit 0
fi

# Default: tabular dashboard.
# Exclude *.live.yaml files (heartbeat snapshots that overlay the main per-host yaml).
HOST_COUNT=0
for f in "$REGISTRY_DIR"/*.yaml; do
  [[ -f "$f" ]] || continue
  [[ "$f" == *.live.yaml ]] && continue
  HOST_COUNT=$((HOST_COUNT + 1))
done
printf '\n  \033[1;36mHermes Fleet\033[0m  (%s hosts in registry)\n\n' "$HOST_COUNT"

resolve_host_target() {
  local name="$1" file="$2" user host
  if [[ -x "$(dirname "${BASH_SOURCE[0]}")/hermes-host-resolve" ]]; then
    "$(dirname "${BASH_SOURCE[0]}")/hermes-host-resolve" "$name"
    return 0
  fi
  if command -v hermes-host-resolve >/dev/null 2>&1; then
    hermes-host-resolve "$name"
    return 0
  fi
  user="$(get_field "$file" ssh_user)"
  [[ -n "$user" ]] || user="$(get_field "$file" default_user)"
  host="$(get_field "$file" ssh_host)"
  [[ -n "$host" ]] || host="$(get_field "$file" tailscale_ip)"
  [[ -n "$host" ]] || host="$(get_field "$file" tailscale_name)"
  [[ -n "$host" ]] || host="$name"
  if [[ -n "$user" && "$user" != "unknown" ]]; then
    printf '%s@%s\n' "$user" "$host"
  else
    printf '%s\n' "$host"
  fi
}

if [[ "$CHECK_SSH" -eq 1 ]]; then
  printf '  \033[1m%-18s %-28s %-10s %s\033[0m\n' HOST TARGET TCP SSH
  for f in "$REGISTRY_DIR"/*.yaml; do
    [[ -f "$f" ]] || continue
    [[ "$f" == *.live.yaml ]] && continue
    HOST=$(get_field "$f" hostname)
    [[ -n "$HOST" ]] || HOST="$(basename "$f" .yaml)"
    TARGET="$(resolve_host_target "$HOST" "$f")"
    TARGET_HOST="${TARGET#*@}"
    if [[ "$HOST" == "$(hostname -s)" ]]; then
      printf '  %-18s %-28s %-10s %s\n' "$HOST" "$TARGET" "self" "self"
      continue
    fi
    if nc -z -w 3 "$TARGET_HOST" 22 >/dev/null 2>&1; then
      TCP_OK="ok"
    else
      TCP_OK=$'\033[33mtimeout\033[0m'
    fi
    if ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new "$TARGET" 'hostname -s' >/dev/null 2>&1; then
      SSH_OK="ok"
    else
      SSH_OK=$'\033[33mfail\033[0m'
    fi
    printf '  %-18s %-28s %-10b %b\n' "$HOST" "$TARGET" "$TCP_OK" "$SSH_OK"
  done
  echo ""
  exit 0
fi

printf '  \033[1m%-18s %-10s %-8s %-22s %-10s %-12s %s\033[0m\n' \
  HOST TIER ROLE OS HERMES DISK NOTE

for f in "$REGISTRY_DIR"/*.yaml; do
  [[ -f "$f" ]] || continue
  [[ "$f" == *.live.yaml ]] && continue   # skip per-host heartbeat overlays
  HOST=$(get_field "$f" hostname)
  TIER=$(get_field "$f" tier)
  ROLE=$(get_field "$f" role)
  OS_PRETTY=$(get_field "$f" pretty)
  HERMES_V=$(get_field "$f" hermes | head -c 12)
  DISK=$(get_field "$f" disk_used_pct)
  NOTE_VAL=$(get_field "$f" note)

  # Truncate the OS string so the columns don't blow out
  OS_SHORT="$(echo "$OS_PRETTY" | cut -c1-22)"
  # Truncate note so the line stays one screen wide
  NOTE_SHORT="$(echo "${NOTE_VAL:-—}" | cut -c1-40)"

  # Color disk usage if >80%
  DISK_PCT_NUM="${DISK%\%}"
  if [[ "$DISK_PCT_NUM" =~ ^[0-9]+$ ]] && (( DISK_PCT_NUM > 80 )); then
    DISK_DISPLAY=$'\033[31m'"$DISK"$'\033[0m'
  else
    DISK_DISPLAY="$DISK"
  fi

  if [[ "$LIVE" -eq 1 ]] && [[ -n "$HOST" ]] && [[ "$HOST" != "$(hostname -s)" ]]; then
    # Best-effort SSH probe (BatchMode = no prompts, short timeout)
    SSH_TARGET="$(resolve_host_target "$HOST" "$f")"
    LIVE_DATA="$(ssh -o BatchMode=yes -o ConnectTimeout=3 "$SSH_TARGET" \
      'uptime -p 2>/dev/null; df -h / | awk "NR==2{print \$5}"' 2>/dev/null || echo "")"
    if [[ -n "$LIVE_DATA" ]]; then
      LIVE_UP="$(echo "$LIVE_DATA" | head -1)"
      LIVE_DISK="$(echo "$LIVE_DATA" | tail -1)"
      printf '  %-18s %-10s %-8s %-22s %-12s %-12s %s\n' \
        "$HOST" "$TIER" "$ROLE" "$OS_SHORT" "$HERMES_V" "$LIVE_DISK" "$LIVE_UP"
      continue
    else
      HERMES_V=$'\033[33m'"$HERMES_V (offline)"$'\033[0m'
    fi
  fi

  printf '  %-18s %-10s %-8s %-22s %-12s %-12b %s\n' \
    "$HOST" "$TIER" "$ROLE" "$OS_SHORT" "$HERMES_V" "$DISK_DISPLAY" "$NOTE_SHORT"
done

echo ""
echo "  Detail for one host:  hermes-fleet <hostname>"
echo "  Live SSH probe:       hermes-fleet --live"
echo "  SSH route check:      hermes-fleet --check-ssh"
echo "  Refresh this box:     hermes-fleet --refresh"
echo ""

#!/usr/bin/env bash
# Interim tier 2 updater approved by Dan 2026-11-23. Retire at lock cutover.
# Bash 3.2 / Python 3.9; parse the entire runner before invoking it.
set -euo pipefail
export PATH="${PATH:+$PATH:}$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

main() {
  local dry=0 lock_rc=0 canary_tool="" canary_version="" state="$HOME/.local/state/fleet-update-tools"
  local python=python3
  if [[ "$(uname -s)" == Darwin ]]; then
    if [[ -x /opt/homebrew/bin/python3 ]]; then python=/opt/homebrew/bin/python3
    elif [[ -x /usr/local/bin/python3 ]]; then python=/usr/local/bin/python3
    elif [[ "$(command -v python3)" == /usr/bin/python3 ]] && ! xcode-select -p >/dev/null 2>&1; then
      echo "fleet-update-tools: Python 3 required (install Homebrew Python)" >&2; return 1
    fi
  fi
  case "${1:-}" in
    --dry-run) dry=1; shift ;;
    --canary-check)
      [[ $# == 3 ]] || { echo 'Usage: fleet-update-tools --canary-check {claude|codex} VERSION' >&2; return 2; }
      canary_tool="$2"; canary_version="$3"; shift 3 ;;
    -h|--help) echo 'Usage: fleet-update-tools [--dry-run | --canary-check {claude|codex} VERSION]'; return 0 ;;
    '') ;;
    *) echo "Unknown argument: $1" >&2; return 2 ;;
  esac
  [[ $# == 0 ]] || { echo 'Unexpected arguments' >&2; return 2; }
  if [[ "$dry" == 0 && -z "$canary_tool" ]]; then
    mkdir -p "$state"
    exec 8>>"$state/lock"
    perl -MFcntl=:flock -e 'open(my $f, ">>&=", 8) or exit 2; exit(flock($f, LOCK_EX|LOCK_NB) ? 0 : 1)' || lock_rc=$?
    case "$lock_rc" in
      0) ;;
      1) echo busy; return 0 ;;
      *) echo 'error:lock_failed' >&2; return 1 ;;
    esac
  fi
  exec "$python" - "${BASH_SOURCE[0]}" "$dry" "$canary_tool" "$canary_version" <<'PY'
import ctypes
import datetime
import fcntl
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import urllib.request
import urllib.error

root = Path(sys.argv[1]).resolve().parent.parent
dry = sys.argv[2] == "1"
canary_tool, canary_version = sys.argv[3:5]
canary = bool(canary_tool)
home = Path.home()
state = home / ".local/state/fleet-update-tools"
env = dict(os.environ, LC_ALL="C", HOMEBREW_NO_AUTO_UPDATE="1", HOMEBREW_NO_ANALYTICS="1",
           npm_config_update_notifier="false")
packages = {"claude": "@anthropic-ai/claude-code", "codex": "@openai/codex"}
stable = re.compile(r"(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\Z")
version_token = re.compile(r"(?<![\w.-])(\d+\.\d+\.\d+(?:-[\w.-]+)?(?:\+[\w.-]+)?)(?![\w.-])")


class Failure(Exception):
    pass


stop_signal = None
termination_signals = {signal.SIGHUP, signal.SIGINT, signal.SIGTERM}


def interrupted(signum, frame):
    # The transaction blocks these signals. Outside it, finish the current
    # bounded read and write status before exiting.
    global stop_signal
    stop_signal = signum


for sig in termination_signals:
    signal.signal(sig, interrupted)


def run(command, cap=30, extra_env=None):
    # A timed-out npm must not leave workers installing while rollback starts.
    command_env = dict(env, **(extra_env or {}))
    with subprocess.Popen([str(arg) for arg in command], env=command_env,
                          stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, start_new_session=True,
                          pass_fds=() if dry else (8,),
                          preexec_fn=lambda: signal.pthread_sigmask(
                              signal.SIG_UNBLOCK, termination_signals)) as child:
        try:
            out, err = child.communicate(timeout=cap)
            return subprocess.CompletedProcess(command, child.returncode,
                                               out.decode(errors="replace"), err.decode(errors="replace"))
        except subprocess.TimeoutExpired as exc:
            failure = Failure("timeout")
            failure.stderr = (exc.stderr or b"").decode(errors="replace")
            raise failure
        finally:
            # Also reap descendants if their parent exited early. Keep fd 8 until
            # the group has received KILL, including on interruption.
            for sig in (signal.SIGTERM, signal.SIGKILL):
                try:
                    os.killpg(child.pid, sig)
                except ProcessLookupError:
                    break
                if sig == signal.SIGTERM:
                    try:
                        child.communicate(timeout=5)
                    except subprocess.TimeoutExpired:
                        pass
            child.wait()


def inside(path, directory):
    return path == directory or directory in path.parents


def npm_install(path, package):
    # Follow ~/.local/bin links to the actual npm prefix, not the npm on PATH.
    for parent in path.parents:
        if parent.name == "node_modules" and parent.parent.name == "lib":
            pkg = parent / package
            if inside(path, pkg):
                prefix = parent.parent.parent
                npm = prefix / "bin/npm"
                if npm.is_file() and os.access(str(npm), os.X_OK):
                    return npm, prefix
    return None, None


def brew_owns(name, entry, resolved):
    brew = shutil.which("brew")
    if not brew:
        return False
    package = "claude-code" if name == "claude" else "codex"
    for kind in ("--formula", "--cask"):
        try:
            listing = run([brew, "list", kind, package], cap=60)
        except Failure:
            return None
        if listing.returncode:
            continue
        for line in listing.stdout.splitlines():
            # Cask output may annotate a binary with a destination arrow.
            item = line.strip().split(" -> ", 1)[0]
            if item.startswith("/"):
                candidate = Path(item.rstrip("/"))
                if candidate == entry or candidate.resolve() == resolved:
                    return True
                if candidate.is_dir() and inside(resolved, candidate.resolve()):
                    return True
    return False


def in_use():
    process = run(["ps", "-axwwo", "uid=,args="])
    if process.returncode:
        raise Failure("process_check_failed")

    def agent_executable(token):
        return (Path(token).name in ("claude", "codex", "codex.js") or
                token.startswith(str(home / ".local/share/claude/versions") + "/") or
                any("/node_modules/" + pkg + "/" in token for pkg in packages.values()))

    value_flags = {"-r", "--require", "--import", "--loader", "--experimental-loader",
                   "--max-old-space-size", "--max_old_space_size", "--stack-size",
                   "--stack_size", "--conditions", "-C", "--icu-data-dir",
                   "--openssl-config", "--title", "--redirect-warnings",
                   "--diagnostic-dir", "--env-file", "--env-file-if-exists"}
    for line in process.stdout.splitlines():
        fields = line.strip().split(None, 1)
        if len(fields) != 2 or fields[0] != str(os.getuid()):
            continue
        try:
            args = shlex.split(fields[1])
        except ValueError:
            args = fields[1].split()
        if not args:
            continue
        if agent_executable(args[0]):
            return True
        if Path(args[0]).name not in ("node", "nodejs", "bash", "sh", "zsh"):
            continue
        skip_value = False
        for arg in args[1:]:
            if skip_value:
                skip_value = False
                continue
            if arg in ("-e", "--eval", "-p", "--print", "-c"):
                break  # Subsequent text is code or a prompt, not a script path.
            if arg in value_flags:
                skip_value = True
                continue
            if arg.startswith("-"):
                continue
            if agent_executable(arg):
                return True
            break
    return False


def health(entry, prefix=None):
    try:
        command = [entry, "--version"]
        if prefix is not None:
            node = prefix / "bin/node"
            # Scheduled shells need not have nvm/fnm's Node on PATH. Run a
            # Node-script CLI with its paired runtime, preserving PATH order.
            with entry.open("rb") as stream:
                shebang = stream.readline(128)
            if node.is_file() and re.match(br"^#!.*\bnode\b", shebang):
                command.insert(0, node)
        proc = run(command, cap=30)
    except (OSError, Failure):
        return None
    match = version_token.search(proc.stdout)
    return match.group(1) if proc.returncode == 0 and match else None


def npm_command(npm, *args):
    # npm's env-node shebang must use the Node paired with this installation.
    # Do not reorder PATH (callers and tests may intentionally supply shims).
    node = npm.parent / "node"
    resolved = npm.resolve()
    if not node.is_file() and resolved.name == "npm-cli.js":
        for parent in resolved.parents:
            if parent.name == "node_modules" and parent.parent.name == "lib":
                node = parent.parent.parent / "bin/node"
                break
    if node.is_file() and resolved.name == "npm-cli.js":
        return [node, resolved] + list(args)
    return [npm] + list(args)


def target_version(package):
    # Full packument includes publication times and deprecated release metadata.
    url = "https://registry.npmjs.org/" + package.replace("/", "%2f")
    try:
        with urllib.request.urlopen(url, timeout=60) as response:
            metadata = json.load(response)
    except (OSError, urllib.error.URLError):
        raise Failure("registry_failed")
    except (ValueError, TypeError):
        raise Failure("registry_invalid")
    try:
        latest_version = metadata["dist-tags"]["latest"]
        if not version_token.fullmatch(latest_version):
            raise ValueError("invalid latest")
        published = metadata["time"]
        versions = metadata["versions"]
        cutoff = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(hours=24)
        candidates = []
        latest_key = tuple(map(int, latest_version.split("."))) if stable.fullmatch(latest_version) else None
        for version, timestamp in published.items():
            if not stable.fullmatch(version) or version not in versions or versions[version].get("deprecated"):
                continue
            key = tuple(map(int, version.split(".")))
            if latest_key is not None and key > latest_key:
                continue
            when = datetime.datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
            if when.tzinfo is None:
                raise ValueError("missing timezone")
            if when <= cutoff:
                candidates.append((key, version))
        return max(candidates)[1] if candidates else None
    except (KeyError, ValueError, TypeError, AttributeError):
        raise Failure("registry_invalid")


def off_path(name):
    patterns = [".nvm/versions/node/*/bin/" + name,
                ".local/share/fnm/node-versions/*/installation/bin/" + name,
                ".fnm/node-versions/*/installation/bin/" + name,
                ".local/share/claude/versions/*" if name == "claude" else ".npm-global/bin/codex",
                ".npm-global/bin/" + name, "tools/*/bin/" + name]
    return any(any(home.glob(pattern)) for pattern in patterns)


def remove(path):
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.exists():
        shutil.rmtree(path)


def copy_entry(source, target):
    if source.is_symlink():
        target.symlink_to(os.readlink(source))
    elif source.is_dir():
        shutil.copytree(source, target, symlinks=True)
    else:
        shutil.copy2(source, target)


def atomic_exchange(left, right):
    # Directory replacement must have no missing-path window. Linux and macOS
    # expose atomic exchanges for nonempty directories through libc.
    libc = ctypes.CDLL(None, use_errno=True)
    if sys.platform == "darwin":
        rename = libc.renamex_np
        rename.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint]
        args = (os.fsencode(left), os.fsencode(right), 2)  # RENAME_SWAP
    else:
        rename = libc.renameat2
        rename.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int,
                           ctypes.c_char_p, ctypes.c_uint]
        args = (-100, os.fsencode(left), -100, os.fsencode(right), 2)  # RENAME_EXCHANGE
    rename.restype = ctypes.c_int
    if rename(*args):
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))


def exchange_supported(parent):
    # Check the actual prefix filesystem before allowing a destructive install.
    with tempfile.TemporaryDirectory(prefix=".fleet-probe-", dir=str(parent)) as tmp:
        left, right = Path(tmp) / "left", Path(tmp) / "right"
        left.mkdir()
        right.mkdir()
        (left / "probe").touch()
        (right / "probe").touch()
        try:
            atomic_exchange(left, right)
            return True
        except (OSError, AttributeError):
            return False


def restore_entry(source, target):
    target.parent.mkdir(parents=True, exist_ok=True)
    stage = Path(tempfile.mkdtemp(prefix=".fleet-restore-", dir=str(target.parent)))
    try:
        copy_entry(source, stage / "ready")
        if target.is_dir() and not target.is_symlink():
            atomic_exchange(stage / "ready", target)
        else:
            os.replace(stage / "ready", target)
    finally:
        shutil.rmtree(stage)


def save_backup(name, entry, resolved, prefix, old):
    directory = state / "backup" / name
    directory.parent.mkdir(parents=True, exist_ok=True)
    stage = Path(tempfile.mkdtemp(prefix="." + name + "-", dir=str(directory.parent)))
    try:
        if prefix is not None:
            copy_entry(prefix / "lib/node_modules" / packages[name], stage / "package")
            copy_entry(prefix / "bin" / name, stage / "bin")
        else:
            # Dereference: installers may prune versions/ during the update.
            shutil.copy2(resolved, stage / old)
        copy_entry(entry, stage / "entry")
        (stage / "version").write_text(old + "\n")
        remove(directory)
        os.replace(stage, directory)
    finally:
        remove(stage)
    return directory


def install_diagnostics(row, stderr):
    lines = [line for line in stderr.splitlines()
             if not re.search(r"token|auth|key|password", line, re.I)]
    if lines:
        row.setdefault("install_stderr", []).extend(line[:1000] for line in lines[-20:])
        row["install_stderr"] = row["install_stderr"][-20:]


def prepare_canary(name):
    global home, state, env
    original = shutil.which(name)
    if not original:
        raise Failure("canary_tool_missing")
    resolved = Path(original).resolve()
    npm, prefix = npm_install(resolved, packages[name])
    native = name == "claude" and inside(resolved, home / ".local/share/claude/versions")
    if not native and not npm:
        raise Failure("canary_unsupported_install")
    sandbox = Path(tempfile.mkdtemp(prefix="fleet-tools-canary-"))
    home = sandbox / "home"
    home.mkdir()
    state = home / ".local/state/fleet-update-tools"
    state.mkdir(parents=True)
    fd = os.open(str(state / "lock"), os.O_CREAT | os.O_RDWR, 0o600)
    if fd != 8:
        os.dup2(fd, 8)
        os.close(fd)
    fcntl.flock(8, fcntl.LOCK_EX | fcntl.LOCK_NB)
    local_bin = home / ".local/bin"
    local_bin.mkdir(parents=True)
    if native:
        copied = home / ".local/share/claude/versions" / resolved.name
        copied.parent.mkdir(parents=True)
        shutil.copy2(resolved, copied)
        (local_bin / name).symlink_to(copied)
    else:
        copied_prefix = home / "prefix"
        (copied_prefix / "bin").mkdir(parents=True)
        pkg = packages[name]
        target = copied_prefix / "lib/node_modules" / pkg
        target.parent.mkdir(parents=True)
        # Dereference links in the sandbox so no canary writes reach the source.
        shutil.copytree(prefix / "lib/node_modules" / pkg, target, symlinks=False)
        copied = copied_prefix / resolved.relative_to(prefix)
        (copied_prefix / "bin" / name).symlink_to(copied)
        (local_bin / name).symlink_to(copied_prefix / "bin" / name)
        npm_source = npm.resolve()
        if npm_source.name == "npm-cli.js":
            npm_root = npm_source.parent.parent
            npm_target = copied_prefix / "lib/node_modules/npm"
            shutil.copytree(npm_root, npm_target, symlinks=False)
            (copied_prefix / "bin/npm").symlink_to(npm_target / "bin/npm-cli.js")
        else:
            shutil.copy2(npm_source, copied_prefix / "bin/npm")
        node = prefix / "bin/node"
        if not node.is_file():
            node = Path(shutil.which("node") or "/missing-node")
        shutil.copy2(node, copied_prefix / "bin/node")
    env.update(HOME=str(home), XDG_CONFIG_HOME=str(home / ".config"),
               XDG_CACHE_HOME=str(home / ".cache"), XDG_DATA_HOME=str(home / ".local/share"),
               XDG_STATE_HOME=str(home / ".local/state"), CLAUDE_CONFIG_DIR=str(home / ".claude"),
               npm_config_cache=str(home / ".npm"), npm_config_userconfig=str(home / ".npmrc"),
               npm_config_globalconfig=str(home / ".global-npmrc"),
               npm_config_prefix=str(home / "prefix"),
               PATH=str(local_bin) + ":" + str(home / "prefix/bin") + ":" + env["PATH"])
    os.environ["HOME"] = str(home)
    print("Canary HOME (retained for inspection): " + str(home), flush=True)
    return local_bin / name


def inspect(row):
    name = row["name"]
    found = str(canary_entry) if canary else shutil.which(name)
    if not found:
        if off_path(name):
            row["result"] = "held:not_on_path"
        return
    entry = Path(found).absolute()
    resolved = entry.resolve()
    row["path"] = str(resolved)
    npm, prefix = npm_install(resolved, packages[name])
    if name == "claude" and inside(resolved, home / ".local/share/claude/versions"):
        row["method"] = "native"
    elif npm:
        row["method"] = "npm"
    else:
        row["method"] = "unknown"
    if (home / ".config/fleet-update/pause-tools").exists():
        row["result"] = "paused"
        return
    if dry:
        row["result"] = "held:dry_run"
        print(name + ": would check ownership, idle state and npm's 24-hour-soaked target; no commands run")
        return
    if in_use():
        row["result"] = "deferred:in_use"
        return
    owned = False if canary else brew_owns(name, entry, resolved)
    if owned is None:
        row["result"] = "held:brew_unknown"
        return
    if owned:
        row.update(method="brew", result="held:brew_managed")
        return
    if row["method"] == "unknown":
        row["result"] = "held:unknown_install"
        return
    writable = ([prefix / "lib/node_modules", prefix / "lib/node_modules" / packages[name],
                 (prefix / "lib/node_modules" / packages[name]).parent, prefix / "bin"]
                if prefix else [entry.parent, resolved.parent])
    if not all(os.access(path, os.W_OK) for path in writable):
        row["result"] = "held:not_writable"
        return
    old = health(entry, prefix)
    if old is None or not stable.fullmatch(old):
        raise Failure("previous_version_unknown")
    row["from"] = row["to"] = old
    target = canary_version if canary else target_version(packages[name])
    row["target"] = target
    if target is None:
        row["result"] = "held:no_soaked_version"
        return
    if canary and target == old:
        raise Failure("canary_requires_different_version")
    if not canary and tuple(map(int, old.split("."))) >= tuple(map(int, target.split("."))):
        row["result"] = "current"
        return
    if (home / ".config/fleet-update/pause-tools").exists():
        row["result"] = "paused"
        return
    if in_use():
        row["result"] = "deferred:in_use"
        return

    if stop_signal:
        row["result"] = "held:interrupted"
        return
    if prefix and not exchange_supported((prefix / "lib/node_modules" / packages[name]).parent):
        row["result"] = "held:atomic_restore_unavailable"
        return
    backup = save_backup(name, entry, resolved, prefix, old)
    # The backup copy can take a while; re-check that no agent started meanwhile.
    if in_use():
        row["result"] = "deferred:in_use"
        return

    def install(version, fallback=False):
        if row["method"] == "native":
            # The saved executable survives vendor pruning of versions/.
            command = [backup / old if fallback else resolved, "install", version]
        else:
            command = npm_command(npm, "i", "-g", packages[name] + "@" + version,
                                  "--prefix", str(prefix))
            if fallback:
                command.append("--prefer-offline")
        proc = run(command, cap=300)
        install_diagnostics(row, proc.stderr)
        return proc.returncode == 0

    previous_mask = signal.pthread_sigmask(signal.SIG_BLOCK, termination_signals)
    try:
        if stop_signal or termination_signals & signal.sigpending():
            row["result"] = "held:interrupted"
            return
        reason = "install_failed"
        try:
            installed = install(target)
            actual = health(entry, prefix)
            if termination_signals & signal.sigpending() or stop_signal:
                reason = "interrupted"
            elif installed:
                reason = "health_check_failed"
                if actual == target:
                    if canary:
                        row["canary_target_verified"] = True
                        reason = "canary_forced_failure"
                    else:
                        row.update(to=target, result="updated {}->{}".format(old, target))
                        return
        except Exception as exc:
            install_diagnostics(row, getattr(exc, "stderr", str(exc)))
        # If a failed installer left the old CLI healthy, do not mutate it again.
        if health(entry, prefix) == old:
            row.update(to=old, result="rolled_back:" + reason)
            return
        row["to"] = None
        try:
            if prefix:
                restore_entry(backup / "package", prefix / "lib/node_modules" / packages[name])
                restore_entry(backup / "bin", prefix / "bin" / name)
                if entry != prefix / "bin" / name:
                    restore_entry(backup / "entry", entry)
            else:
                # Repoint offline first, even if the installer removed old versions.
                saved_link = backup / "restore-link"
                saved_link.symlink_to(backup / old)
                try:
                    restore_entry(saved_link, entry)
                finally:
                    saved_link.unlink()
            if health(entry, prefix) == old:
                if not prefix:
                    # Keep future detection and backups on the vendor layout.
                    restore_entry(backup / old, resolved)
                    restored_link = backup / "restore-link"
                    restored_link.symlink_to(resolved)
                    try:
                        restore_entry(restored_link, entry)
                    finally:
                        restored_link.unlink()
                    if health(entry) != old:
                        raise Failure("native_restore_health_failed")
                row.update(to=old, result="rolled_back:" + reason)
                return
        except Exception as exc:
            install_diagnostics(row, getattr(exc, "stderr", str(exc)))
        try:
            if install(old, fallback=True) and health(entry, prefix) == old:
                row.update(to=old, result="rolled_back:" + reason)
                return
        except Exception as exc:
            install_diagnostics(row, getattr(exc, "stderr", str(exc)))
        row["result"] = "error:rollback_failed"
    finally:
        # Delivery is deferred until the transaction has committed or recovered.
        signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)


def atomic_write(path, content):
    fd, temporary = tempfile.mkstemp(prefix="." + path.name + ".", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def checkout_version():
    # Read Git metadata directly: no Git invocation (or macOS CLT dialog).
    try:
        gitdir = root / ".git"
        if gitdir.is_file():
            gitdir = (root / gitdir.read_text().strip().split("gitdir: ", 1)[1]).resolve()
        head = (gitdir / "HEAD").read_text().strip()
        if not head.startswith("ref: "):
            return head
        ref = head[5:]
        common = gitdir
        if (gitdir / "commondir").exists():
            common = (gitdir / (gitdir / "commondir").read_text().strip()).resolve()
        if (common / ref).exists():
            return (common / ref).read_text().strip()
        for line in (common / "packed-refs").read_text().splitlines():
            if line.endswith(" " + ref):
                return line.split()[0]
    except (OSError, IndexError):
        pass
    return "unknown"


canary_entry = None
if canary:
    if canary_tool not in packages or not stable.fullmatch(canary_version):
        print("Canary requires claude|codex and a stable X.Y.Z version", file=sys.stderr)
        sys.exit(2)
    try:
        canary_entry = prepare_canary(canary_tool)
    except (Failure, OSError) as exc:
        print("fleet-update-tools: " + str(exc), file=sys.stderr)
        sys.exit(1)

report = dict(host=socket.gethostname(),
              ran_at=datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
              version=checkout_version(), tools=[])
try:
    for name in ([canary_tool] if canary else packages):
        row = dict(name=name, path=None, method=None, result="skipped:absent",
                   **{"from": None, "to": None, "target": None})
        report["tools"].append(row)
        try:
            if stop_signal:
                row["result"] = "held:interrupted"
            else:
                inspect(row)
        except Failure as exc:
            row["result"] = "error:" + str(exc)
        except Exception:
            row["result"] = "error:inspection_failed"
        print("{}: {}".format(name, row["result"]))
finally:
    if not dry:
        try:
            atomic_write(state / "status.json", json.dumps(report, indent=2) + "\n")
            log = state / "log"
            lines = log.read_text().splitlines() if log.exists() else []
            lines.append(json.dumps(report, separators=(",", ":")))
            atomic_write(log, "\n".join(lines[-500:]) + "\n")
        except (OSError, ValueError):
            print("fleet-update-tools: error:status_failed", file=sys.stderr)
            sys.exit(1)
if stop_signal:
    sys.exit(128 + stop_signal)
if canary:
    row = report["tools"][0]
    passed = row["result"] == "rolled_back:canary_forced_failure" and row.get("canary_target_verified")
    print("Canary " + ("PASS" if passed else "FAIL") + "; evidence: " + str(state / "status.json"))
    sys.exit(0 if passed else 1)
sys.exit(1 if any(row["result"].startswith("error:") for row in report["tools"]) else 0)
PY
}
main "$@"; exit $?

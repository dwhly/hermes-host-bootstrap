#!/usr/bin/env python3
"""hmw-ledger: a durable record of every herdr tab, independent of herdr's own state.

Herdr forgets tabs whenever its session.json is cleared (shutdown race), a
workspace is closed, or memguard ends the Hermes inside a tab. The ledger never
drops an entry on its own: a tab that disappears is marked lost with a reason,
and stays restorable until you `forget` it (old entries are pruned after weeks).

  hmw-ledger update            reconcile the ledger with live herdr (the hmw snapshot loop runs this)
  hmw-ledger status            live vs lost tabs
  hmw-ledger restore [NAME..]  recreate lost tabs (all if no names) and resume Hermes
  hmw-ledger forget NAME..     stop tracking lost tabs
  hmw-ledger update --auto     also restore tabs lost to a server restart (verified sessions only)

Session ids, best first: hmw lease map (exact) > herdr agent_session whose title
matches the pane title (verified) > a unique session whose title matches the
pane title > herdr agent_session alone (unverified; it can be stale, which is
how memguard logged a wrong id on 2026-11-03). Automatic restore never uses an
unverified id.

Safety: a conversation that is running anywhere (lease, --resume argument, a
live pane, or recent activity) is never resumed again; restores hold hmw's own
restore lock; a failed resume closes only a tab the ledger created; a tab is
reused only when it is provably the same, still-bare tab.
"""
# Python 3.9-compatible: macOS hosts run this with the system python3.
import fcntl, json, os, re, signal, sqlite3, subprocess, sys, time

SESSION = os.environ.get("HERDR_SESSION", "ws")
HOME = os.path.expanduser("~")
HERMES_HOME = os.environ.get("HERMES_HOME") or os.path.join(HOME, ".hermes")
STATE = os.environ.get("HMW_STATE_DIR", os.path.join(HERMES_HOME, "hmw"))
LEDGER = os.path.join(STATE, f"{SESSION}.ledger.json")
SNAP = os.path.join(STATE, f"{SESSION}.panes.json")
DB = os.path.join(HERMES_HOME, "state.db")
LEASES = os.path.join(HERMES_HOME, "runtime", "active_sessions.json")
LOG_DIR = os.environ.get("HMW_LOG_DIR") or os.path.join(HERMES_HOME, "logs")
RESTORE_LOCK = os.path.join(LOG_DIR, f"hmw-{SESSION}.restore.lock")   # shared with hmw's own restore
GRACE = 300            # seconds after a server restart before tabs still missing count as gone
RESTORE_WAIT = 600     # a restore Hermes has not confirmed by then is undone and stays restorable
RECENT = 600           # a session active this recently may be open somewhere: never resume it
AGENT_START_MS = int(os.environ.get("HMW_LEDGER_AGENT_START_MS") or 120000)   # override: tests only
MARK = "\u25cf "       # "● ": unseen finished work carried across a herdr restart
SID_RE = re.compile(r"^\d{8}_\d{6}_[0-9a-f]{6}$")
VERIFIED = ("lease", "herdr-verified", "title-match")
SHELLS = {"sh", "bash", "zsh", "dash", "fish", "ksh", "tcsh", "csh"}
DAY = 86400
PROC = os.environ.get("HMW_PROC_ROOT") or "/proc"      # override: tests only (as in hermes-workspace)
now = float(os.environ.get("HMW_LEDGER_NOW") or time.time())   # override: tests only


class Ambiguous(Exception):
    """A herdr call timed out: it may or may not have happened."""


def herdr(*args, check=True, timeout=60):
    try:
        r = subprocess.run(["herdr", "--session", SESSION, *args], capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise Ambiguous(f"herdr {' '.join(args[:2])}: timed out after {timeout}s")
    if r.returncode != 0:
        if check:
            raise RuntimeError(f"herdr {' '.join(args)}: {r.stderr.strip() or r.stdout.strip()}")
        return None
    return json.loads(r.stdout)["result"] if r.stdout.strip().startswith("{") else {}


def db():
    try:
        return sqlite3.connect(f"file:{DB}?mode=ro", uri=True)
    except sqlite3.Error:
        # No Hermes state on this host yet: record tabs, verify no session ids.
        c = sqlite3.connect(":memory:")
        c.execute("create table sessions (id text, source text, title text, end_reason text, "
                  "parent_session_id text, started_at real, last_activity_at real)")
        return c


def leaf(c, sid):
    """Follow compression continuations only; other children (side/background sessions) are not the tab."""
    seen = set()
    while sid and sid not in seen:
        seen.add(sid)
        r = c.execute("select end_reason from sessions where id=?", (sid,)).fetchone()
        if not r or r[0] != "compression":
            break
        k = c.execute("select id from sessions where parent_session_id=? order by started_at desc limit 1", (sid,)).fetchone()
        if not k:
            break
        sid = k[0]
    return sid


def lineage(c, sid):
    """sid plus all ancestors, so a compressed child matches its parent's entry."""
    out, seen = set(), set()
    while sid and sid not in seen:
        seen.add(sid); out.add(sid)
        r = c.execute("select parent_session_id from sessions where id=?", (sid,)).fetchone()
        sid = r[0] if r else None
    return out


def title_of(c, sid):
    r = c.execute("select coalesce(title,'') from sessions where id=?", (sid,)).fetchone()
    return r[0] if r else ""


def by_title(c, pane_title):
    """Unique interactive session whose title matches the pane title prefix (leaf of its chain)."""
    key = norm(pane_title)
    if len(key) < 8:
        return None
    rows = c.execute("select id, title from sessions where source in ('tui','cli') and title is not null "
                     "order by last_activity_at desc limit 400").fetchall()
    hits = {leaf(c, i) for i, t in rows if norm(t).startswith(key[:24])}
    return hits.pop() if len(hits) == 1 else None


def norm(t):
    t = re.sub(r"^[^\w]+", "", t or "")          # status glyphs
    return t.split("…")[0].split(" · ")[0].strip().lower()


def server_start():
    """Start time (epoch float) of this session's herdr server; a pid string if unknown; None if not found."""
    r = subprocess.run(["pgrep", "-f", f"herdr --session {SESSION} server"], capture_output=True, text=True)
    pids = r.stdout.split()
    if not pids:
        return None
    pid = pids[0]
    try:   # Linux: btime + starttime ticks
        ticks = int(open(f"{PROC}/{pid}/stat").read().rsplit(")", 1)[1].split()[19])
        btime = next(int(l.split()[1]) for l in open(f"{PROC}/stat") if l.startswith("btime"))
        return float(round(btime + ticks / os.sysconf("SC_CLK_TCK")))
    except (OSError, ValueError, IndexError, StopIteration):
        pass
    try:   # macOS (and Linux without /proc): ps lstart, e.g. "Fri Nov  6 14:01:02 2026"
        out = subprocess.run(["ps", "-o", "lstart=", "-p", pid], capture_output=True, text=True,
                             timeout=10, env=dict(os.environ, LC_ALL="C")).stdout.strip()
        return float(time.mktime(time.strptime(" ".join(out.split()), "%a %b %d %H:%M:%S %Y")))
    except (OSError, ValueError, subprocess.SubprocessError):
        return pid


def load():
    try:
        return json.load(open(LEDGER))
    except (OSError, ValueError):
        return {"version": 1, "session": SESSION, "entries": [], "server_start": None}


def save(led):
    os.makedirs(STATE, exist_ok=True)
    tmp = f"{LEDGER}.tmp.{os.getpid()}"
    with open(tmp, "w") as fh:
        json.dump(led, fh, indent=1)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, LEDGER)


def lease_map():
    try:
        d = json.load(open(SNAP))
    except (OSError, ValueError):
        return {}
    if now - d.get("saved_at", 0) > 900:
        return {}
    return {p["pane_id"]: p["session_id"] for p in d.get("panes", []) if p.get("session_id")}


def foreground(pane_id):
    """argv lists of the pane's foreground processes; None when herdr cannot say."""
    try:
        info = herdr("pane", "process-info", "--pane", pane_id, check=False, timeout=20)
        procs = (info or {}).get("process_info", {}).get("foreground_processes")
    except (Ambiguous, ValueError, AttributeError):
        return None
    if not isinstance(procs, list):
        return None
    return [p.get("argv") for p in procs if isinstance(p, dict) and isinstance(p.get("argv"), list)]


def is_shell(argv):
    return bool(argv) and os.path.basename(str(argv[0])).lstrip("-") in SHELLS


# ── Hermes invocation parser: VERBATIM from scripts/hermes-workspace (hmw), which is the
# reviewed definition of "this process is an interactive Hermes chat". A test keeps them equal.
# BEGIN hmw-parser
def hermes_launcher_code(code):
    # Hermes 0.21+ managed launchers exec the store Python as
    # `python3 -I -c <bootstrap>`. Accept only the published Hermes CLI
    # entry shapes (hermes_cli/_launchers.py); arbitrary -c code, and
    # sibling entry points such as hermes-acp, stay rejected.
    lines = code.strip().splitlines()
    if not lines:
        return False
    if (lines[-1] == "sys.exit(main())" and "import hermes_bootstrap" in lines
            and "from hermes_cli.main import main" in lines):
        return True
    statements = [part.strip() for part in code.strip().split(";")]
    # (chr(39) is a single quote; this code lives in a single-quoted shell string.)
    entry = "runpy.run_module({0}hermes_cli.main{0}, run_name={0}__main__{0}, alter_sys=True)"
    return "import hermes_bootstrap" in statements and statements[-1] == entry.format(chr(39))

def hermes_args(argv):
    executable = os.path.basename(argv[0])
    if executable == "hermes":
        return argv[1:]
    if not re.fullmatch(r"python(?:[0-9]+(?:\.[0-9]+)*)?", executable):
        return None
    # Parse interpreter options, not arbitrary later tokens that happen
    # to say hermes. In particular, -c code and other scripts are not it.
    i = 1
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            i += 1
            break
        if not arg.startswith("-"):
            break
        if arg == "--check-hash-based-pycs":
            if argv[i + 1:i + 2] not in (["default"], ["always"], ["never"]):
                return None
            i += 2
            continue
        if arg == "-" or arg.startswith("--"):
            return None
        # Python groups short flags and allows attached m/W/X operands.
        # An operand consumes the rest of this token, never more flags.
        j = 1
        while j < len(arg):
            option = arg[j]
            if option in "mWX":
                value = arg[j + 1:]
                if not value:
                    i += 1
                    if i >= len(argv) or not argv[i]:
                        return None
                    value = argv[i]
                if option == "m":
                    return argv[i + 1:] if value == "hermes_cli.main" else None
                break
            if option == "c":
                value = arg[j + 1:]
                if not value:
                    i += 1
                    if i >= len(argv):
                        return None
                    value = argv[i]
                return argv[i + 1:] if hermes_launcher_code(value) else None
            # -i keeps Python alive at its REPL after Hermes exits. It
            # cannot prove live Hermes even when PID/identity are retained.
            if option not in "bBdEIOPqsSuvx":
                return None
            j += 1
        i += 1
    if i < len(argv) and os.path.basename(argv[i]) == "hermes":
        return argv[i + 1:]
    return None

def interactive_chat(args):
    if args is None:
        return False
    # Bare hermes defaults to chat, as do its profile/resume shortcuts.
    # Use known option arities, so values like --resume setup are not
    # confused with subcommands. Unknown modes fail closed. Query/oneshot
    # invocations are deliberately excluded (behavior varies by version).
    values = {"--profile", "-p", "--model", "-m", "--provider", "--reasoning",
              "--toolsets", "-t", "--skills", "-s", "--resume", "-r", "--in"}
    switches = {"--tui", "--cli", "--dev", "--worktree", "-w", "--yolo",
                "--pass-session-id", "--ignore-user-config", "--ignore-rules",
                "--safe-mode", "--accept-hooks", "--no-restore-cwd"}
    chat_values = {"--source", "--max-turns", "--run-budget"}
    chat_switches = {"--checkpoints", "--create-if-missing", "--verbose", "-v"}
    chat = False
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "chat" and not chat:
            chat = True
            i += 1
            continue
        # -w can lead a group; -v is safe only after explicit chat.
        # Peel switches; the first value option owns the remaining suffix.
        # Profile -p is a launcher shortcut, not a parser group member.
        group_switches = "wv" if chat else "w"
        while len(arg) > 2 and arg[0] == "-" and arg[1] in group_switches:
            if arg[2] not in group_switches + "cmrst":
                return False
            arg = "-" + arg[2:]
        option, equal, value = arg.partition("=")
        # Only known single-letter value options may consume a suffix.
        # Do not interpret arbitrary substrings or one-shot -q/-z as chat.
        if len(arg) > 2 and (arg[:2] in values or arg[:2] == "-c"):
            option, equal, value = arg[:2], "=", arg[2:]
            if value.startswith("="):
                value = value[1:]
        if option in values or (chat and option in chat_values):
            if equal:
                if not value:
                    return False
            else:
                i += 1
                if i >= len(args) or not args[i] or args[i].startswith("-"):
                    return False
        elif option in ("--continue", "-c"):
            if equal and not value:
                return False
            if not equal and i + 1 < len(args) and not args[i + 1].startswith("-"):
                i += 1
        elif not equal and (option in switches or (chat and option in chat_switches)):
            pass
        else:
            return False
        i += 1
    return True
# END hmw-parser


def hermes_in(fg):
    """True/False when the foreground is known to hold / not hold an interactive Hermes; None if unknown."""
    if fg is None:
        return None
    return any(all(isinstance(x, str) for x in a) and interactive_chat(hermes_args(a)) for a in fg if a)


def live_tabs(c):
    panes = herdr("pane", "list")["panes"]
    tabs = {t["tab_id"]: t for t in herdr("tab", "list")["tabs"]}
    wss = {w["workspace_id"]: w for w in herdr("workspace", "list")["workspaces"]}
    leases = lease_map()
    out = {}
    for p in panes:
        tid = p["tab_id"]
        tinfo = tabs.get(tid) or {}
        label = tinfo.get("label")
        if isinstance(label, str) and label.startswith(MARK):
            label = label[len(MARK):]          # our marker is display-only, never the name
        t = out.setdefault(tid, {"tab_id": tid, "workspace_id": p["workspace_id"],
                                 "workspace_label": (wss.get(p["workspace_id"]) or {}).get("label"),
                                 "tab_label": label, "shown_label": tinfo.get("label"),
                                 "status": tinfo.get("agent_status"), "focused": tinfo.get("focused") is True,
                                 "panes": []})
        agent = p.get("agent")
        if agent == "hermes" and hermes_in(foreground(p["pane_id"])) is False:
            agent = None     # herdr keeps the agent identity after Hermes exits; the foreground says it is gone
        sid, src = None, None
        hint = (p.get("agent_session") or {}).get("value")
        if p["pane_id"] in leases and agent:
            sid, src = leases[p["pane_id"]], "lease"
        elif agent == "hermes" and isinstance(hint, str) and SID_RE.match(hint):
            lt = title_of(c, leaf(c, hint))
            ok = lt and norm(lt)[:18] == norm(p.get("terminal_title_stripped"))[:18]
            sid, src = hint, ("herdr-verified" if ok else "herdr-unverified")
            if not ok:
                alt = by_title(c, p.get("terminal_title_stripped"))
                if alt:
                    sid, src = alt, "title-match"
        t["panes"].append({"pane_id": p["pane_id"], "pane_label": p.get("label"), "cwd": p.get("cwd"),
                           "agent": agent, "session_id": sid, "sid_source": src,
                           "title": p.get("terminal_title_stripped")})
    return out


def memguard_ended_sids(since):
    sids = set()
    try:
        r = subprocess.run(["journalctl", "-u", "hermes-memguard", "--since", f"@{int(since)}", "-o", "cat", "--no-pager"],
                           capture_output=True, text=True, timeout=30)
        sids.update(re.findall(r"--resume (\d{8}_\d{6}_[0-9a-f]{6})", r.stdout))
    except Exception:
        pass
    return sids


def verified(q):
    return (q.get("sid_source") or "").replace("(kept)", "") in VERIFIED


def new_entry(t, **kw):
    e = {"id": f"{int(now)}-{t['tab_id']}", "first_seen": now, "last_seen": now, "state": "live",
         "live_tab_id": t["tab_id"], "workspace_label": t["workspace_label"], "tab_label": t["tab_label"],
         "panes": t["panes"], "lost_at": None, "lost_reason": None, "status": t["status"]}
    e.update(kw)
    return e


def split_off(led, e, panes, reason):
    """Keep recorded Hermes panes that are no longer in the tab as their own lost entries."""
    for k, q in enumerate(panes, 2):
        led["entries"].append({"id": f"{e['id']}~{q.get('pane_id') or k}~{int(now)}", "first_seen": e.get("first_seen"),
                               "last_seen": now, "state": "lost", "live_tab_id": None,
                               "workspace_label": e.get("workspace_label"),
                               "tab_label": f"{e.get('tab_label') or 'tab'}-{q.get('pane_label') or k}",
                               "panes": [q], "lost_at": now, "lost_reason": reason,
                               "lost_server": e.get("lost_server"), "status": None})


def prune(led):
    keep = []
    for e in led["entries"]:
        age = now - (e.get("lost_at") or e.get("last_seen") or now)
        hermes = any(q.get("session_id") for q in e.get("panes") or [])
        if e["state"] == "forgotten" and age > 30 * DAY:
            continue
        if e["state"] == "lost" and age > (90 if hermes else 7) * DAY:
            continue
        keep.append(e)
    led["entries"] = keep


def match_panes(c, old, live):
    """Pair each live pane with its recorded pane: same conversation, then same pane id, then
    same label; by position only when the layout is unchanged and no conversation says otherwise."""
    used, out = set(), []
    same_layout = len(old) == len(live)
    for i, q in enumerate(live):
        free = [k for k in range(len(old)) if k not in used]
        lin = lineage(c, leaf(c, q["session_id"])) if q["session_id"] else set()
        j = None
        for test in (lambda o: bool(lin) and bool(o.get("session_id")) and leaf(c, o["session_id"]) in lin,
                     lambda o: o.get("pane_id") == q["pane_id"],
                     lambda o: bool(q.get("pane_label")) and o.get("pane_label") == q.get("pane_label")):
            j = next((k for k in free if test(old[k])), None)
            if j is not None:
                break
        if j is None and same_layout and i in free and not (q["session_id"] and old[i].get("session_id")):
            j = i
        o = old[j] if j is not None else {}
        if j is not None:
            used.add(j)
        # never downgrade a verified id to an unverified herdr hint, or to nothing while Hermes starts
        if o.get("session_id") and (q["session_id"] is None or (q["sid_source"] == "herdr-unverified" and verified(o))):
            q = dict(q, session_id=o["session_id"], sid_source=(o.get("sid_source") or "").replace("(kept)", "") + "(kept)")
        out.append(q)
    return out, used


def ours(tab, r, srv):
    """True only if `tab` is still exactly the bare tab this ledger created (same server, same panes)."""
    if not r.get("made") or r.get("server") != srv or server_start() != srv:
        return False
    have = [p for p in herdr("pane", "list")["panes"] if p.get("tab_id") == tab]
    if not have or not {p["pane_id"] for p in have} <= set(r.get("panes") or []):
        return False
    # unknown foreground counts as busy: never close it
    return all(all(is_shell(a) for a in (foreground(p["pane_id"]) or [["?"]])) for p in have)


def pending(e, live, srv, restarted):
    """A restore that Hermes has not confirmed yet. Returns the tab id while it is still pending."""
    r = e.get("restore") or {}
    reason = "server-restart" if restarted else (r.get("reason") or e.get("lost_reason") or "closed")
    t = live.get(e.get("live_tab_id"))
    if t and not restarted and now - r.get("at", now) <= RESTORE_WAIT:
        e["last_seen"] = now
        return t["tab_id"]
    if t and not restarted:                    # Hermes never showed up: undo only what we provably made
        closed = False
        try:
            if ours(t["tab_id"], r, srv):
                closed = herdr("tab", "close", t["tab_id"], check=False, timeout=20) is not None
        except (RuntimeError, Ambiguous):
            pass
        e.pop("restore", None)
        e.update(state="lost", lost_at=now, lost_reason=reason, lost_server=srv)
        return t["tab_id"] if closed else None    # a closed tab is not a new tab to record
    e.pop("restore", None)
    e.update(state="lost", lost_at=now, lost_reason=reason, lost_server=srv)
    return None


def update(auto=False):
    c = db()
    led = load()
    srv = server_start()
    if srv is None:
        return led       # no server found: say nothing about tabs until one is (a pgrep miss is not a restart)
    live = live_tabs(c)
    restarted = led.get("server_start") not in (None, srv)
    if restarted or not led.get("server_seen_at"):
        led["server_seen_at"] = now
    # Lineage index of live Hermes panes, to match entries across compression/restarts.
    live_lineage = {}
    for t in live.values():
        for q in t["panes"]:
            if q["session_id"]:
                for s in lineage(c, leaf(c, q["session_id"])):
                    live_lineage.setdefault(s, t["tab_id"])
    matched_tabs = set()
    for e in list(led["entries"]):
        if e["state"] == "forgotten":
            continue
        tid = None
        for q in e["panes"]:
            if q.get("session_id"):
                tid = live_lineage.get(leaf(c, q["session_id"])) or live_lineage.get(q["session_id"])
                if tid:
                    break
        if not tid and not any(q.get("session_id") for q in e["panes"]):
            # shell-only tab: same tab id + same name (herdr restores ids and names on restart)
            cand = live.get(e.get("live_tab_id"))
            if cand and cand["tab_label"] == e["tab_label"] and not any(q["session_id"] for q in cand["panes"]):
                tid = e["live_tab_id"]
        if tid and tid not in matched_tabs:
            t = live[tid]; matched_tabs.add(tid)
            panes, used = match_panes(c, e["panes"], t["panes"])
            # recorded Hermes panes this tab no longer has (a closed split, a pane not restored): keep them
            gone = [q for j, q in enumerate(e["panes"]) if j not in used and q.get("session_id")
                    and leaf(c, q["session_id"]) not in live_lineage]
            if gone:
                split_off(led, e, gone, (e.get("restore") or {}).get("reason") or "closed")
            if restarted and e.get("status") == "done":
                e["unseen_carry"] = True           # herdr forgets "done" on restart; we do not
            e.pop("restore", None)
            e.update(live_tab_id=tid, workspace_label=t["workspace_label"], tab_label=t["tab_label"],
                     panes=panes, state="live", last_seen=now, lost_at=None, lost_reason=None,
                     lost_server=None, status=t["status"])
            carry_mark(e, t)
        elif e["state"] == "restoring":
            keep = pending(e, live, srv, restarted)
            if keep:
                matched_tabs.add(keep)
        elif e["state"] == "live":
            sids = {leaf(c, q["session_id"]) for q in e["panes"] if q.get("session_id")}
            shell_left = e.get("live_tab_id") in live and not any(
                q.get("agent") for q in live[e["live_tab_id"]]["panes"])
            reason = "server-restart" if restarted else (
                "memguard" if sids & {leaf(c, s) for s in memguard_ended_sids(e.get("last_seen", now) - 600)}
                else "hermes-exited" if shell_left else "closed")
            if reason == "server-restart" and e.get("status") == "done":
                e["unseen_carry"] = True           # applied once the tab is restored
            e.update(state="lost", lost_at=now, lost_reason=reason, lost_server=srv)
    # A tab whose Hermes exited (memguard, crash) is still that entry's tab while it
    # sits at a bare shell: it must not also be recorded as a new, separate tab.
    for e in led["entries"]:
        t = live.get(e.get("live_tab_id"))
        if (e["state"] == "lost" and e.get("lost_reason") in ("hermes-exited", "memguard") and t
                and not any(q.get("agent") for q in t["panes"])):
            matched_tabs.add(t["tab_id"])
    for tid, t in live.items():
        if tid not in matched_tabs:
            led["entries"].append(new_entry(t))
    led["server_start"] = srv
    led["updated_at"] = now
    prune(led)
    save(led)
    if auto:
        # Grace: after a restart herdr restores tabs and hmw resumes Hermes in them; only
        # entries still unmatched 5 minutes later are genuinely gone.
        up = now - (srv if isinstance(srv, float) else led["server_seen_at"])
        todo = [e for e in led["entries"] if e["state"] == "lost" and e["lost_reason"] == "server-restart"
                and e.get("lost_server") == srv and up > GRACE and now - (e.get("lost_at") or now) > GRACE]
        if todo:
            restore_entries(led, todo, c, auto=True)
    return led


def carry_mark(e, t):
    """Show MARK on a tab whose finished work was unseen before a restart, until it is seen."""
    if not e.get("unseen_carry") or not e.get("tab_label"):
        return
    seen = t["focused"] or t["status"] in ("working", "blocked", "done")   # done: herdr's own dot is back
    want = e["tab_label"] if seen else MARK + e["tab_label"]
    ok = t.get("shown_label") == want
    if not ok:
        try:
            ok = herdr("tab", "rename", t["tab_id"], want, check=False, timeout=20) is not None
        except Ambiguous:
            ok = False
    if seen and ok:
        e["unseen_carry"] = False                  # only once the marker is really gone


def seed_from_snapshot(path):
    """Import tabs from an hmw snapshot (with tabs[]) that are not live now, as lost/closed."""
    c = db(); led = load(); d = json.load(open(path))
    known = {leaf(c, q["session_id"]) for e in led["entries"] for q in e["panes"] if q.get("session_id")}
    added = 0
    for t in d.get("tabs") or []:
        panes = []
        for q in t.get("panes") or []:
            sid = q.get("session_hint")
            panes.append({"pane_id": q.get("pane_id"), "pane_label": q.get("pane_label"), "cwd": t.get("cwd"),
                          "agent": q.get("agent"), "session_id": sid, "sid_source": "snapshot-hint" if sid else None,
                          "title": None})
        sids = {leaf(c, q["session_id"]) for q in panes if q.get("session_id")}
        if not sids or sids & known:
            continue
        led["entries"].append({"id": f"seed-{int(d.get('saved_at', 0))}-{t['tab_id']}", "first_seen": d.get("saved_at"),
                               "last_seen": d.get("saved_at"), "state": "lost", "live_tab_id": None,
                               "workspace_label": t.get("workspace_label"), "tab_label": t.get("tab_label"),
                               "panes": panes, "lost_at": d.get("saved_at"), "lost_reason": "closed (seeded)"})
        known |= sids; added += 1
    save(led)
    print(f"seeded {added} tab(s) from {os.path.basename(path)}")


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except PermissionError:
        return True
    except (OSError, OverflowError):
        return False


def process_argvs(ps_args):
    """Exact argv of every process (Linux /proc); elsewhere ps lines, where a Hermes launcher
    (whose multi-line -c code ps cannot show intact) is reduced to `hermes ...` so it still counts."""
    out = []
    if os.path.isdir(f"{PROC}/self"):
        for d in os.listdir(PROC):
            if d.isdigit():
                try:
                    raw = open(f"{PROC}/{d}/cmdline", "rb").read()
                except OSError:
                    continue
                if raw:
                    out.append([x.decode("utf-8", "replace") for x in raw.rstrip(b"\0").split(b"\0")])
        return out
    for line in ps_args.splitlines():
        a = line.split()
        if not a:
            continue
        if "hermes_bootstrap" in line or "hermes_cli.main" in line:
            tail = line.split("hermes_cli.main", 1)[-1].split()
            a = ["hermes"] + [x for x in tail if not x.startswith(("main", "import", "("))]
        out.append(a)
    return out


def running_sessions(c, recent=True):
    """Every conversation that may be open anywhere; None when that cannot be known (fail closed).

    recent=True (automatic restore) also counts any session active in the last RECENT seconds, which
    covers a Hermes outside herdr that holds no lease. A hand-run restore skips that rule, so a tab you
    just closed by mistake can come straight back."""
    run = set()
    registry = True
    try:
        entries = json.load(open(LEASES)).get("entries") or []
        if not isinstance(entries, list):
            return None
    except FileNotFoundError:
        entries, registry = [], False
    except (OSError, ValueError, AttributeError):
        return None
    for l in entries:     # a live pid counts even if recycled: a skipped restore is safe, a double resume is not
        if isinstance(l, dict) and isinstance(l.get("session_id"), str) and type(l.get("pid")) is int \
                and pid_alive(l["pid"]):
            run.add(l["session_id"])
    try:
        args = subprocess.run(["ps", "-axo", "args="], capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    run.update(re.findall(r"--resume[ =](\d{8}_\d{6}_[0-9a-f]{6})", args))
    if not registry:
        # Without Hermes' lease registry, a Hermes started without --resume (or switched inside
        # the TUI) is invisible: if any such process exists, nobody can say what it holds.
        for a in process_argvs(args):
            if interactive_chat(hermes_args(a)) and not re.search(r"--resume[ =]\d{8}_", " ".join(a)):
                return None
    if recent:
        run.update(i for (i,) in c.execute("select id from sessions where last_activity_at > ?", (now - RECENT,)))
    try:
        for p in herdr("pane", "list")["panes"]:
            v = (p.get("agent_session") or {}).get("value")
            # herdr keeps agent_session after Hermes exits; count it unless the foreground proves Hermes gone
            here = hermes_in(foreground(p["pane_id"])) if p.get("agent") == "hermes" or v else False
            if isinstance(v, str) and here is not False:
                run.add(v)
            elif here and not registry:
                return None                        # a live Hermes we cannot map, and no registry to ask
    except (RuntimeError, Ambiguous, ValueError, KeyError):
        return None
    out = set()
    for s in run:
        out |= lineage(c, leaf(c, s)) | {s}
    return out


class RestoreLock:
    """hmw's own restore lock (a directory), so ledger and hmw never restore at once."""

    def __init__(self, wait):
        self.held = False
        os.makedirs(LOG_DIR, exist_ok=True)
        owner = os.path.join(RESTORE_LOCK, "hmw-ledger.pid")
        deadline = time.time() + wait
        while True:
            try:
                os.mkdir(RESTORE_LOCK)
                with open(owner, "w") as fh:
                    fh.write(str(os.getpid()))
                self.held = True
                return
            except FileExistsError:
                try:   # our own leftover from a killed run: clear it; hmw's lock has no owner file
                    pid = int(open(owner).read().strip())
                    if not pid_alive(pid):
                        os.unlink(owner); os.rmdir(RESTORE_LOCK); continue
                except (OSError, ValueError):
                    pass
            if time.time() >= deadline:
                return
            time.sleep(1)

    def release(self):
        if self.held:
            for f in (lambda: os.unlink(os.path.join(RESTORE_LOCK, "hmw-ledger.pid")), lambda: os.rmdir(RESTORE_LOCK)):
                try:
                    f()
                except OSError:
                    pass
            self.held = False


def reusable_tab(e, srv):
    """The entry's old tab, only if it is provably the same tab and still a bare shell (memguard / exit)."""
    if e.get("lost_reason") not in ("hermes-exited", "memguard") or e.get("lost_server") != srv:
        return None
    tid = e.get("live_tab_id")
    have = [p for p in herdr("pane", "list")["panes"] if p.get("tab_id") == tid] if tid else []
    if not have or sorted(p["pane_id"] for p in have) != sorted(q.get("pane_id") for q in e["panes"]):
        return None
    for p in have:
        fg = foreground(p["pane_id"])
        if not fg or not all(is_shell(a) for a in fg):
            return None
    return tid


def restore_entries(led, entries, c, auto=False):
    lock = RestoreLock(wait=0 if auto else 60)
    if not lock.held:
        if not auto:                               # the loop just tries again next tick
            print("hmw is restoring this session right now; try again shortly")
        return
    try:
        running = running_sessions(c, recent=auto)
        if running is None:
            print("cannot tell which conversations are already open (lease registry or herdr unreadable); not restoring")
            return
        srv = server_start()
        wss = herdr("workspace", "list")["workspaces"]
        for e in entries:
            try:
                restore_one(led, e, c, running, srv, wss, auto)
            except (RuntimeError, Ambiguous, KeyError, TypeError, ValueError) as err:
                print(f"FAILED to restore {e.get('tab_label') or '(unnamed)'}: {err}")
            save(led)                              # progress survives a later timeout or kill
    finally:
        save(led)                                  # also on SIGALRM/SIGTERM (main() turns them into SystemExit)
        lock.release()


def quiet(*args):
    """Best-effort cosmetic herdr call (renames): a failure or timeout never aborts a restore."""
    try:
        herdr(*args, check=False, timeout=20)
    except Ambiguous:
        pass


def restore_one(led, e, c, running, srv, wss, auto):
    ws = next((w for w in wss if w.get("label") == e.get("workspace_label")), None) or (wss[0] if wss else None)
    if not ws:
        print("no live workspace to restore into"); return
    name = e.get("tab_label") or "(unnamed)"
    orig = e.get("lost_reason")
    plan, held = [], []                            # panes to launch; Hermes panes kept for later
    for q in e["panes"]:
        sid = leaf(c, q["session_id"]) if q.get("session_id") else None
        if not sid:
            continue
        if sid in running:
            print(f"skip {name}: {sid} already running"); held.append(q); continue
        if auto and not verified(q):
            print(f"skip {name}: {sid} is an unverified id; restore it by hand if it is right"); held.append(q); continue
        plan.append((q, sid))
        running.add(sid)                           # reserve now: never planned twice, in this tab or another
    hermes_tab = any(q.get("session_id") for q in e["panes"])
    if hermes_tab and not plan:
        return                                     # nothing safe to launch; the entry stays lost
    tab = reusable_tab(e, srv)
    made = tab is None
    first = plan[0][0] if plan else (e["panes"][0] if e["panes"] else {})
    if made:
        created = herdr("tab", "create", "--workspace", ws["workspace_id"], "--cwd", first.get("cwd") or HOME,
                        "--env", "NO_TMUX=1", "--no-focus")
        tab = created["tab"]["tab_id"]
        targets = [(created.get("root_pane") or {}).get("pane_id") or created["tab"].get("focused_pane_id")]
    else:
        targets = [q.get("pane_id") for q, _ in plan]
    r = {"at": now, "reason": orig, "server": srv, "made": made, "panes": [x for x in targets if x]}
    e.update(state="restoring", live_tab_id=tab, restore=r)
    save(led)                                      # checkpoint before anything is launched
    if not hermes_tab:                             # a plain shell tab: nothing to confirm
        if e.get("tab_label"):
            quiet("tab", "rename", tab, e["tab_label"])
        if first.get("pane_label") and targets[0]:
            quiet("pane", "rename", targets[0], first["pane_label"])
        e.pop("restore", None)
        e.update(state="live", last_seen=now, lost_at=None, lost_reason=None, lost_server=None)
        print(f"restored {name} -> {tab} (shell)")
        return
    launched, failed, ambiguous = [], [], False
    for k, (q, sid) in enumerate(plan):
        if made and k > 0:
            try:
                split = herdr("pane", "split", targets[-1], "--direction", "right", "--no-focus", "--env", "NO_TMUX=1")
                targets.append((split.get("pane") or split.get("root_pane") or {}).get("pane_id"))
                r["panes"] = [x for x in targets if x]
                save(led)
            except (RuntimeError, Ambiguous) as err:
                print(f"FAILED to add a pane for {sid}: {err}"); failed.append(q); continue
        pane = targets[k] if k < len(targets) else None
        if not pane:
            failed.append(q); continue
        src = ["--source", f"pane:{q['pane_label']}"] if re.match(r"^H\d+$", q.get("pane_label") or "") else []
        agent = re.sub(r"[^a-z0-9_-]", "-", f"hmw-{pane}".lower())[:32]   # herdr: lowercase, 1-32 chars
        try:
            herdr("agent", "start", agent, "--kind", "hermes", "--pane", pane, "--timeout", str(AGENT_START_MS),
                  "--", "chat", *src, "--resume", sid, timeout=AGENT_START_MS / 1000 * 1.5 + 5)
        except Ambiguous as err:
            print(f"UNSURE whether {sid} started in {pane}: {err}; the next check decides")
            ambiguous = True; launched.append(q); continue
        except RuntimeError as err:
            print(f"FAILED to resume {sid} in {pane}: {err}"); failed.append(q); continue
        launched.append(q)
        if q.get("pane_label"):
            quiet("pane", "rename", pane, q["pane_label"])
    if not launched:
        try:
            if ours(tab, r, srv):                  # never close a tab we did not create, or one that changed
                herdr("tab", "close", tab, check=False, timeout=20)
        except (RuntimeError, Ambiguous):
            pass
        e.pop("restore", None)
        e.update(state="lost", lost_reason=orig); return
    if made and e.get("tab_label"):
        quiet("tab", "rename", tab, e["tab_label"])
    rest = failed + held
    if rest:
        split_off(led, e, rest, orig or "closed")
        e["panes"] = [q for q in e["panes"] if q not in rest]
    print(f"restored {name} -> {tab} (resumed {', '.join(leaf(c, q['session_id']) for q in launched)})"
          + (f"; {len(rest)} pane(s) kept as separate lost entries" if rest else "")
          + ("; start unconfirmed" if ambiguous else ""))


def status(led):
    c = db()
    for state in ("live", "lost"):
        rows = [e for e in led["entries"] if e["state"] in ((state, "restoring") if state == "live" else (state,))]
        print(f"\n{state.upper()} ({len(rows)})")
        for e in sorted(rows, key=lambda e: -(e.get("lost_at") or e.get("last_seen") or 0)):
            q = next((q for q in e["panes"] if q.get("session_id")), e["panes"][0] if e["panes"] else {})
            sid = q.get("session_id")
            what = f"{leaf(c, sid)} [{q.get('sid_source')}] {title_of(c, leaf(c, sid))[:42]}" if sid else "shell"
            when = (f"  lost {time.strftime('%m-%d %H:%M', time.gmtime(e['lost_at']))} ({e['lost_reason']})"
                    if state == "lost" else "")
            print(f"  {(e.get('tab_label') or '-'):16} {what}{when}")


def locked():
    """One ledger writer at a time (the snapshot loop and a hand-run command can overlap)."""
    os.makedirs(STATE, exist_ok=True)
    fh = open(os.path.join(STATE, f"{SESSION}.ledger.lock"), "a")
    deadline = time.time() + 120
    while True:
        try:
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fh
        except OSError:
            if time.time() > deadline:
                sys.exit("hmw-ledger: another ledger run holds the lock")
            time.sleep(0.5)


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if cmd not in ("update", "status", "seed", "restore", "forget"):
        print(__doc__); sys.exit(2)
    # hmw bounds each run with SIGALRM; exit through finally so locks are released and progress saved.
    for sig in (signal.SIGALRM, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda *_: sys.exit(124))
    _lock = locked()  # noqa: F841 (held until exit)
    if cmd == "update":
        update(auto="--auto" in argv)
    elif cmd == "status":
        status(update())
    elif cmd == "seed":
        seed_from_snapshot(argv[2])
    elif cmd in ("restore", "forget"):
        c = db(); led = update(); names = set(argv[2:])
        sel = [e for e in led["entries"] if e["state"] == "lost" and (not names or e.get("tab_label") in names)]
        if not sel:
            print("nothing lost matches"); return
        if cmd == "restore":
            restore_entries(led, sel, c); update()
        else:
            for e in sel:
                e["state"] = "forgotten"
            save(led); print(f"forgot {len(sel)} tab(s)")


if __name__ == "__main__":
    main(sys.argv)

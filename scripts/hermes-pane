#!/usr/bin/env bash
# scripts/hermes-pane — restart-proof Hermes launcher for a named workspace pane.
#
# Symlinked to ~/.local/bin/hermes-pane by lib/99-register-host.sh.
# Used by the Ghostty workspace launcher (scripts/ghostty-workspace.applescript)
# as each pane's initial command, e.g. `hermes-pane code`.
#
# THE PROBLEM IT SOLVES
#   The workspace launcher historically ran bare `hermes` in each pane. That
#   gives continuity only via tmux *persistence* (the session never died), NOT
#   via session resume. So a `hermes update` — which requires exiting hermes to
#   pick up the new binary — ends the tmux session and the next `hmw` starts a
#   brand-new EMPTY session. Your transcript is still in ~/.hermes/state.db, but
#   you'd have to hand-resume every pane with `hermes -r <id>`.
#
# WHY NOT JUST `hermes --continue`
#   Two verified failure modes on a busy shared box (h-do1 runs the gateway +
#   several concurrent CLI sessions + nightly cron sessions):
#     1. Bare `hermes -c` resumes the GLOBAL most-recent session. With multiple
#        panes (code, scratch) both doing `-c`, they race for the same session.
#     2. `hermes -c <name>` resolves by TITLE, but a fresh session has no title
#        until its first message — and there is no launch flag to pre-title one.
#        So `-c code` exits 1 on first-ever launch and the pane falls to a bare
#        shell with no hermes at all.
#
# THE FIX
#   Stamp each pane with its own source tag (`--source pane:<label>`). The
#   session store records the tag per session, so we can resolve THIS pane's
#   own most-recent session unambiguously — no global race, and it simply
#   resolves to "nothing yet" on first launch (→ fresh session, no error).
#   `hermes update` never touches state.db, so resume-by-id is lossless.
#
# USAGE
#   hermes-pane <label> [initial-cmd-if-fresh ...]
#     <label>            pane name / source suffix (code, scratch, ...)
#     initial-cmd        IGNORED for resume; reserved for future use. The
#                        wrapper always launches an interactive hermes.
#
# BEHAVIOR
#   - Resolves the most-recent session id for source `pane:<label>`.
#   - If found  → hermes chat --source pane:<label> --resume <id>
#   - If none   → hermes chat --source pane:<label>   (fresh, tagged)
#   - When hermes exits, drops to an interactive shell (`exec $SHELL`) so the
#     tmux session/pane survives instead of closing. Reopen the workspace
#     (after `hermes update`, kill the code/scratch tmux sessions first so the
#     wrapper re-runs) and each pane auto-resumes its own last session.

set -uo pipefail

PRINT_RESUME_ID=0
if [[ "${1:-}" == "--print-resume-id" ]]; then
  # hmw's reboot restore: print the session the label lookup WOULD resume (or
  # nothing), so it can deduplicate and pin it before launching. Exits
  # nonzero whenever the lookup itself fails.
  PRINT_RESUME_ID=1
  shift
fi
LABEL="${1:-scratch}"
SOURCE_TAG="pane:${LABEL}"

# Locate hermes on PATH (portable across hosts — no hardcoded venv path).
HERMES_BIN="$(command -v hermes || true)"
if [[ -z "$HERMES_BIN" && "$PRINT_RESUME_ID" == 1 ]]; then
  exit 1
fi
if [[ -z "$HERMES_BIN" ]]; then
  echo "hermes-pane: 'hermes' not found on PATH" >&2
  exec "${SHELL:-/bin/bash}"
fi

# Find the hermes interpreter + project root so we can import the session store.
#
# Hermes 0.21+ installs a MANAGED launcher: `hermes` on PATH is a one-line shim
# (`exec <root>/.hermes/bin/hermes "$@"`) whose target execs a bundled store
# Python with `-I -c <bootstrap>`. That Python has no site-packages of its own;
# the bootstrap (`import hermes_bootstrap`) wires them up. Such launchers answer
# `--print-runtime-command` with a JSON argv: [<python>, "-I", "-c", "...
# sys.path.insert(0, '<root>') ..."]. Ask the launcher instead of parsing it.
# Only ask a launcher that names the flag: an older `hermes` would treat it as
# an ordinary CLI argument and could start a chat.
#
# Older installs: the shim execs a venv binary (e.g. /usr/local/bin/hermes ->
# .../hermes-agent/venv/bin/hermes). Parse the shim to locate the venv, then
# derive the project root (where hermes_state.py lives).
HERMES_MANAGED=0
launcher_supports_runtime_command() {
  local shim="$1" target
  grep -q -- '--print-runtime-command' "$shim" 2>/dev/null && return 0
  target="$(sed -nE 's/^exec "?([^" ]+)"? .*/\1/p' "$shim" 2>/dev/null | head -1)"
  [[ -n "$target" && -f "$target" ]] && grep -q -- '--print-runtime-command' "$target" 2>/dev/null
}

resolve_hermes_internals() {
  local shim real venv_hermes runtime py root
  shim="$HERMES_BIN"
  HERMES_VENV_PY=""
  HERMES_PROOT=""
  HERMES_MANAGED=0
  if launcher_supports_runtime_command "$shim"; then
    runtime="$("$HERMES_BIN" --print-runtime-command </dev/null 2>/dev/null)"
    py="$(printf '%s' "$runtime" | sed -nE 's/^\["([^"]+)".*/\1/p')"
    root="$(printf '%s' "$runtime" | sed -nE "s/.*sys\.path\.insert\(0, '([^']+)'\).*/\1/p")"
    if [[ -x "$py" && -f "$root/hermes_state.py" ]]; then
      HERMES_VENV_PY="$py"
      HERMES_PROOT="$root"
      HERMES_MANAGED=1
      return 0
    fi
  fi
  # Follow a one-line `exec "<path>/venv/bin/hermes"` shim if present.
  venv_hermes="$(grep -oE '"[^"]*venv/bin/hermes"' "$shim" 2>/dev/null | head -1 | tr -d '"')"
  if [[ -z "$venv_hermes" ]]; then
    # Not a shim (or unexpected form) — assume the bin itself lives in the venv.
    real="$(readlink -f "$shim" 2>/dev/null || echo "$shim")"
    venv_hermes="$real"
  fi
  HERMES_VENV_PY="$(dirname "$venv_hermes")/python3"
  # project root = three levels up from venv/bin/hermes  (… /<root>/venv/bin/hermes)
  HERMES_PROOT="$(dirname "$(dirname "$(dirname "$venv_hermes")")")"
}

# Resolve this pane's most-recent session id via the session store. We query
# the DB directly (SessionDB.search_sessions is ordered most-recent-first);
# the `sessions list` TABLE is NOT reliably recency-ordered, so don't parse it.
# Exit status: 0 = the lookup ran (id printed, or nothing for a new label);
# nonzero = the lookup could not run. Callers must not read a failed lookup as
# "no prior session".
resolve_last_session() {
  [[ -x "${HERMES_VENV_PY:-}" && -f "${HERMES_PROOT:-}/hermes_state.py" ]] || return 2
  if [[ "$HERMES_MANAGED" == 1 ]]; then
    # Managed store Python: isolated mode, then the same bootstrap the launcher
    # runs so Hermes' dependencies are importable.
    "$HERMES_VENV_PY" -I - "$SOURCE_TAG" "$HERMES_PROOT" <<'PY' 2>/dev/null
import os, sys
src, root = sys.argv[1], sys.argv[2]
try:
    sys.path.insert(0, root)
    if not os.environ.get("HERMES_HOME"):
        from hermes_constants import get_default_hermes_root
        os.environ["HERMES_HOME"] = str(get_default_hermes_root())
    import hermes_bootstrap  # noqa: F401  (wires up Hermes' site-packages)
    from hermes_state import SessionDB
except Exception:
    sys.exit(3)
try:
    db = SessionDB()
    rows = db.search_sessions(source=src, limit=1)
    if rows:
        print(rows[0]["id"])
    try:
        db.close()
    except Exception:
        pass
except Exception:
    sys.exit(3)
PY
    return
  fi
  ( cd "$HERMES_PROOT" && "$HERMES_VENV_PY" - "$SOURCE_TAG" <<'PY' 2>/dev/null
import sys
# Exit 3 on ANY lookup error: --print-resume-id must tell "found nothing"
# (exit 0, empty) apart from "could not look" (nonzero).
try:
    from hermes_state import SessionDB
except Exception:
    sys.exit(3)
src = sys.argv[1]
try:
    db = SessionDB()
    rows = db.search_sessions(source=src, limit=1)
    if rows:
        print(rows[0]["id"])
    try:
        db.close()
    except Exception:
        pass
except Exception:
    sys.exit(3)
PY
  )
}

if [[ "$PRINT_RESUME_ID" == 1 ]]; then
  resolve_hermes_internals
  [[ -x "${HERMES_VENV_PY:-}" && -f "${HERMES_PROOT:-}/hermes_state.py" ]] || exit 1
  # Fail closed: a lookup error exits nonzero; exit 0 + empty only when the
  # lookup succeeded and this label has no prior session.
  resolve_last_session || exit 1
  exit 0
fi

# hmw's reboot restore passes the exact session this pane held (from Hermes'
# active-session leases), which beats the label lookup: `--resume` does not
# retag a session's source, so pane:<label> can name a stale conversation.
# HMW_RESUME_ID=none: that session is resumed in another pane; start fresh.
RESUME_ID="${HMW_RESUME_ID:-}"
unset HMW_RESUME_ID
case "$RESUME_ID" in
  *[!A-Za-z0-9_.:-]*) RESUME_ID="" ;;
esac
if [[ "$RESUME_ID" == "none" ]]; then
  LAST_ID=""
elif [[ -n "$RESUME_ID" ]]; then
  LAST_ID="$RESUME_ID"
else
  resolve_hermes_internals
  LAST_ID="$(resolve_last_session)"
  LOOKUP_RC=$?
  if [[ "$LOOKUP_RC" != 0 ]]; then
    LAST_ID=""
    echo "hermes-pane[$LABEL]: WARNING could not look up this pane's previous session (lookup exit $LOOKUP_RC)." >&2
    echo "  Starting fresh. Your earlier conversation is still in the session store; resume it with" >&2
    echo "  HMW_RESUME_ID=<session id> hermes-pane $LABEL" >&2
  fi
fi

if [[ -n "${LAST_ID:-}" ]]; then
  echo "hermes-pane[$LABEL]: resuming session $LAST_ID"
  "$HERMES_BIN" chat --source "$SOURCE_TAG" --resume "$LAST_ID"
elif [[ "${LOOKUP_RC:-0}" != 0 ]]; then
  "$HERMES_BIN" chat --source "$SOURCE_TAG"
else
  echo "hermes-pane[$LABEL]: no prior session for source '$SOURCE_TAG' — starting fresh"
  "$HERMES_BIN" chat --source "$SOURCE_TAG"
fi

# Hermes has exited. Keep the pane alive so the tmux session survives a
# `hermes update` restart; reopening the workspace re-runs this wrapper.
echo
echo "hermes-pane[$LABEL]: hermes exited. Dropping to a shell (tmux session preserved)."
echo "  Re-launch this pane's hermes with:  hermes-pane $LABEL"
exec "${SHELL:-/bin/bash}"
